  document.getElementById('pe-emoji').value=PROFILE.emoji||'💪';
  document.getElementById('pe-name').value=PROFILE.name||'';
  document.getElementById('pe-age').value=PROFILE.age||'';
  document.getElementById('pe-height').value=PROFILE.height||'';
  document.getElementById('pe-weight').value=PROFILE.weight||'';
  document.getElementById('pe-goal').value=PROFILE.goal||'Hypertrophy';
  document.getElementById('pe-target').value=PROFILE.target||'';
  document.getElementById('profile-edit-modal').classList.add('open');
}

function closeProfileEdit(){document.getElementById('profile-edit-modal').classList.remove('open');}

function saveProfileEdit() {
  const name=document.getElementById('pe-name').value.trim();
  const age=+document.getElementById('pe-age').value;
  const height=+document.getElementById('pe-height').value;
  const weight=+document.getElementById('pe-weight').value;
  const target=document.getElementById('pe-target').value;
  if(age&&(age<10||age>100)){alert('Age must be between 10 and 100.');return;}
  if(height&&(height<100||height>250)){alert('Height must be between 100 and 250 cm.');return;}
  if(weight&&(weight<20||weight>300)){alert('Weight must be between 20 and 300 kg.');return;}
  if(target&&target<todayStr()&&target!==PROFILE.target){/* allow keeping past target */}
  const emoji=document.getElementById('pe-emoji').value.trim();
  if(emoji)PROFILE.emoji=emoji;
  if(name)PROFILE.name=name;
  if(age)PROFILE.age=age; else delete PROFILE.age;
  if(height)PROFILE.height=height; else delete PROFILE.height;
  if(weight)PROFILE.weight=weight; else delete PROFILE.weight;
  PROFILE.goal=document.getElementById('pe-goal').value||PROFILE.goal;
  if(target)PROFILE.target=target; else delete PROFILE.target;
  saveProfileData();
  closeProfileEdit();
  renderProfile();
}

