<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,viewport-fit=cover">
<title>8Day Tracker</title>
<link rel="manifest" href="manifest.json">
<meta name="theme-color" content="#0a0a0a">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black">
<meta name="apple-mobile-web-app-title" content="8Day">
<link rel="apple-touch-icon" href="icon-180.png">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.7.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.7.0/firebase-firestore-compat.js"></script>
<style>
@import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap');
:root{
  /* Athletic/sharp palette — true black bias, sharp contrast */
  --bg:#0a0a0a;--bg2:#141414;--bg3:#1c1c1c;--bg4:#252525;
  --border:#2a2a2a;--border2:#3a3a3a;
  --text:#fafafa;--text2:#a3a3a3;--text3:#666666;--text4:#404040;
  --green:#4ade80;--blue:#60a5fa;--orange:#fb923c;--red:#f87171;--purple:#a78bfa;--amber:#fbbf24;
  /* Day-type tints */
  --push:#60a5fa;--legs:#fb923c;--pull:#4ade80;--rest:#404040;
  /* Signal accent — electric lime */
  --accent:#d4ff3a;--accent-ink:#0a0a0a;
  /* Type stacks */
  --fd:'Bebas Neue',-apple-system,sans-serif;
  --fb:'Inter',-apple-system,system-ui,sans-serif;
  --fm:'JetBrains Mono','DM Mono',ui-monospace,monospace;
  --nav-h:64px;--sb:env(safe-area-inset-bottom);
}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{height:100%;overflow:hidden}
body{font-family:var(--fb);background:var(--bg);color:var(--text);font-size:14px;-webkit-font-smoothing:antialiased}
.tnum{font-family:var(--fm);font-feature-settings:"tnum"}
.eyebrow{font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--text3)}
.disp{font-family:var(--fd);letter-spacing:-.02em;font-weight:400}

/* VIEWS */
.view{position:fixed;inset:0;bottom:calc(var(--nav-h) + var(--sb));overflow-y:auto;-webkit-overflow-scrolling:touch;display:none}
.view.active{display:block}
.vi{padding:16px 16px 32px;max-width:500px;margin:0 auto}

/* NAV — 4-tab equal-width + persistent FAB */
.nav{position:fixed;bottom:0;left:0;right:0;height:calc(var(--nav-h) + var(--sb));padding-bottom:var(--sb);background:var(--bg);border-top:1px solid var(--border);display:flex;z-index:100}
.nb{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;background:none;border:none;color:var(--text3);cursor:pointer;font-family:var(--fb);font-size:9px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:0;transition:color .15s;position:relative}
.nb svg{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.nb.active{color:var(--text)}
.nb.active svg{stroke-width:2.2}
.nb.active::after{content:"";position:absolute;top:8px;width:16px;height:2px;background:var(--accent);border-radius:1px}

/* FAB — persistent lime barbell start button */
.fab{position:fixed;bottom:calc(var(--nav-h) + var(--sb) + 16px);right:18px;z-index:120;width:60px;height:60px;border-radius:50%;background:var(--accent);color:var(--accent-ink);border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 8px 24px rgba(212,255,58,.28),0 0 0 1px rgba(212,255,58,.4);transition:transform .15s,box-shadow .15s}
.fab:active{transform:scale(.94)}
.fab:disabled{opacity:.4;cursor:default}
/* Center nav start button */
.nb.go .gc{width:56px;height:56px;background:var(--accent);border-radius:50%;display:flex;align-items:center;justify-content:center;margin-bottom:2px;margin-top:-20px;box-shadow:0 0 0 4px var(--bg),0 8px 24px rgba(212,255,58,.3);transition:transform .15s}
.nb.go:active .gc{transform:scale(.93)}
.nb.go svg{fill:var(--accent-ink);stroke:none;width:26px;height:26px}

/* HEADER */
.ph{padding:16px 16px 0;max-width:500px;margin:0 auto}
.pt{font-size:26px;font-weight:700;letter-spacing:-.5px}
.ps{font-size:13px;color:var(--text2);margin-top:3px}

/* CARD */
.card{background:var(--bg2);border-radius:16px;border:1px solid var(--border);overflow:hidden;margin-bottom:12px}
.ch{padding:13px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between}
.ct{font-size:11px;font-weight:700;color:var(--text3);text-transform:uppercase;letter-spacing:.07em}
.cb{padding:16px}

/* METRICS */
.mgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:14px}
.mgrid.four{grid-template-columns:repeat(4,1fr)}
/* TODAY STICKY STRIP */
.today-strip{position:sticky;top:0;z-index:50;background:var(--bg);border-bottom:1px solid var(--border);padding:12px 16px;margin-bottom:0!important}
.mc{background:var(--bg2);border-radius:12px;padding:14px 12px;border:1px solid var(--border);text-align:center}
.mv{font-size:22px;font-weight:700;font-family:'DM Mono',monospace}
.ml{font-size:10px;color:var(--text3);margin-top:3px;font-weight:500;text-transform:uppercase;letter-spacing:.05em}

/* TODAY BADGE */
.tbadge{display:inline-flex;align-items:center;gap:8px;padding:10px 14px;border-radius:12px;margin-bottom:16px;font-weight:600;font-size:14px}

/* PLAN CARD */
.plan-card{background:var(--bg2);border-radius:14px;border:1px solid var(--border);padding:16px;margin-bottom:12px}
.start-btn{width:100%;padding:16px;background:var(--accent);color:var(--accent-ink);font-family:inherit;font-size:16px;font-weight:700;border:none;border-radius:14px;cursor:pointer;margin-bottom:12px;transition:opacity .15s;letter-spacing:.01em}
.start-btn:hover{opacity:.9}

/* SESSION ITEM */
.si{background:var(--bg2);border-radius:14px;border:1px solid var(--border);padding:14px 16px;margin-bottom:10px;cursor:pointer}
.si:active{opacity:.75}
.si-top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:5px}
.si-lbl{font-size:15px;font-weight:700}
.si-date{font-size:12px;color:var(--text3)}
.si-type{font-size:13px;color:var(--text2);margin-bottom:7px}
.si-chips{display:flex;flex-wrap:wrap;gap:5px}
.chip{font-size:11px;background:var(--bg3);padding:3px 9px;border-radius:20px;color:var(--text2)}

/* WORKOUT OVERLAY */
.woverlay{position:fixed;inset:0;background:var(--bg);z-index:200;overflow-y:auto;-webkit-overflow-scrolling:touch;display:none}
.woverlay.open{display:block}
/* WORKOUT FLOATING PILL */
.wk-pill{position:fixed;bottom:calc(var(--nav-h) + var(--sb) + 14px);right:16px;z-index:150;background:var(--accent);color:var(--accent-ink);border-radius:50px;padding:9px 18px;font-family:'DM Mono',monospace;font-size:14px;font-weight:700;cursor:pointer;box-shadow:0 4px 20px rgba(0,0,0,.4);display:none;align-items:center;gap:8px;border:none}
.wk-pill.active{display:flex}
.wtop{position:sticky;top:0;background:var(--bg);border-bottom:1px solid var(--border);padding:12px 16px;display:flex;align-items:center;justify-content:space-between;z-index:10}
.wtitle{font-size:17px;font-weight:700}
.wtimer{font-family:'DM Mono',monospace;font-size:17px;color:var(--text);font-weight:500}
.wfinish{padding:8px 18px;background:var(--accent);color:var(--accent-ink);border:none;border-radius:10px;font-family:inherit;font-size:14px;font-weight:700;cursor:pointer}
.winner{padding:12px 16px 120px;max-width:500px;margin:0 auto}

/* EX BLOCK */
.exb{margin-bottom:8px}
.exbh{display:flex;align-items:center;justify-content:space-between;padding:13px 16px 10px;background:var(--bg2);border-radius:14px 14px 0 0;border:1px solid var(--border);border-bottom:none}
.exbn{font-size:16px;font-weight:700}
.exbs{font-size:11px;color:var(--text3);margin-top:2px}
.addset{font-size:12px;color:var(--text);font-weight:600;background:none;border:none;cursor:pointer;font-family:inherit;padding:4px}
.stbl{background:var(--bg2);border:1px solid var(--border);border-top:none;border-radius:0 0 14px 14px;overflow:hidden}
.sth{display:grid;grid-template-columns:30px 1fr 76px 76px 40px;padding:6px 12px;gap:6px;border-bottom:1px solid var(--border)}
.sth span{font-size:10px;color:var(--text3);font-weight:600;text-transform:uppercase;letter-spacing:.05em;text-align:center}
.sth span:nth-child(2){text-align:left}
.srow{display:grid;grid-template-columns:30px 1fr 76px 76px 40px;padding:8px 12px;gap:6px;align-items:center;border-bottom:1px solid var(--border);transition:background .15s}
.srow:last-child{border-bottom:none}
.srow.done{background:#22c55e0a}
.srow.warmup{opacity:.55}
.snum{width:26px;height:26px;border-radius:50%;background:var(--bg3);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:600;color:var(--text2);cursor:pointer;user-select:none}
.srow.done .snum{background:var(--green);color:#000}
.snum.wu{background:#f59e0b22;color:var(--amber);border:1px solid #f59e0b44;font-size:10px}
.prev{font-size:11px;color:var(--text3);font-family:'DM Mono',monospace}
.sinput{width:100%;padding:7px 8px;background:var(--bg3);border:1px solid var(--border);border-radius:8px;color:var(--text);font-family:'DM Mono',monospace;font-size:14px;font-weight:500;text-align:center;outline:none}
.sinput:focus{border-color:var(--blue);background:var(--bg4)}
.srow.done .sinput{border-color:#22c55e44;opacity:.7}
.cbtn{width:34px;height:34px;border-radius:50%;border:2px solid var(--border);background:none;cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--text3);transition:all .15s;flex-shrink:0}
.cbtn:hover{border-color:var(--text2);color:var(--text2)}
.cbtn.done{background:var(--green);border-color:var(--green);color:#000}
.cbtn.done:hover{border-color:var(--green);color:#000}
.cbtn svg{width:15px;height:15px;stroke:currentColor;fill:none;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round}
.addexbar{margin-top:10px;padding:14px 16px;background:var(--bg2);border-radius:14px;border:2px dashed var(--border);text-align:center;cursor:pointer;color:var(--text3);font-size:14px;font-weight:500}
.addexbar:active{opacity:.7}

/* SHEET */
.soverlay{position:fixed;inset:0;background:rgba(0,0,0,.75);z-index:300;display:none;align-items:flex-end}
.soverlay.open{display:flex}
.sheet{background:var(--bg2);border-radius:20px 20px 0 0;width:100%;max-height:82vh;overflow-y:auto;padding-bottom:calc(16px + var(--sb))}
.shandle{width:36px;height:4px;background:var(--bg4);border-radius:2px;margin:12px auto 16px}
.stitle{font-size:17px;font-weight:700;padding:0 16px 12px}
.ssearch{margin:0 16px 10px;padding:10px 14px;background:var(--bg3);border:1px solid var(--border);border-radius:10px;color:var(--text);font-family:inherit;font-size:14px;outline:none;width:calc(100% - 32px)}
.sglbl{font-size:11px;font-weight:700;color:var(--text3);text-transform:uppercase;letter-spacing:.08em;padding:10px 16px 4px}
.sitem{padding:13px 16px;display:flex;align-items:center;justify-content:space-between;cursor:pointer;border-bottom:1px solid var(--border)}
.sitem:active{background:var(--bg3)}
.sitem-name{font-size:14px;font-weight:500}
.sitem-sub{font-size:11px;color:var(--text3);margin-top:2px}
.schk{width:22px;height:22px;border-radius:50%;background:var(--green);display:flex;align-items:center;justify-content:center}
.schk svg{width:12px;height:12px;stroke:#000;fill:none;stroke-width:3;stroke-linecap:round;stroke-linejoin:round}

/* REST TOAST */
.rtoast{position:fixed;bottom:calc(var(--nav-h) + var(--sb) + 12px);left:50%;transform:translateX(-50%);background:var(--bg2);border:1px solid var(--border);border-radius:50px;padding:11px 18px;display:none;align-items:center;gap:12px;font-size:14px;font-weight:600;z-index:400;box-shadow:0 8px 32px rgba(0,0,0,.5)}
.rtoast.show{display:flex}
.rcnt{font-family:'DM Mono',monospace;font-size:20px;color:var(--green);min-width:36px;text-align:center}
.rskip{background:none;border:1px solid var(--border);border-radius:20px;padding:4px 12px;font-family:inherit;font-size:12px;color:var(--text2);cursor:pointer}

/* DETAIL SHEET */
.dsheet{position:fixed;inset:0;background:var(--bg);z-index:250;overflow-y:auto;display:none}
.dsheet.open{display:block}
.dtop{position:sticky;top:0;background:var(--bg);border-bottom:1px solid var(--border);padding:14px 16px;display:flex;align-items:center;gap:12px}
.back{background:none;border:none;color:var(--text2);cursor:pointer;font-size:14px;font-weight:600;font-family:inherit;display:flex;align-items:center;gap:5px;flex-shrink:0}
.back svg{width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.dex{margin-bottom:16px}
.dex-name{font-size:15px;font-weight:700;margin-bottom:8px}
.dsets{display:flex;flex-wrap:wrap;gap:6px}
.dset{background:var(--bg2);border:1px solid var(--border);border-radius:8px;padding:6px 12px;font-size:13px;font-family:'DM Mono',monospace}

/* ── CALENDAR ── */
.cal-topbar{display:flex;align-items:center;justify-content:space-between;padding:0 0 16px}
.cal-nav-btn{width:36px;height:36px;background:var(--bg2);border:1px solid var(--border);border-radius:10px;display:flex;align-items:center;justify-content:center;cursor:pointer}
.cal-nav-btn svg{width:18px;height:18px;stroke:var(--text2);fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.cal-month{font-size:18px;font-weight:700}
.dow-row{display:grid;grid-template-columns:repeat(7,1fr);gap:3px;margin-bottom:4px}
.dow{text-align:center;font-size:10px;font-weight:700;color:var(--text3);padding:4px 0;text-transform:uppercase;letter-spacing:.06em}
.cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:3px}
.cal-cell{border-radius:10px;padding:6px 4px;background:var(--bg2);border:1px solid var(--border);min-height:58px;cursor:pointer;position:relative;transition:opacity .15s}
.cal-cell:active{opacity:.7}
.cal-cell.other{opacity:.25;cursor:default}
.cal-cell.today{border-color:var(--blue);border-width:2px}
.cal-cell.rest-day{background:var(--bg);border-color:var(--border)}
.cal-cell.logged{border-width:2px}
.cal-dn{font-size:11px;font-weight:600;color:var(--text3);text-align:center;margin-bottom:3px}
.cal-cell.today .cal-dn{color:var(--blue)}
.cal-tag{font-size:8px;font-weight:700;text-align:center;padding:2px 3px;border-radius:4px;line-height:1.3;margin-top:2px}
.cal-tick{font-size:9px;color:var(--green);font-weight:700;text-align:center;margin-top:2px}
.cal-legend{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px}
.cal-leg{display:flex;align-items:center;gap:5px;font-size:11px;color:var(--text2)}
.cal-leg-dot{width:8px;height:8px;border-radius:3px;flex-shrink:0}
.cal-detail{background:var(--bg2);border-radius:14px;border:1px solid var(--border);padding:16px;margin-top:14px}

/* PROGRAMS MANAGER */
.prog-overlay{position:fixed;inset:0;background:var(--bg);z-index:280;overflow-y:auto;-webkit-overflow-scrolling:touch;display:none}
.prog-overlay.open{display:block}
.prog-top{position:sticky;top:0;background:var(--bg);border-bottom:1px solid var(--border);padding:12px 16px;display:flex;align-items:center;justify-content:space-between;z-index:10}
.prog-inner{padding:12px 16px 100px}
.prog-card{background:var(--bg2);border:1px solid var(--border);border-left:3px solid var(--border);border-radius:14px;padding:14px;margin-bottom:10px}
.prog-card.prog-active{border-color:var(--accent);border-left-color:var(--accent)}
.prog-card-name{font-size:15px;font-weight:700;letter-spacing:-.01em;margin-bottom:3px}
.prog-card-sub{font-size:11px;color:var(--text3);font-family:var(--fb)}
.prog-card-btns{display:flex;gap:6px;margin-top:12px}
.prog-card-btn{flex:1;padding:10px;font-family:var(--fb);font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;border:none;border-radius:10px;cursor:pointer;transition:opacity .12s}
.prog-card-btn:active{opacity:.7}
.prog-card-btn.primary{background:var(--text);color:var(--bg)}
.prog-card-btn.secondary{background:var(--bg3);color:var(--text2);border:1px solid var(--border)}
.prog-card-btn.danger{background:none;color:var(--text3);border:1px solid var(--border);flex:0 0 auto;padding:10px 14px}
/* Day slot in cycle builder */
.prog-day-slot{display:flex;align-items:center;gap:8px;padding:9px 0;border-bottom:1px solid var(--border)}
.prog-day-slot:last-child{border-bottom:none}
.prog-day-num{width:22px;height:22px;border-radius:6px;background:var(--bg3);display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:700;color:var(--text4);flex-shrink:0;font-family:var(--fb)}
.prog-day-sel{flex:1;background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:8px 10px;color:var(--text);font-family:inherit;font-size:13px;outline:none}
.prog-color-row{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px}
.prog-color-sw{width:30px;height:30px;border-radius:50%;cursor:pointer;border:2px solid transparent;transition:transform .1s;flex-shrink:0}
.prog-color-sw.sel{border-color:var(--text);transform:scale(1.15)}
/* Activate/switch sheet */
.prog-switch-btn{width:100%;padding:16px;border-radius:14px;cursor:pointer;text-align:left;border:1px solid var(--border);background:var(--bg3);margin-bottom:8px;transition:border-color .12s}
.prog-switch-btn:active{opacity:.7}
.prog-switch-btn.highlight{border-color:var(--accent);background:rgba(212,255,58,.06)}
/* ── PROGRAM EDITOR ── */
.cycle-day{background:var(--bg2);border-radius:14px;border:1px solid var(--border);margin-bottom:8px;overflow:hidden;border-left-width:3px}
.cycle-day-hdr{padding:13px 14px;display:flex;align-items:center;justify-content:space-between;cursor:pointer}
.cycle-day-hdr:active{background:var(--bg3)}
.cdh-left{display:flex;align-items:center;gap:10px}
.cd-pill{height:24px;padding:0 8px;border-radius:6px;display:inline-flex;align-items:center;justify-content:center;font-size:9px;font-weight:700;font-family:var(--fb);letter-spacing:.06em;text-transform:uppercase}
.cd-title{font-size:14px;font-weight:700;letter-spacing:-.01em}
.cd-sub{font-size:11px;color:var(--text3);margin-top:2px;font-family:var(--fb);letter-spacing:.02em}
.cd-body{border-top:1px solid var(--border);padding:10px 14px 14px;display:none}
.cd-body.open{display:block}
.cd-ex-row{display:flex;align-items:center;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--border)}
.cd-ex-row:last-of-type{border-bottom:none}
.cd-ex-name{font-size:13px;font-weight:500;color:var(--text2)}
.cd-ex-group{font-size:11px;color:var(--text3);margin-top:2px}
.rmex-btn{background:none;border:none;color:var(--text4);cursor:pointer;font-size:20px;padding:2px 8px;border-radius:6px;line-height:1;transition:color .12s}
.rmex-btn:active{color:var(--red)}
.add-ex-to-day{width:100%;margin-top:10px;padding:10px;background:transparent;border:1px dashed var(--border);border-radius:10px;color:var(--text3);font-family:var(--fb);font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;text-align:center;transition:border-color .12s,color .12s}
.add-ex-to-day:active{border-color:var(--accent);color:var(--accent)}
/* Program editor extensions */
.prog-day-btns{display:flex;align-items:center;gap:1px;flex-shrink:0}
.pdbn{background:none;border:none;cursor:pointer;color:var(--text4);padding:5px 6px;border-radius:7px;font-size:12px;line-height:1;font-family:inherit;transition:color .12s}
.pdbn:active{color:var(--text);background:var(--bg3)}
.ex-mv{background:none;border:none;cursor:pointer;color:var(--text3);padding:2px 5px;font-size:11px;border-radius:4px;line-height:1;transition:color .12s}
.ex-mv:hover{color:var(--text);background:var(--bg3)}

/* PROGRESS */
.ex-pills{display:flex;gap:8px;overflow-x:auto;padding-bottom:4px;margin-bottom:16px;scrollbar-width:none}
.ex-pills::-webkit-scrollbar{display:none}
.expill{flex-shrink:0;padding:8px 14px;border-radius:20px;background:var(--bg2);border:1px solid var(--border);font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap;color:var(--text2)}
.expill.active{background:var(--accent);border-color:var(--accent);color:var(--accent-ink);font-weight:700}
.prbox{background:var(--bg2);border-radius:14px;border:1px solid var(--border);padding:16px;margin-bottom:12px;display:grid;grid-template-columns:1fr 1fr;gap:12px}
.prv{font-size:26px;font-weight:700;font-family:'DM Mono',monospace}
.prl{font-size:11px;color:var(--text3);margin-top:2px;text-transform:uppercase;letter-spacing:.05em}
.prd{font-size:11px;color:var(--green);margin-top:4px}
.cchart{background:var(--bg2);border-radius:14px;border:1px solid var(--border);padding:16px;margin-bottom:12px}
.hist-row{display:flex;justify-content:space-between;align-items:center;padding:12px 14px;background:var(--bg2);border-radius:10px;border:1px solid var(--border);margin-bottom:8px}

/* PROFILE */
.pav{width:70px;height:70px;border-radius:50%;background:var(--bg3);border:2px solid var(--border);display:flex;align-items:center;justify-content:center;margin:0 auto 12px;font-size:28px}
.prow{display:flex;align-items:center;justify-content:space-between;padding:14px 16px;border-bottom:1px solid var(--border);cursor:pointer}
.prow:last-child{border-bottom:none}
.prow:active{background:var(--bg3)}

/* PWA INSTALL BANNER */
.install-banner{position:fixed;bottom:calc(var(--nav-h) + var(--sb) + 10px);left:12px;right:12px;z-index:400;background:var(--bg2);border:1px solid var(--border);border-radius:16px;padding:14px 16px;display:none;align-items:center;gap:12px;box-shadow:0 8px 32px rgba(0,0,0,.5);animation:slideUp .3s ease}
.install-banner.show{display:flex}
@keyframes slideUp{from{transform:translateY(20px);opacity:0}to{transform:translateY(0);opacity:1}}
.install-banner-icon{width:44px;height:44px;border-radius:10px;background:var(--accent);color:var(--accent-ink);display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0}
.install-banner-text{flex:1;min-width:0}
.install-banner-title{font-size:13px;font-weight:700;color:var(--text);letter-spacing:-.01em}
.install-banner-sub{font-size:11px;color:var(--text3);margin-top:2px}
.install-banner-btn{padding:8px 14px;background:var(--accent);color:var(--accent-ink);border:none;border-radius:8px;font-family:var(--fb);font-size:10px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;cursor:pointer;flex-shrink:0;white-space:nowrap}
.install-banner-close{background:none;border:none;color:var(--text3);cursor:pointer;font-size:18px;padding:2px 6px;flex-shrink:0;line-height:1}
/* PR TROPHY CABINET */
.pr-trophy-card{background:var(--bg2);border:1px solid var(--border);border-radius:12px;padding:12px 12px 10px;cursor:pointer;transition:opacity .12s;position:relative;overflow:hidden}
.pr-trophy-card:active{opacity:.7}
.pr-trophy-name{font-size:9px;font-weight:700;color:var(--text3);letter-spacing:.08em;text-transform:uppercase;font-family:var(--fb);margin-bottom:6px;line-height:1.3}
.pr-trophy-val{font-size:26px;font-weight:700;font-family:var(--fd);color:var(--text);letter-spacing:-.03em;line-height:.95}
.pr-trophy-unit{font-size:13px;font-weight:600;color:var(--text3);margin-left:1px}
.pr-trophy-orm{font-size:10px;color:var(--amber);font-family:var(--fm);margin-top:5px;font-weight:600}
.pr-trophy-trend{font-size:11px;font-weight:700;margin-top:4px}
.pr-trophy-when{font-size:9px;color:var(--text3);font-family:var(--fm);margin-top:2px}
.pr-trophy-empty{grid-column:1/-1;padding:24px 0;text-align:center;font-size:13px;color:var(--text3)}
/* PR EDIT SHEET */
.pr-edit-sheet{position:fixed;inset:0;z-index:300;display:none}
.pr-edit-sheet.open{display:block}
.pr-edit-bg{position:absolute;inset:0;background:rgba(0,0,0,.5)}
.pr-edit-box{position:absolute;bottom:0;left:0;right:0;background:var(--bg2);border-radius:20px 20px 0 0;max-height:82vh;display:flex;flex-direction:column;overflow:hidden}
.pr-edit-hdr{display:flex;align-items:center;justify-content:space-between;padding:14px 16px;border-bottom:1px solid var(--border);flex-shrink:0}
.pr-edit-body{overflow-y:auto;-webkit-overflow-scrolling:touch;padding:4px 16px 40px;flex:1}
.pr-ex-row{display:flex;align-items:center;gap:8px;padding:10px 0;border-bottom:1px solid var(--border)}
.pr-ex-row:last-child{border-bottom:none}
.pr-ex-name{flex:1;font-size:14px}
.pr-mv{width:30px;height:30px;border:none;border-radius:8px;background:var(--bg3);color:var(--text2);cursor:pointer;font-size:14px;line-height:1;flex-shrink:0;font-family:inherit;transition:color .12s}
.pr-mv:disabled{opacity:.2;cursor:default}
.pr-rm{width:30px;height:30px;border:none;border-radius:8px;background:none;color:var(--red);cursor:pointer;font-size:17px;line-height:1;flex-shrink:0}
.pr-add{width:30px;height:30px;border:none;border-radius:8px;background:none;color:var(--green);cursor:pointer;font-size:22px;line-height:1;flex-shrink:0}
.pr-sec-lbl{font-size:10px;font-weight:700;color:var(--text3);text-transform:uppercase;letter-spacing:.08em;margin:16px 0 4px}

/* SYNC */
.sync-pill{display:inline-flex;align-items:center;gap:6px;font-size:11px;color:var(--text3);font-weight:500;cursor:pointer;margin-top:5px}
.sdot{width:6px;height:6px;border-radius:50%;background:var(--text3)}
.sdot.ok{background:var(--green)}
.sdot.syncing{background:var(--amber);animation:blink .8s infinite}
.sdot.err{background:var(--red)}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}

/* MODAL */
.mbg{position:fixed;inset:0;background:rgba(0,0,0,.85);z-index:500;display:none;align-items:center;justify-content:center;padding:20px}
.mbg.open{display:flex}
.mbox{background:var(--bg2);border-radius:20px;width:100%;max-width:400px;padding:24px;max-height:90vh;overflow-y:auto}
.mbox h2{font-size:18px;font-weight:700;margin-bottom:6px}
.mbox p{font-size:13px;color:var(--text2);margin-bottom:16px;line-height:1.5}
.mbox label{font-size:12px;font-weight:600;color:var(--text2);display:block;margin-bottom:6px}
.mbox input,.mbox textarea,.mbox select{width:100%;padding:10px 12px;background:var(--bg3);border:1px solid var(--border);border-radius:10px;color:var(--text);font-family:'DM Mono',monospace;font-size:13px;outline:none;margin-bottom:12px}
.mbox input:focus,.mbox textarea:focus,.mbox select:focus{border-color:var(--blue)}
.cdisplay{background:var(--bg3);border:1px solid var(--border);border-radius:10px;padding:12px;font-family:'DM Mono',monospace;font-size:11px;color:var(--green);word-break:break-all;cursor:pointer;margin-bottom:6px}
.hint{font-size:11px;color:var(--text3);margin-bottom:16px}
.mbtns{display:flex;gap:8px}
.mbtn{flex:1;padding:12px;border-radius:10px;border:1px solid var(--border);background:var(--bg3);color:var(--text);font-family:inherit;font-size:14px;font-weight:600;cursor:pointer}
.mbtn.primary{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}

/* WARN */
.warn{background:#f9731614;border:1px solid #f9731640;border-radius:12px;padding:12px 14px;font-size:13px;color:var(--orange);margin-bottom:14px;line-height:1.5}

/* EMPTY */
.empty{text-align:center;padding:48px 24px;color:var(--text3)}
.empty-icon{font-size:40px;margin-bottom:12px}
.empty-title{font-size:16px;font-weight:600;color:var(--text2);margin-bottom:6px}
.empty-sub{font-size:13px;line-height:1.5}

/* MISC */
.sec-lbl{font-size:11px;font-weight:700;color:var(--text3);text-transform:uppercase;letter-spacing:.08em;margin:16px 0 8px}
.arrow{font-size:16px;color:var(--text3)}

/* EDIT SESSION OVERLAY */
.eoverlay{position:fixed;inset:0;background:var(--bg);z-index:280;overflow-y:auto;-webkit-overflow-scrolling:touch;display:none}
.eoverlay.open{display:block}
.etop{position:sticky;top:0;background:var(--bg);border-bottom:1px solid var(--border);padding:12px 16px;display:flex;align-items:center;justify-content:space-between;z-index:10}
.esave{padding:8px 18px;background:var(--accent);color:var(--accent-ink);border:none;border-radius:10px;font-family:inherit;font-size:14px;font-weight:700;cursor:pointer}
.einner{padding:12px 16px 120px;max-width:500px;margin:0 auto}
/* PREV SETS BLOCK in workout logger */
.prev-sets-block{background:var(--bg2);border-left:1px solid var(--border);border-right:1px solid var(--border);border-bottom:1px solid var(--border);padding:8px 14px}
.prev-sets-lbl{font-size:10px;font-weight:700;color:var(--text3);text-transform:uppercase;letter-spacing:.06em;margin-bottom:4px}
.prev-sets-row{font-size:12px;color:var(--text2);font-family:'DM Mono',monospace;line-height:1.85}
.prev-sets-none{font-size:12px;color:var(--text3);font-family:'DM Mono',monospace}
/* DEL SET BTN */
.delbtn{width:34px;height:34px;border-radius:50%;border:none;background:none;color:var(--text3);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:15px;flex-shrink:0}
.delbtn:hover{color:var(--red)}
/* LIBRARY OVERLAY */
.lovl{position:fixed;inset:0;background:var(--bg);z-index:290;overflow-y:auto;-webkit-overflow-scrolling:touch;display:none}
.lovl.open{display:block}
.ltop{position:sticky;top:0;background:var(--bg);border-bottom:1px solid var(--border);padding:12px 16px;display:flex;align-items:center;justify-content:space-between;z-index:10}
.linner{padding:12px 16px 120px;max-width:500px;margin:0 auto}
.lex-row{display:flex;align-items:center;justify-content:space-between;padding:13px 14px;background:var(--bg2);border-radius:12px;border:1px solid var(--border);margin-bottom:8px}
/* FEEDBACK MODAL */
.fbg{position:fixed;inset:0;background:rgba(0,0,0,.88);z-index:600;display:none;align-items:flex-end}
.fbg.open{display:flex}
.fsheet{background:var(--bg2);border-radius:20px 20px 0 0;width:100%;padding:24px;padding-bottom:calc(24px + var(--sb));max-height:85vh;overflow-y:auto}
.diff-btn{flex:1;padding:10px 4px;border-radius:10px;border:1.5px solid var(--border);background:none;color:var(--text2);font-family:inherit;font-size:11px;font-weight:600;cursor:pointer;text-align:center;line-height:1.4;transition:all .15s}
.diff-btn.active{border-color:var(--green);background:#22c55e18;color:var(--green)}
/* TIME EXERCISE BADGE */
.tbadge-ex{font-size:9px;font-weight:700;padding:1px 5px;border-radius:4px;background:var(--purple)22;color:var(--purple);border:1px solid var(--purple)44;letter-spacing:.04em;margin-left:5px;vertical-align:middle}

/* KPI PILL */
.kpi-pill{padding:5px 11px;border-radius:20px;background:var(--bg3);border:1px solid var(--border);font-size:12px;font-weight:600;cursor:pointer;color:var(--text2);white-space:nowrap;transition:all .15s}
.kpi-pill.active{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}

/* PR TOAST */
.pr-toast{position:fixed;top:20px;left:50%;transform:translateX(-50%);background:var(--bg2);border:1.5px solid var(--amber);border-radius:50px;padding:12px 20px;display:none;align-items:center;gap:10px;font-size:14px;font-weight:700;z-index:500;box-shadow:0 8px 32px rgba(0,0,0,.5);color:var(--amber);white-space:nowrap;max-width:90vw}
.pr-toast.show{display:flex}

/* PROGRESS v5 (Block / Lifts / Body) */
.pg-seg{display:flex;gap:4px;background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:3px;margin-bottom:12px}
.pg-seg button{flex:1;background:none;border:none;color:var(--text3);font-family:var(--fb);font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:8px 0;border-radius:7px;cursor:pointer}
.pg-seg button.on{background:var(--accent);color:var(--accent-ink)}
.pg-card{background:var(--bg2);border:1px solid var(--border);border-radius:12px;padding:14px;margin-bottom:10px}
.pg-rows{margin-top:4px}
.pg-row{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:10px 0;cursor:pointer}
.pg-rows>.pg-row+.pg-row{border-top:1px solid var(--border)}
.pg-n{font-size:14px;font-weight:600;color:var(--text)}
.pg-s{font-size:11px;color:var(--text3);font-family:var(--fm);margin-top:2px;overflow-wrap:anywhere}
.pg-v{font-family:var(--fm);font-size:13px;white-space:nowrap}
.pg-tool{font-size:9px;font-weight:700;color:var(--text4);letter-spacing:.06em;text-transform:uppercase;margin-left:2px}
.pg-big{font-family:var(--fd);font-size:30px;line-height:1;letter-spacing:.01em}
.pg-tiles{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:12px}
.pg-tile{background:var(--bg3);border-radius:8px;padding:8px 10px;min-width:0}
.pg-tile .v{font-family:var(--fm);font-size:18px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pg-tl{display:flex;gap:3px;margin-top:12px}
.pg-tl div{flex:1;height:8px;border-radius:2px}
.pg-tag{display:inline-block;font-size:9px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:2px 6px;border-radius:4px}
.pg-mus{display:grid;grid-template-columns:70px 1fr 26px;gap:7px 8px;align-items:center;margin-top:10px;font-size:11px;color:var(--text2)}
.pg-mus .tnum{text-align:right}
.pg-bar{height:6px;border-radius:3px;min-width:4px}
.pg-banner{border-radius:10px;padding:10px 12px;margin-bottom:10px;font-size:13px;line-height:1.4}
.warn-b{background:#f59e0b14;border:1px solid #f59e0b40;color:var(--amber)}
.deload-b{background:#60a5fa14;border:1px solid #60a5fa40;color:var(--blue)}
.test-b{background:#fbbf2414;border:1px solid #fbbf2440;color:var(--amber)}
.pg-back{background:none;border:none;color:var(--text2);font-family:var(--fb);font-size:13px;font-weight:600;cursor:pointer;padding:4px 0}
.pg-linkbtn{font-size:10px;font-weight:700;color:var(--accent);background:none;border:none;cursor:pointer;font-family:var(--fb);letter-spacing:.08em;text-transform:uppercase;padding:2px 0}
.pg-search{width:100%;box-sizing:border-box;background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:8px 10px;color:var(--text);font-family:inherit;font-size:13px;margin-top:10px}
.pg-life{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px;margin-top:10px;text-align:center}
.pg-life .v{font-family:var(--fm);font-size:18px;font-weight:600}
.pg-life sub{font-size:11px;color:var(--text3);margin-left:1px}
.pg-tile-btn{cursor:pointer;border:1px solid #f8717140}
.pg-missed-btn{display:block;width:100%;margin-top:10px;padding:10px;background:#f8717112;border:1px solid #f8717140;border-radius:10px;color:var(--red);font-family:var(--fb);font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;cursor:pointer}
/* LOG v2 timeline */
.lg-wrap{padding:0 16px 24px;max-width:500px;margin:0 auto}
.lg-sum{display:flex;gap:8px;margin-bottom:12px}
.lg-sum-cell{flex:1;background:var(--bg2);border:1px solid var(--border);border-radius:12px;padding:10px 12px}
.lg-sum-btn{cursor:pointer;border-color:#f8717140}
.lg-sum-v{font-family:var(--fm);font-size:20px;font-weight:600;margin-top:4px}
.lg-sum-v span{font-size:12px;color:var(--text3)}
.lg-chips{display:flex;gap:6px;overflow-x:auto;padding-bottom:4px;margin-bottom:12px;scrollbar-width:none}
.lg-chips::-webkit-scrollbar{display:none}
.lg-chip{flex-shrink:0;padding:7px 12px;border-radius:20px;border:1px solid var(--border);background:var(--bg2);color:var(--text2);font-family:var(--fb);font-size:11px;font-weight:700;letter-spacing:.04em;cursor:pointer}
.lg-chip.on{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}
.lg-week{background:var(--bg2);border:1px solid var(--border);border-radius:14px;padding:12px 12px 4px;margin-bottom:12px}
.lg-week-hd{display:flex;justify-content:space-between;align-items:flex-start;gap:8px;margin-bottom:10px}
.lg-week-t{font-family:var(--fd);font-size:22px;line-height:1;letter-spacing:.02em}
.lg-week-m{font-size:11px;color:var(--text3);font-family:var(--fm);margin-top:3px}
.lg-strip{display:grid;grid-template-columns:repeat(7,1fr);gap:4px;padding:8px 0 10px;border-bottom:1px solid var(--border);margin-bottom:2px}
.lg-day{display:flex;flex-direction:column;align-items:center;gap:4px}
.lg-dot{width:26px;height:26px;border-radius:50%;background:var(--bg3);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;color:#0a0a0a;border:2px solid transparent;box-sizing:border-box}
.lg-dot.plan{background:transparent;border-style:dashed}
.lg-dot.miss{background:#f8717118;border-color:#f8717166;color:var(--red)}
.lg-dot.now{outline:2px solid var(--accent);outline-offset:2px}
.lg-dl{font-size:9px;font-weight:700;color:var(--text3);font-family:var(--fb)}
.lg-row{display:flex;align-items:center;gap:12px;padding:11px 2px;cursor:pointer}
.lg-row+.lg-row{border-top:1px solid var(--border)}
.lg-row:active{background:var(--bg3)}
.lg-date{width:42px;flex-shrink:0;text-align:center;border-left:3px solid var(--border);padding-left:2px}
.lg-dw{font-size:9px;font-weight:700;color:var(--text3);letter-spacing:.08em}
.lg-dn{font-family:var(--fd);font-size:24px;line-height:1}
.lg-body{flex:1;min-width:0}
.lg-name{font-size:14px;font-weight:700;display:flex;align-items:center;gap:6px}
.lg-sub{font-size:11px;color:var(--text3);font-family:var(--fm);margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.lg-pr{font-size:9px;font-weight:800;color:var(--amber);background:#fbbf2418;border-radius:4px;padding:2px 5px;letter-spacing:.06em}
.lg-diff{width:7px;height:7px;border-radius:50%;flex-shrink:0}
.lg-meta{text-align:right;font-family:var(--fm);font-size:11px;color:var(--text3);flex-shrink:0;line-height:1.5}
.lg-meta div:first-child{color:var(--text2)}
.lg-missed .lg-date{border-left-color:#f8717166}
.lg-missed{opacity:.85}
.lg-empty{text-align:center;color:var(--text3);font-size:13px;padding:32px 0}
.pg-tile-btn:active{background:var(--bg4)}
.pg-missed{margin-top:12px;border-top:1px solid var(--border);padding-top:10px}
.pg-x{position:absolute;top:6px;right:6px;width:26px;height:26px;border-radius:13px;background:none;border:none;color:inherit;opacity:.7;font-size:18px;line-height:1;cursor:pointer}
.pg-x:hover{opacity:1;background:#ffffff14}
.log-older-btn{display:block;width:calc(100% - 32px);margin:4px 16px 12px;padding:11px;background:var(--bg2);border:1px dashed var(--border2);border-radius:12px;color:var(--text2);font-family:var(--fb);font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;cursor:pointer}
.log-month-head{margin:14px 16px 6px;color:var(--text2)}
.log-month-day.missed,.cyc-day.missed{opacity:.55;background:#f871710d!important;border-color:#f8717140!important}
/* CYCLE SUMMARY CARD */
.cycle-sum-card{background:var(--bg2);border:1.5px solid var(--green);border-radius:16px;padding:16px;margin-bottom:14px;position:relative}
.cycle-sum-dismiss{position:absolute;top:12px;right:12px;background:none;border:none;color:var(--text3);font-size:18px;cursor:pointer;padding:2px 6px;border-radius:6px;line-height:1}
.cycle-sum-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:12px}
.cycle-sum-cell{background:var(--bg3);border-radius:10px;padding:10px 8px;text-align:center}
.cycle-sum-val{font-size:18px;font-weight:700;font-family:'DM Mono',monospace}
.cycle-sum-lbl{font-size:10px;color:var(--text3);margin-top:3px;text-transform:uppercase;letter-spacing:.05em}
/* ── TODAY — REDESIGN ── */
.t-ribbon-wrap{position:sticky;top:0;z-index:50;background:var(--bg);padding:12px 12px 10px;border-bottom:1px solid var(--border)}
.t-ribbon{display:flex;gap:4px;max-width:500px;margin:0 auto}
.t-cell{flex:1;min-width:0;background:var(--bg2);border:1px solid var(--border);border-radius:8px;padding:7px 4px 6px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;cursor:pointer;position:relative;transition:transform .12s,opacity .12s;min-height:48px}
.t-cell:active{transform:scale(.96)}
.t-cell-num{font-size:9px;font-weight:700;color:var(--text3);letter-spacing:.04em;font-family:'DM Mono',monospace;text-transform:uppercase;line-height:1}
.t-cell-tag{font-size:8px;font-weight:700;letter-spacing:.04em;line-height:1;text-align:center;color:var(--text2);text-transform:uppercase}
.t-cell.rest .t-cell-tag{color:var(--text3)}
.t-cell.today{background:var(--text);border-color:var(--text)}
.t-cell.today .t-cell-num{color:var(--accent-ink);font-weight:700}
.t-cell.today .t-cell-tag{color:var(--accent-ink);opacity:.75}
.t-cell.done::after{content:"";position:absolute;top:3px;right:3px;width:5px;height:5px;border-radius:50%;background:var(--green)}
.t-cell.scrollable{flex:0 0 36px}
.t-ribbon.scrollable{overflow-x:auto;scrollbar-width:none;-webkit-overflow-scrolling:touch}
.t-ribbon.scrollable::-webkit-scrollbar{display:none}

.t-meta{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;padding:0 2px}
.t-meta-date{font-size:13px;color:var(--text2);font-weight:500}
.t-meta-date b{color:var(--text);font-weight:600;margin-right:4px}

/* Hero session card */
.t-hero{background:var(--bg2);border-radius:18px;border:1px solid var(--border);overflow:hidden;margin-bottom:14px;position:relative}
.t-hero-stripe{height:4px;width:100%}
.t-hero-body{padding:18px 18px 16px}
.t-hero-eyebrow{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.12em;margin-bottom:10px;display:flex;align-items:center;gap:8px}
.t-hero-eyebrow-meta{color:var(--text3);font-family:'DM Mono',monospace;font-weight:500;letter-spacing:.05em}
.t-hero-day{font-size:30px;font-weight:700;letter-spacing:-.6px;line-height:1.05;margin-bottom:3px}
.t-hero-sub{font-size:14px;color:var(--text2);margin-bottom:18px;font-weight:500}
.t-ex-list{display:flex;flex-direction:column;gap:1px;background:var(--border);border-radius:10px;overflow:hidden;margin-bottom:16px}
.t-ex-row{display:flex;align-items:center;justify-content:space-between;padding:10px 12px;background:var(--bg2);gap:10px;min-height:38px}
.t-ex-name{font-size:14px;font-weight:500;color:var(--text);min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1}
.t-ex-target{font-size:11px;color:var(--text3);font-family:'DM Mono',monospace;font-weight:500;flex-shrink:0;letter-spacing:.02em}
.t-ex-target.up{color:var(--green)}
.t-hero-cta{width:100%;padding:15px;background:var(--accent);color:var(--accent-ink);font-family:inherit;font-size:15px;font-weight:700;border:none;border-radius:12px;cursor:pointer;letter-spacing:.01em;transition:opacity .15s}
.t-hero-cta:hover{opacity:.92}
.t-hero-cta.secondary{background:var(--bg3);color:var(--text);border:1px solid var(--border)}
.t-hero-done{display:flex;align-items:center;justify-content:center;gap:8px;padding:14px;font-size:13px;color:var(--green);font-weight:600;background:#22c55e10;border-radius:12px}
.t-hero-done svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2.5}

/* Demoted KPI strip */
.t-kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:18px}
.t-kpis.four{grid-template-columns:repeat(4,1fr)}
.t-kpi{background:transparent;border:1px solid var(--border);border-radius:10px;padding:10px 8px;text-align:center}
.t-kpi-v{font-size:16px;font-weight:600;color:var(--text);font-family:'DM Sans',sans-serif;letter-spacing:-.01em;line-height:1.1}
.t-kpi-l{font-size:9px;color:var(--text3);margin-top:4px;font-weight:600;text-transform:uppercase;letter-spacing:.06em}

/* Sync pill in meta */
.t-sync{display:inline-flex;align-items:center;gap:6px;font-size:11px;color:var(--text3);font-weight:500;cursor:pointer}

/* Rest day variant */
.t-hero.rest .t-hero-day{font-size:24px;color:var(--text2)}
.t-hero.rest .t-hero-stripe{background:var(--border)}
/* ── WORKOUT LOGGER — FOCUS MODE ── */
.wk-modebar{display:flex;align-items:center;justify-content:space-between;padding:8px 4px 12px;max-width:500px;margin:0 auto}
.wk-mode-toggle{display:inline-flex;background:var(--bg2);border:1px solid var(--border);border-radius:9px;padding:2px;gap:2px}
.wk-mode-btn{padding:6px 11px;font-family:inherit;font-size:11px;font-weight:600;color:var(--text3);background:none;border:none;border-radius:7px;cursor:pointer;letter-spacing:.04em;text-transform:uppercase}
.wk-mode-btn.active{background:var(--bg4);color:var(--text)}
.wk-mode-meta{font-size:11px;color:var(--text3);font-family:'DM Mono',monospace;letter-spacing:.04em}

/* Focus card */
.fexb{background:var(--bg2);border:1px solid var(--border);border-radius:18px;margin-bottom:12px;overflow:hidden}
.fexb-head{display:flex;align-items:flex-start;justify-content:space-between;padding:14px 16px 10px;gap:10px}
.fexb-name{font-size:16px;font-weight:700;line-height:1.25}
.fexb-best{font-size:10px;color:var(--text3);margin-top:3px;font-family:'DM Mono',monospace;letter-spacing:.02em}
.fexb-best b{color:var(--amber);font-weight:700}
.fexb-mv{display:flex;flex-direction:column;gap:2px;flex-shrink:0}
.fmv-btn{width:24px;height:20px;border:none;background:none;cursor:pointer;color:var(--text3);font-size:13px;line-height:1;padding:0;border-radius:4px}
.fmv-btn:disabled{opacity:.18;pointer-events:none}
.fex-del{width:32px;height:32px;flex-shrink:0;border:1px solid var(--border);background:var(--bg3);border-radius:8px;cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0;color:var(--text3);margin-right:6px}
.fex-del svg{width:15px;height:15px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.fex-del:active{color:var(--red);border-color:var(--red)}
.pc-row{display:flex;align-items:center;gap:10px;padding:10px 12px;background:var(--bg3);border:1px solid var(--border);border-radius:10px;margin-bottom:6px;cursor:pointer;font-size:14px}
.pc-row input{width:18px;height:18px;accent-color:var(--green);flex-shrink:0}
.pc-lbl{font-size:12px;font-weight:600;color:var(--text2);margin:14px 0 8px;text-transform:uppercase;letter-spacing:.06em}
.kpi-row{display:flex;gap:6px;flex-wrap:wrap;align-items:center}
.kpi-row-lbl{font-size:10px;font-weight:700;color:var(--text3);text-transform:uppercase;letter-spacing:.08em;width:52px;flex-shrink:0}
.kpi-num{width:52px;padding:5px 8px;border-radius:20px;background:var(--bg3);border:1px solid var(--border);font-size:12px;font-weight:600;color:var(--text);font-family:inherit;outline:none;text-align:center}

/* Set chips (tappable, jump between sets) */
.fset-chips{display:flex;align-items:center;gap:6px;padding:0 16px 12px;flex-wrap:wrap}
.fset-chip{min-width:30px;height:30px;padding:0 10px;border-radius:8px;background:var(--bg3);border:1px solid var(--border);display:inline-flex;align-items:center;justify-content:center;font-family:'DM Mono',monospace;font-size:12px;font-weight:600;color:var(--text2);cursor:pointer;transition:all .12s}
.fset-chip.done{background:#22c55e22;border-color:#22c55e55;color:var(--green)}
.fset-chip.active{background:var(--text);border-color:var(--text);color:var(--accent-ink)}
.fset-chip.warmup{background:#f59e0b1a;border-color:#f59e0b3a;color:var(--amber);font-size:10px}
.fset-add{width:30px;height:30px;border-radius:8px;background:none;border:1px dashed var(--border);color:var(--text3);font-size:16px;line-height:1;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;font-family:inherit}
.fset-add:hover{color:var(--text);border-color:var(--text2)}

/* Active set body */
.fbody{padding:6px 16px 18px;border-top:1px solid var(--border);background:var(--bg)}
.fbody.done-state{background:#22c55e08}
.flbl{display:flex;align-items:center;justify-content:space-between;font-size:10px;color:var(--text3);font-weight:700;text-transform:uppercase;letter-spacing:.08em;margin:14px 0 8px}
.flbl-prev{font-family:'DM Mono',monospace;color:var(--text2);text-transform:none;letter-spacing:.02em;font-weight:500}
.fstepper{display:flex;align-items:center;gap:8px}
.fstep-btn{flex-shrink:0;height:48px;padding:0 12px;background:var(--bg3);border:1px solid var(--border);border-radius:11px;color:var(--text);font-family:'DM Mono',monospace;font-size:13px;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;transition:background .12s,transform .08s;min-width:54px}
.fstep-btn:active{transform:scale(.94);background:var(--bg4)}
.fstep-btn.minor{min-width:46px;font-size:12px;color:var(--text2)}
.finput-wrap{flex:1;position:relative}
.finput{width:100%;height:48px;padding:0 14px;background:var(--bg3);border:1px solid var(--border);border-radius:11px;color:var(--text);font-family:'DM Mono',monospace;font-size:22px;font-weight:600;text-align:center;outline:none;-moz-appearance:textfield}
.finput::-webkit-outer-spin-button,.finput::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
.finput:focus{border-color:var(--text2);background:var(--bg4)}
.finput-suffix{position:absolute;right:12px;top:50%;transform:translateY(-50%);font-size:11px;color:var(--text3);font-family:'DM Mono',monospace;font-weight:600;pointer-events:none;letter-spacing:.04em}

/* Action row: warm-up toggle, big check, delete */
.fact-row{display:flex;align-items:center;gap:10px;margin-top:18px}
.fact-wu{flex-shrink:0;height:46px;padding:0 14px;background:var(--bg3);border:1px solid var(--border);border-radius:11px;color:var(--text2);font-family:inherit;font-size:11px;font-weight:600;cursor:pointer;letter-spacing:.06em;text-transform:uppercase;display:inline-flex;align-items:center;justify-content:center;gap:6px}
.fact-wu.active{background:#f59e0b22;border-color:#f59e0b66;color:var(--amber)}
.fact-check{flex:1;height:46px;background:var(--green);color:#000;border:none;border-radius:11px;font-family:inherit;font-size:14px;font-weight:700;cursor:pointer;letter-spacing:.04em;display:inline-flex;align-items:center;justify-content:center;gap:8px;transition:opacity .12s,transform .08s}
.fact-check:active{transform:scale(.97)}
.fact-check.done{background:var(--bg3);color:var(--text2);border:1px solid var(--border)}
.fact-check svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2.6;stroke-linecap:round;stroke-linejoin:round}
.fact-del{flex-shrink:0;width:46px;height:46px;background:none;border:1px solid var(--border);border-radius:11px;color:var(--text3);font-size:14px;cursor:pointer;display:inline-flex;align-items:center;justify-content:center}
.fact-del:hover{color:var(--red);border-color:var(--red)}
/* ─────────────────────────────────────────────────────────────
   V4 — Athletic/sharp components
   ───────────────────────────────────────────────────────────── */

/* Page headers — eyebrow + display title */
.v4h{padding:8px 20px 12px}
.v4h-eyebrow{font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--text3);font-family:var(--fb)}
.v4h-title{font-size:28px;font-weight:800;color:var(--text);margin-top:2px;letter-spacing:-.01em;line-height:1.05;font-family:var(--fb)}
.v4h-sub{font-size:12px;color:var(--text3);margin-top:4px}

/* Day-type pill — small chip with semantic color */
.v4pill{display:inline-flex;align-items:center;gap:4px;font-size:9px;font-weight:700;letter-spacing:.08em;font-family:var(--fb);text-transform:uppercase;padding:4px 8px;border-radius:4px;border:1px solid}
.v4pill.push{color:var(--push);background:rgba(96,165,250,.13);border-color:rgba(96,165,250,.4)}
.v4pill.legs{color:var(--legs);background:rgba(251,146,60,.13);border-color:rgba(251,146,60,.4)}
.v4pill.pull{color:var(--pull);background:rgba(74,222,128,.13);border-color:rgba(74,222,128,.4)}
.v4pill.rest{color:var(--text3);background:transparent;border-color:var(--border)}
.v4pill.amber{color:var(--amber);background:rgba(251,191,36,.13);border-color:rgba(251,191,36,.4)}
.v4pill.accent{color:var(--accent);background:rgba(212,255,58,.13);border-color:rgba(212,255,58,.5)}

/* Sync pill (top-right of Today) */
.v4sync{display:inline-flex;align-items:center;gap:6px;font-size:9px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;font-family:var(--fb);cursor:pointer}
.v4sync-dot{width:6px;height:6px;border-radius:50%;background:var(--green)}
.v4sync.err .v4sync-dot{background:var(--red)}
.v4sync.sync .v4sync-dot{background:var(--amber);animation:blink .8s infinite}
.v4sync.off .v4sync-dot{background:var(--text3)}

/* Hero workout card */
.v4hero{margin:0 16px;background:var(--bg2);border-radius:16px;overflow:hidden;border:1px solid var(--border);margin-bottom:12px}
.v4hero-top{padding:18px 20px 0;display:flex;justify-content:space-between;align-items:flex-start}
.v4hero-eyebrow{display:flex;align-items:center;gap:6px;font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;font-family:var(--fb)}
.v4hero-eyebrow .dot{width:6px;height:6px;border-radius:50%}
.v4hero-day{font-family:var(--fd);font-size:64px;line-height:.85;color:var(--text);margin-top:10px;letter-spacing:-.03em}
.v4hero-meta{text-align:right}
.v4hero-cyc{font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--text3);font-family:var(--fb)}
.v4hero-prog{font-family:var(--fm);font-size:11px;color:var(--text2);margin-top:4px}
.v4hero-info{padding:8px 20px 16px;font-size:13px;color:var(--text2)}
.v4hero-list{background:var(--bg3);padding:12px 20px}
.v4hero-row{display:flex;align-items:center;justify-content:space-between;padding:8px 0}
.v4hero-row-n{font-size:13px;color:var(--text);font-weight:600}
.v4hero-row-s{font-size:9px;color:var(--text3);font-weight:700;letter-spacing:.1em;text-transform:uppercase;margin-top:2px;font-family:var(--fb)}
.v4hero-row-r{font-family:var(--fm);font-size:11px;color:var(--text2)}
.v4hero-more{font-size:9px;color:var(--text4);font-weight:700;letter-spacing:.1em;text-transform:uppercase;margin-top:6px;font-family:var(--fb)}
.v4hero-cta{padding:14px}
.v4btn{width:100%;padding:14px 16px;border-radius:10px;border:none;cursor:pointer;font-family:var(--fb);font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;transition:opacity .15s}
.v4btn.primary{background:var(--accent);color:var(--accent-ink)}
.v4btn.primary:active{opacity:.85}
.v4btn.ghost{background:var(--bg3);color:var(--text);border:1px solid var(--border)}
.v4btn.done-state{background:rgba(74,222,128,.12);border:1px solid rgba(74,222,128,.4);color:var(--green);cursor:default}

/* Cycle progress strip */
.v4cyc{margin:0 16px 12px;padding:14px 16px;background:var(--bg2);border-radius:12px;border:1px solid var(--border)}
.v4cyc-hd{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:10px}
.v4cyc-bars{display:flex;gap:3px}
.v4cyc-bar{flex:1;height:4px;border-radius:2px;background:var(--bg3)}
.v4cyc-bar.done{background:var(--green)}
.v4cyc-bar.now{background:var(--accent)}
.v4cyc-bar.rest{background:var(--text4)}
.v4cyc-lbls{display:flex;gap:3px;margin-top:6px}
.v4cyc-lbl{flex:1;text-align:center;font-size:8px;font-weight:700;color:var(--text4);font-family:var(--fb);letter-spacing:.05em}
.v4cyc-lbl.now{color:var(--text)}

/* Stat trio for Today bottom */
.v4stats{margin:0 16px 16px;display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.v4stat{background:var(--bg2);padding:12px 14px;border-radius:10px;border:1px solid var(--border)}
.v4stat-l{font-size:9px;font-weight:700;color:var(--text3);letter-spacing:.1em;text-transform:uppercase;font-family:var(--fb)}
.v4stat-v{font-family:var(--fd);font-size:28px;color:var(--text);margin-top:4px;letter-spacing:-.02em;line-height:.95}
.v4stat-v sub{font-size:13px;color:var(--text3);font-weight:600;margin-left:2px}
.v4stat-s{font-size:11px;color:var(--text3);margin-top:0}

/* Cycle summary banner (kept but restyled to v4) */
.v4-cycsum{margin:0 16px 14px;background:rgba(74,222,128,.08);border:1px solid rgba(74,222,128,.35);border-radius:12px;padding:14px 16px;position:relative}
.v4-cycsum-eyebrow{font-size:9px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--green);font-family:var(--fb);margin-bottom:8px}
.v4-cycsum-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:6px}
.v4-cycsum-cell{background:var(--bg3);border-radius:8px;padding:10px 8px;text-align:center}
.v4-cycsum-val{font-family:var(--fd);font-size:24px;color:var(--text);letter-spacing:-.02em;line-height:.95}
.v4-cycsum-lbl{font-size:9px;color:var(--text3);font-weight:700;letter-spacing:.1em;text-transform:uppercase;margin-top:4px;font-family:var(--fb)}
.v4-cycsum-x{position:absolute;top:10px;right:10px;background:none;border:none;color:var(--text3);font-size:18px;cursor:pointer;line-height:1;padding:2px 6px;border-radius:6px}

/* Timeline (Calendar B) */
.v4tl{padding:0 16px}
.v4tl-row{display:flex;gap:12px;padding:14px 0;border-bottom:1px solid var(--border);cursor:pointer}
.v4tl-row:last-child{border-bottom:none}
.v4tl-row:active{opacity:.75}
.v4tl-date{width:48px;text-align:center;flex-shrink:0}
.v4tl-day{font-size:9px;color:var(--text3);font-weight:700;letter-spacing:.06em;font-family:var(--fb)}
.v4tl-row.today .v4tl-day{color:var(--accent)}
.v4tl-num{font-family:var(--fd);font-size:24px;color:var(--text);letter-spacing:-.02em;margin-top:2px;line-height:.95}
.v4tl-row.rest .v4tl-num{color:var(--text3)}
.v4tl-mon{font-size:8px;color:var(--text4);font-weight:700;letter-spacing:.06em;font-family:var(--fb);margin-top:1px}
.v4tl-bar{width:3px;border-radius:2px;background:var(--bg3);flex-shrink:0}
.v4tl-row.today .v4tl-bar{background:var(--accent)}
.v4tl-row.push .v4tl-bar{background:var(--push)}
.v4tl-row.legs .v4tl-bar{background:var(--legs)}
.v4tl-row.pull .v4tl-bar{background:var(--pull)}
.v4tl-body{flex:1;padding-top:2px;min-width:0}
.v4tl-tags{display:flex;align-items:center;gap:6px;margin-bottom:4px;flex-wrap:wrap}
.v4tl-name{font-size:14px;color:var(--text);font-weight:600;margin-top:2px}
.v4tl-row.rest .v4tl-name{color:var(--text3);font-weight:500}
.v4tl-stats{font-family:var(--fm);font-size:11px;color:var(--text3);margin-top:4px}
.v4tl-stats em{font-style:normal;color:var(--amber)}

/* Streak strip */
.v4streak{margin:0 16px 16px;padding:12px 14px;background:var(--bg2);border-radius:10px;border:1px solid var(--border);display:flex;justify-content:space-between}
.v4streak-col-l{font-size:9px;font-weight:700;color:var(--text3);letter-spacing:.1em;text-transform:uppercase;font-family:var(--fb)}
.v4streak-col-v{font-family:var(--fd);font-size:28px;letter-spacing:-.02em;margin-top:2px;line-height:.95}
.v4streak-col-v sub{font-size:13px;color:var(--text3);margin-left:4px}

/* Cycle divider */
.v4tl-divider{display:flex;align-items:center;gap:10px;padding:18px 0 12px}
.v4tl-divider hr{flex:1;border:none;height:1px;background:var(--border)}
.v4tl-divider span{font-size:9px;font-weight:700;color:var(--text3);letter-spacing:.14em;text-transform:uppercase;font-family:var(--fb)}

/* ── LOG VIEW ── */
/* Tabs */
.log-tabs{display:flex;gap:6px;padding:0 16px 14px;max-width:500px;margin:0 auto;box-sizing:border-box}
.log-tab{flex:1;padding:9px 6px;background:var(--bg2);border:1px solid var(--border);border-radius:8px;font-family:var(--fb);font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--text3);cursor:pointer;transition:background .15s,color .15s}
.log-tab.active{background:var(--text);color:var(--bg);border-color:var(--text)}
/* Cycle cards */
.cyc-card{background:var(--bg2);border:1px solid var(--border);border-radius:14px;padding:14px;margin:0 16px 10px}
.cyc-card.cyc-active{border-color:var(--accent);box-shadow:0 0 0 1px rgba(212,255,58,.2)}
.cyc-hd{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:10px}
.cyc-title{font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--text3);font-family:var(--fb)}
.cyc-dates{font-size:11px;color:var(--text4);margin-top:2px;font-family:var(--fm)}
.cyc-badge{font-size:8px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:3px 9px;border-radius:20px;white-space:nowrap}
.cyc-badge.done{color:var(--green);background:rgba(74,222,128,.12);border:1px solid rgba(74,222,128,.3)}
.cyc-badge.now{color:var(--accent);background:rgba(212,255,58,.12);border:1px solid rgba(212,255,58,.35)}
/* Day cells — shared colour system */
.cyc-days{display:flex;gap:3px}
.cyc-days-wide{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:3px}
.cyc-day{flex:1;min-width:0;border-radius:8px;padding:7px 2px 6px;display:flex;flex-direction:column;align-items:center;gap:2px;position:relative;cursor:pointer;border:1px solid var(--bg3);background:var(--bg2);transition:opacity .12s}
.cyc-day:active{opacity:.65}
.cyc-day.day-rest{opacity:.2;cursor:default;border-color:transparent;background:transparent}
.cyc-day.day-rest:active{opacity:.2}
.cyc-day.day-today{border-color:var(--accent)!important;box-shadow:0 0 0 1px rgba(212,255,58,.25)}
.cyc-day.day-future{opacity:.5}
.cyc-day.day-push{border-color:rgba(96,165,250,.5);background:rgba(96,165,250,.07)}
.cyc-day.day-legs{border-color:rgba(251,146,60,.5);background:rgba(251,146,60,.07)}
.cyc-day.day-pull{border-color:rgba(74,222,128,.5);background:rgba(74,222,128,.07)}
.cyc-day.day-push-s{border-color:rgba(167,139,250,.5);background:rgba(167,139,250,.07)}
.cyc-day.day-legs-h{border-color:rgba(251,191,36,.5);background:rgba(251,191,36,.07)}
.cyc-day-name{font-size:8px;font-weight:700;letter-spacing:.04em;font-family:var(--fb);color:var(--text4)}
.cyc-day-abbr{font-size:7px;font-weight:700;font-family:var(--fb);text-align:center;line-height:1.2;padding:0 1px}
.cyc-day.day-push .cyc-day-abbr{color:rgba(96,165,250,.9)}
.cyc-day.day-legs .cyc-day-abbr{color:rgba(251,146,60,.9)}
.cyc-day.day-pull .cyc-day-abbr{color:rgba(74,222,128,.9)}
.cyc-day.day-push-s .cyc-day-abbr{color:rgba(167,139,250,.9)}
.cyc-day.day-legs-h .cyc-day-abbr{color:rgba(251,191,36,.9)}
.cyc-day-check{font-size:9px;font-weight:700;color:var(--green);line-height:1}
.cyc-day.cyc-day-pr .cyc-day-check{color:var(--amber)}
.cyc-day-now{font-size:6px;font-weight:700;color:var(--accent);letter-spacing:.06em;font-family:var(--fb);position:absolute;top:3px;right:3px;line-height:1}
/* Month grid */
.log-month-nav{display:flex;align-items:center;justify-content:space-between;padding:0 16px 8px}
.log-month-title{font-size:15px;font-weight:700;letter-spacing:-.01em}
.log-month-btn{background:none;border:1px solid var(--border);border-radius:8px;width:34px;height:34px;cursor:pointer;color:var(--text2);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.log-legend{display:flex;flex-wrap:wrap;gap:5px 10px;padding:0 16px 10px}
.log-legend-item{display:flex;align-items:center;gap:5px;font-size:10px;font-weight:600;color:var(--text3);font-family:var(--fb)}
.log-legend-dot{width:8px;height:8px;border-radius:3px;flex-shrink:0}
.log-month-grid{display:grid;grid-template-columns:24px repeat(7,1fr);gap:3px;padding:0 16px}
.log-month-wk{display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:700;color:var(--text4);font-family:var(--fm)}
.log-month-wk.now{color:var(--accent)}
.log-month-day.planned{background:transparent!important;border-style:dashed!important;opacity:.75}
.log-month-day.planned .log-month-day-type{opacity:.8}
.log-month-day.done.push{background:rgba(96,165,250,.28)}
.log-month-day.done.legs{background:rgba(251,146,60,.28)}
.log-month-day.done.pull{background:rgba(74,222,128,.28)}
.log-month-day.done.push-s{background:rgba(167,139,250,.28)}
.log-month-day.done.legs-h{background:rgba(251,191,36,.28)}
.log-month-day.done .log-month-day-num{color:var(--text)!important}
.log-month-day.done .log-month-day-check{font-size:11px}
.lgk{display:inline-flex;width:12px;height:12px;border-radius:3px;align-items:center;justify-content:center;font-size:8px;font-weight:800;margin-right:4px;vertical-align:-2px}
.lgk-done{background:rgba(96,165,250,.35);color:var(--green)}
.lgk-plan{border:1px dashed var(--text3)}
.lgk-miss{background:#f8717118;color:var(--red);border:1px solid #f8717155}
.lg-tag{font-family:var(--fb);font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--accent);border:1px solid #d4ff3a55;border-radius:4px;padding:2px 6px;margin-left:8px;vertical-align:4px}
.log-month-dow{text-align:center;font-size:9px;font-weight:700;color:var(--text3);letter-spacing:.06em;padding:4px 0;font-family:var(--fb)}
.log-month-day{border-radius:8px;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;padding:5px 2px 4px;cursor:pointer;border:1px solid var(--bg3);background:var(--bg2);min-height:50px;gap:2px}
.log-month-day:active{opacity:.7}
.log-month-day.empty{cursor:default;background:transparent;border-color:transparent;pointer-events:none}
.log-month-day.today{border-color:var(--accent)!important;box-shadow:0 0 0 1px rgba(212,255,58,.25)}
.log-month-day.push{border-color:rgba(96,165,250,.5);background:rgba(96,165,250,.07)}
.log-month-day.legs{border-color:rgba(251,146,60,.5);background:rgba(251,146,60,.07)}
.log-month-day.pull{border-color:rgba(74,222,128,.5);background:rgba(74,222,128,.07)}
.log-month-day.push-s{border-color:rgba(167,139,250,.5);background:rgba(167,139,250,.07)}
.log-month-day.legs-h{border-color:rgba(251,191,36,.5);background:rgba(251,191,36,.07)}
.log-month-day.day-rest{border-color:var(--bg3);background:var(--bg2);opacity:.4}
.log-month-day-num{font-size:10px;font-weight:700;color:var(--text3);font-family:var(--fd);line-height:1}
.log-month-day.push .log-month-day-num,.log-month-day.legs .log-month-day-num,.log-month-day.pull .log-month-day-num,.log-month-day.push-s .log-month-day-num,.log-month-day.legs-h .log-month-day-num{color:var(--text2)}
.log-month-day-type{font-size:7px;font-weight:700;font-family:var(--fb);text-align:center;line-height:1.2}
.log-month-day.push .log-month-day-type{color:rgba(96,165,250,.9)}
.log-month-day.legs .log-month-day-type{color:rgba(251,146,60,.9)}
.log-month-day.pull .log-month-day-type{color:rgba(74,222,128,.9)}
.log-month-day.push-s .log-month-day-type{color:rgba(167,139,250,.9)}
.log-month-day.legs-h .log-month-day-type{color:rgba(251,191,36,.9)}
.log-month-day-check{font-size:9px;font-weight:700;color:var(--green);line-height:1}
/* Type selector pills in add-day sheet */
.day-type-pills{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:14px}
.day-type-pill{padding:7px 10px;border-radius:8px;font-family:var(--fb);font-size:10px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;cursor:pointer;border:1px solid var(--border);background:var(--bg3);color:var(--text3);transition:all .12s}
.day-type-pill.sel{background:var(--bg4);border-color:currentColor}
/* List view */
.log-list-item{background:var(--bg2);border:1px solid var(--border);border-radius:12px;padding:13px 14px;margin:0 16px 8px;cursor:pointer}
.log-list-item:active{opacity:.7}
/* Add-day sheet */
.add-day-sheet{position:fixed;inset:0;z-index:300;display:none}
.add-day-sheet.open{display:block}
.add-day-bg{position:absolute;inset:0;background:rgba(0,0,0,.6)}
.add-day-box{position:absolute;bottom:0;left:0;right:0;background:var(--bg2);border-radius:20px 20px 0 0;max-height:85vh;overflow-y:auto;-webkit-overflow-scrolling:touch;padding:20px 16px calc(20px + env(safe-area-inset-bottom))}
.add-day-handle{width:36px;height:4px;border-radius:2px;background:var(--bg4);margin:0 auto 20px}

/* Progress Dashboard — stat tiles */
.v4dash-period{padding:0 16px 14px;display:flex;gap:6px}
.v4dash-pchip{background:transparent;color:var(--text2);border:1px solid var(--border);padding:6px 14px;border-radius:6px;font-family:var(--fb);font-size:9px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;cursor:pointer}
.v4dash-pchip.active{background:var(--text);color:var(--bg);border-color:var(--text)}
.v4dash-grid{margin:0 16px;display:grid;grid-template-columns:1fr 1fr;gap:8px}
.v4dash-card{background:var(--bg2);padding:14px;border-radius:12px;border:1px solid var(--border)}
.v4dash-card.full{grid-column:span 2}
.v4dash-card.spark{display:flex;justify-content:space-between;align-items:flex-start}
.v4dash-spark{width:96px;height:46px;flex-shrink:0;margin-top:-2px}
.v4dash-val{font-family:var(--fd);color:var(--text);letter-spacing:-.02em;line-height:.95}
.v4dash-val.lg{font-size:48px;margin-top:6px}
.v4dash-val.md{font-size:32px;margin-top:4px}
.v4dash-val sub{font-size:.45em;color:var(--text3);font-weight:600;margin-left:2px}
.v4dash-delta{font-family:var(--fm);font-size:11px;margin-top:4px}
.v4dash-delta.up{color:var(--green)}
.v4dash-delta.down{color:var(--red)}

/* Balance bars */
.v4bal{margin:8px 16px;background:var(--bg2);border-radius:12px;border:1px solid var(--border);padding:14px 16px}
.v4bal-row{display:flex;align-items:center;gap:10px;margin-top:8px}
.v4bal-row:first-child{margin-top:0}
.v4bal-lbl{font-size:9px;font-weight:700;color:var(--text3);letter-spacing:.1em;font-family:var(--fb);width:48px}
.v4bal-track{flex:1;height:6px;background:var(--bg3);border-radius:3px;overflow:hidden}
.v4bal-fill{height:100%;border-radius:3px}
.v4bal-val{font-family:var(--fm);color:var(--text2);width:28px;text-align:right;font-size:11px}

/* PR list */
.v4prs{margin:8px 16px 16px;background:var(--bg2);border-radius:12px;border:1px solid var(--border);padding:14px 16px}
.v4prs-row{display:flex;align-items:center;justify-content:space-between;padding:9px 0;border-bottom:1px solid var(--border)}
.v4prs-row:last-child{border-bottom:none}
.v4prs-name{font-size:13px;color:var(--text);font-weight:600}
.v4prs-sub{font-family:var(--fm);font-size:11px;color:var(--text3);margin-top:3px}
.v4prs-delta{font-family:var(--fb);font-size:11px;font-weight:700;color:var(--amber);letter-spacing:.04em}

/* Profile A — identity tags */
.v4ident{padding:0 20px 18px}
.v4ident-tags{display:flex;flex-wrap:wrap;gap:6px}
.v4ident-tag{background:var(--bg2);border:1px solid var(--border);padding:5px 10px;border-radius:4px;font-size:9px;font-weight:700;color:var(--text3);letter-spacing:.1em;text-transform:uppercase;font-family:var(--fb)}
.v4ident-target{margin-top:12px;padding:11px 14px;background:rgba(212,255,58,.08);border:1px solid rgba(212,255,58,.4);border-radius:8px;display:flex;align-items:center;gap:10px;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--accent);font-family:var(--fb)}
.v4ident-target .dot{width:6px;height:6px;border-radius:50%;background:var(--accent);flex-shrink:0}
.v4ident-target .days{margin-left:auto;font-family:var(--fm);color:var(--text2);letter-spacing:0;text-transform:none;font-weight:500;font-size:11px}

/* Profile A — lifetime card */
.v4life{margin:0 16px 16px;background:var(--bg2);border:1px solid var(--border);border-radius:12px;padding:16px}
.v4life-row{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px}
.v4life-cell .v{font-family:var(--fd);font-size:32px;color:var(--text);letter-spacing:-.02em;line-height:.95}
.v4life-cell .v sub{font-size:.5em;color:var(--text3);font-weight:600;margin-left:2px}
.v4life-cell .l{font-size:9px;font-weight:700;color:var(--text3);letter-spacing:.1em;text-transform:uppercase;margin-top:4px;font-family:var(--fb)}
.v4life-hr{height:1px;background:var(--border);margin:14px 0}
.v4life-cell.sm .v{font-size:22px}

/* Profile A — settings list */
.v4set-list{margin:0 16px;background:var(--bg2);border:1px solid var(--border);border-radius:12px;overflow:hidden}
.v4set-row{display:flex;align-items:center;gap:12px;padding:14px 16px;border-bottom:1px solid var(--border);cursor:pointer}
.v4set-row:last-child{border-bottom:none}
.v4set-row:active{background:var(--bg3)}
.v4set-row svg{width:18px;height:18px;stroke:var(--text2);fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}
.v4set-row .lbl{flex:1;font-size:13px;color:var(--text);font-weight:500}
.v4set-row .val{font-family:var(--fm);font-size:11px;color:var(--text2)}
.v4set-row .val.ok{color:var(--green)}
.v4set-row .arrow{color:var(--text4);font-size:16px}

/* HR utility */
.v4hr{height:1px;background:var(--border)}
</style>
</head>
<body>

<!-- WORKOUT FEEDBACK MODAL -->
<div class="fbg" id="feedback-modal">
  <div class="fsheet">
    <div style="font-size:20px;font-weight:700;margin-bottom:4px">Session complete! 💪</div>
    <div style="font-size:13px;color:var(--text2);margin-bottom:20px">How did that feel?</div>
    <div style="font-size:12px;font-weight:600;color:var(--text2);margin-bottom:8px;text-transform:uppercase;letter-spacing:.06em">Difficulty</div>
    <div style="display:flex;gap:6px;margin-bottom:20px" id="diff-row">
      <button class="diff-btn" onclick="selectDiff(this,'Very Easy')">Very<br>Easy</button>
      <button class="diff-btn" onclick="selectDiff(this,'Easy')">Easy</button>
      <button class="diff-btn active" onclick="selectDiff(this,'Moderate')">Moderate</button>
      <button class="diff-btn" onclick="selectDiff(this,'Difficult')">Difficult</button>
      <button class="diff-btn" onclick="selectDiff(this,'Very Difficult')">Very<br>Hard</button>
    </div>
    <div style="font-size:12px;font-weight:600;color:var(--text2);margin-bottom:8px;text-transform:uppercase;letter-spacing:.06em">Comment <span style="color:var(--text3);font-weight:400">(optional)</span></div>
    <textarea id="fb-comment" placeholder="Notes, how you felt, what to improve…" style="width:100%;padding:10px 12px;background:var(--bg3);border:1px solid var(--border);border-radius:10px;color:var(--text);font-family:inherit;font-size:14px;resize:none;height:76px;outline:none;margin-bottom:16px;display:block"></textarea>
    <div style="display:flex;gap:10px">
      <button onclick="skipFeedback()" style="flex:1;padding:14px;background:var(--bg3);border:1px solid var(--border);border-radius:12px;color:var(--text2);font-family:inherit;font-size:14px;font-weight:600;cursor:pointer">Skip</button>
      <button onclick="saveFeedback()" style="flex:2;padding:14px;background:var(--green);color:#000;border:none;border-radius:12px;font-family:inherit;font-size:14px;font-weight:700;cursor:pointer">Save Feedback</button>
    </div>
  </div>
</div>

<!-- PROGRAM CHANGES MODAL (shown after finishing a workout when it differs from the plan) -->
<div class="fbg" id="planchg-modal">
  <div class="fsheet" style="max-height:85vh;overflow-y:auto">
    <div style="font-size:20px;font-weight:700;margin-bottom:4px">Program changes?</div>
    <div style="font-size:13px;color:var(--text2)" id="planchg-sub">This workout was different from your program.</div>
    <div id="planchg-list"></div>
    <div style="display:flex;gap:10px;margin-top:18px">
      <button onclick="skipPlanChanges()" style="flex:1;padding:14px;background:var(--bg3);border:1px solid var(--border);border-radius:12px;color:var(--text2);font-family:inherit;font-size:13px;font-weight:600;cursor:pointer">Skip, don't change</button>
      <button onclick="applyPlanChanges()" style="flex:1;padding:14px;background:var(--green);color:#000;border:none;border-radius:12px;font-family:inherit;font-size:14px;font-weight:700;cursor:pointer">Apply</button>
    </div>
  </div>
</div>

<!-- PROGRAMS OVERLAY -->
<div class="prog-overlay" id="programs-overlay">
  <div class="prog-top">
    <button class="back" onclick="closeProgramsOverlay()"><svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" fill="none" stroke-width="2.5" stroke-linecap="round"><polyline points="15 18 9 12 15 6"/></svg>Back</button>
    <div style="font-size:16px;font-weight:700">Programs</div>
    <button onclick="openNewProgSheet()" style="font-size:12px;font-weight:700;color:var(--accent);background:none;border:none;cursor:pointer;font-family:var(--fb);letter-spacing:.06em;text-transform:uppercase;padding:4px 8px">+ New</button>
  </div>
  <div class="prog-inner" id="programs-inner"></div>
</div>

<!-- NEW / EDIT PROGRAM SHEET -->
<div class="add-day-sheet" id="new-prog-sheet">
  <div class="add-day-bg" onclick="closeNewProgSheet()"></div>
  <div class="add-day-box">
    <div class="add-day-handle"></div>
    <div id="new-prog-inner"></div>
  </div>
</div>

<!-- ACTIVATE PROGRAM SHEET -->
<div class="add-day-sheet" id="activate-prog-sheet">
  <div class="add-day-bg" onclick="closeActivateProgSheet()"></div>
  <div class="add-day-box">
    <div class="add-day-handle"></div>
    <div id="activate-prog-inner"></div>
  </div>
</div>

<!-- EXERCISE LIBRARY OVERLAY -->
<div class="lovl" id="lib-overlay">
  <div class="ltop">
    <button class="back" onclick="closeLibrary()"><svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>Back</button>
    <div style="font-size:16px;font-weight:700">Exercise Library</div>
    <button onclick="openAddLibEx()" style="font-size:13px;font-weight:700;color:var(--green);background:none;border:none;cursor:pointer;font-family:inherit;padding:6px 10px">+ Add</button>
  </div>
  <div class="linner" id="lib-inner"></div>
</div>

<!-- ADD EXERCISE TO LIBRARY SHEET -->
<div class="soverlay" id="addex-sheet" onclick="if(event.target===this)closeAddLibEx()">
  <div class="sheet">
    <div class="shandle"></div>
    <div class="stitle">New Exercise</div>
    <div style="padding:0 16px 20px">
      <div style="font-size:12px;font-weight:600;color:var(--text2);margin-bottom:6px">Exercise Name</div>
      <input id="newex-name" type="text" placeholder="e.g. Cable Row (Machine)" style="width:100%;padding:10px 14px;background:var(--bg3);border:1px solid var(--border);border-radius:10px;color:var(--text);font-family:inherit;font-size:14px;outline:none;margin-bottom:14px;display:block">
      <div style="font-size:12px;font-weight:600;color:var(--text2);margin-bottom:6px">Group / Muscle</div>
      <input id="newex-group" type="text" placeholder="e.g. Back, Core, Legs…" style="width:100%;padding:10px 14px;background:var(--bg3);border:1px solid var(--border);border-radius:10px;color:var(--text);font-family:inherit;font-size:14px;outline:none;margin-bottom:14px;display:block">
      <div style="font-size:12px;font-weight:600;color:var(--text2);margin-bottom:8px">Tracking Type</div>
      <div style="display:flex;gap:8px;margin-bottom:20px">
        <button class="diff-btn active" id="type-reps-btn" onclick="selectExType('reps')" style="flex:1;padding:14px;font-size:13px">🔢 Reps + kg</button>
        <button class="diff-btn" id="type-time-btn" onclick="selectExType('time')" style="flex:1;padding:14px;font-size:13px">⏱ Seconds</button>
      </div>
      <button onclick="confirmAddLibEx()" style="width:100%;padding:14px;background:var(--green);color:#000;border:none;border-radius:12px;font-family:inherit;font-size:15px;font-weight:700;cursor:pointer">Add to Library</button>
    </div>
  </div>
</div>

<!-- EDIT EXERCISE IN LIBRARY SHEET -->
<div class="soverlay" id="editex-sheet" onclick="if(event.target===this)closeEditLibEx()">
  <div class="sheet">
    <div class="shandle"></div>
    <div class="stitle">Edit Exercise</div>
    <div style="padding:0 16px 20px">
      <div style="font-size:12px;font-weight:600;color:var(--text2);margin-bottom:6px">Exercise Name</div>
      <div id="editex-name-display" style="padding:10px 14px;background:var(--bg3);border:1px solid var(--border);border-radius:10px;color:var(--text3);font-family:inherit;font-size:14px;margin-bottom:4px;word-break:break-word"></div>
      <div style="font-size:11px;color:var(--text3);margin-bottom:14px">Name cannot be changed — it would break session history.</div>
      <div style="font-size:12px;font-weight:600;color:var(--text2);margin-bottom:6px">Group / Muscle</div>
      <input id="editex-group" type="text" placeholder="e.g. Back, Core, Legs…" style="width:100%;padding:10px 14px;background:var(--bg3);border:1px solid var(--border);border-radius:10px;color:var(--text);font-family:inherit;font-size:14px;outline:none;margin-bottom:14px;display:block">
      <div style="font-size:12px;font-weight:600;color:var(--text2);margin-bottom:8px">Tracking Type</div>
      <div style="display:flex;gap:8px;margin-bottom:20px">
        <button class="diff-btn active" id="editex-reps-btn" onclick="selectEditExType('reps')" style="flex:1;padding:14px;font-size:13px">🔢 Reps + kg</button>
        <button class="diff-btn" id="editex-time-btn" onclick="selectEditExType('time')" style="flex:1;padding:14px;font-size:13px">⏱ Seconds</button>
      </div>
      <button onclick="confirmEditLibEx()" style="width:100%;padding:14px;background:var(--green);color:#000;border:none;border-radius:12px;font-family:inherit;font-size:15px;font-weight:700;cursor:pointer">Save Changes</button>
    </div>
  </div>
</div>

<!-- DAY OVERRIDE SHEET -->
<div class="soverlay" id="day-override-sheet" onclick="if(event.target===this)closeDayOverrideSheet()">
  <div class="sheet">
    <div class="shandle"></div>
    <div class="stitle" id="day-override-title">Change planned workout</div>
    <div id="day-override-list"></div>
  </div>
</div>

<!-- WORKOUT FLOATING PILL -->
<button class="wk-pill" id="wk-pill" onclick="resumeWk()">
  <span style="width:7px;height:7px;border-radius:50%;background:#000;flex-shrink:0"></span>
  <span id="wk-pill-timer">0:00</span>
</button>

<!-- WORKOUT OVERLAY -->
<div class="woverlay" id="workout-view">
  <div class="wtop">
    <div><div class="wtitle" id="wk-title">Workout</div><div style="font-size:12px;color:var(--text3);margin-top:2px" id="wk-sub"></div></div>
    <div style="display:flex;align-items:center;gap:10px">
      <button onclick="minimizeWk()" style="background:none;border:none;cursor:pointer;color:var(--text3);font-size:26px;line-height:1;padding:0 2px;font-family:inherit">−</button>
      <div class="wtimer" id="wk-timer">0:00</div>
      <button class="wfinish" onclick="finishWorkout()">Finish</button>
    </div>
  </div>
  <div class="winner" id="workout-inner"></div>
</div>

<!-- EX PICKER SHEET -->
<div class="soverlay" id="ex-sheet" onclick="if(event.target===this)closeSheet()">
  <div class="sheet">
    <div class="shandle"></div>
    <div class="stitle">Add Exercise</div>
    <input class="ssearch" type="text" placeholder="Search or add custom…" oninput="filterSheet(this.value)" id="sheet-search">
    <div id="sheet-list"></div>
  </div>
</div>

<!-- EX PICKER SHEET FOR PROGRAM EDITOR -->
<div class="soverlay" id="prog-sheet" onclick="if(event.target===this)closeProgSheet()">
  <div class="sheet">
    <div class="shandle"></div>
    <div class="stitle" id="prog-sheet-title">Add to Day</div>
    <input class="ssearch" type="text" placeholder="Exercise name…" oninput="filterProgSheet(this.value)" id="prog-sheet-search">
    <div id="prog-sheet-list"></div>
  </div>
</div>

<!-- EDIT SESSION OVERLAY -->
<div class="eoverlay" id="edit-overlay">
  <div class="etop">
    <button class="back" onclick="closeEditSession()"><svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>Cancel</button>
    <div id="edit-title" style="font-size:16px;font-weight:700"></div>
    <button class="esave" onclick="saveEditSession()">Save</button>
  </div>
  <div class="einner" id="edit-inner"></div>
</div>

<!-- SESSION DETAIL -->
<div class="dsheet" id="detail-sheet">
  <div class="dtop">
    <button class="back" onclick="closeDetail()"><svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>Back</button>
    <div id="detail-title" style="font-size:16px;font-weight:700"></div>
    <div style="display:flex;gap:4px">
      <button onclick="repeatSession(currentDetailId)" style="font-size:13px;font-weight:600;color:var(--green);background:none;border:none;cursor:pointer;font-family:inherit;padding:6px 10px">Repeat</button>
      <button id="detail-edit-btn" onclick="openEditSession(currentDetailId)" style="font-size:13px;font-weight:600;color:var(--blue);background:none;border:none;cursor:pointer;font-family:inherit;padding:6px 10px;display:none">Edit</button>
    </div>
  </div>
  <div style="padding:16px;max-width:500px;margin:0 auto" id="detail-inner"></div>
</div>

<!-- PROFILE EDIT MODAL -->
<div class="mbg" id="profile-edit-modal" onclick="if(event.target===this)closeProfileEdit()">
  <div class="mbox">
    <h2>Edit Profile</h2>
    <label>Avatar (emoji)</label>
    <input type="text" id="pe-emoji" placeholder="e.g. 💪 🏋️ 🔥" maxlength="4" style="text-align:center;font-size:24px;padding:8px">
    <label>Name</label>
    <input type="text" id="pe-name" placeholder="Your name">
    <label>Age</label>
    <input type="number" id="pe-age" placeholder="e.g. 33" min="1" max="120">
    <label>Height (cm)</label>
    <input type="number" id="pe-height" placeholder="e.g. 183" min="100" max="250">
    <label>Weight (kg)</label>
    <input type="number" id="pe-weight" placeholder="e.g. 80" min="30" max="300" step="0.5">
    <label>Training Goal</label>
    <select id="pe-goal">
      <option value="Hypertrophy">Hypertrophy</option>
      <option value="Strength">Strength</option>
      <option value="Fat Loss">Fat Loss</option>
      <option value="Recomposition">Recomposition</option>
      <option value="Endurance">Endurance</option>
      <option value="General Fitness">General Fitness</option>
    </select>
    <label>Target Date</label>
    <input type="date" id="pe-target">
    <div class="mbtns">
      <button class="mbtn" onclick="closeProfileEdit()">Cancel</button>
      <button class="mbtn primary" onclick="saveProfileEdit()">Save</button>
    </div>
  </div>
</div>

<!-- BODYWEIGHT LOG MODAL -->
<div class="mbg" id="bw-modal" onclick="if(event.target===this)closeBwLog()">
  <div class="mbox">
    <h2>Log Bodyweight</h2>
    <label>Date</label>
    <input type="date" id="bw-date-input">
    <label>Weight (kg)</label>
    <input type="number" id="bw-input" placeholder="e.g. 82.5" step="0.1" min="30" max="300" inputmode="decimal">
    <div class="mbtns">
      <button class="mbtn" onclick="closeBwLog()">Cancel</button>
      <button class="mbtn primary" onclick="saveBwLog()">Save</button>
    </div>
  </div>
</div>

<!-- SYNC MODAL -->
<div class="mbg" id="sync-modal" onclick="if(event.target===this)closeSyncModal()">
  <div class="mbox">
    <h2>☁️ Sync Code</h2>
    <p>Use this code on any device to share the same data. Tap to copy.</p>
    <div class="cdisplay" id="sync-code-display" onclick="copyCode()">—</div>
    <div class="hint" id="copy-hint">Tap to copy</div>
    <label>Switch to another device's code</label>
    <input type="text" id="switch-input" placeholder="Paste sync code here…">
    <div class="mbtns">
      <button class="mbtn" onclick="closeSyncModal()">Close</button>
      <button class="mbtn primary" onclick="switchCode()">Switch</button>
    </div>
  </div>
</div>

<!-- REST TIMER -->
<div class="rtoast" id="rest-toast">
  <span style="color:var(--text2);font-size:13px">Rest</span>
  <button onclick="adjustRest(-30)" style="background:none;border:none;cursor:pointer;color:var(--text3);font-size:12px;font-weight:700;padding:2px 6px;font-family:inherit">−30</button>
  <span class="rcnt" id="rest-cnt">90</span>
  <button onclick="adjustRest(30)" style="background:none;border:none;cursor:pointer;color:var(--text3);font-size:12px;font-weight:700;padding:2px 6px;font-family:inherit">+30</button>
  <button class="rskip" onclick="skipRest()">Skip</button>
</div>

<!-- PR TOAST -->
<div class="pr-toast" id="pr-toast">
  <span>🏆</span><span id="pr-toast-msg">New PR!</span>
</div>

<!-- PR EDIT SHEET -->
<div class="pr-edit-sheet" id="pr-edit-sheet">
  <div class="pr-edit-bg" onclick="closePrEditSheet()"></div>
  <div class="pr-edit-box">
    <div class="pr-edit-hdr">
      <div style="font-size:16px;font-weight:700">Personalise PRs</div>
      <button onclick="closePrEditSheet()" style="background:none;border:none;cursor:pointer;color:var(--text3);font-size:22px;line-height:1;padding:0 4px">×</button>
    </div>
    <div class="pr-edit-body" id="pr-edit-body"></div>
  </div>
</div>

<!-- ── VIEWS ── -->

<!-- TODAY -->
<div class="view active" id="view-today">
  <div id="today-ribbon" class="t-ribbon-wrap"></div>
  <div class="vi" style="padding-top:14px">
    <div id="today-meta" class="t-meta"></div>
    <div id="today-hero"></div>
    <div id="today-kpis" class="t-kpis"></div>
    <div id="cycle-summary-banner"></div>
    <div id="recent-sessions"></div>
  </div>
</div>

<!-- LOG / CALENDAR -->
<div class="view" id="view-calendar">
  <div class="v4h">
    <div class="v4h-eyebrow">History</div>
    <div class="v4h-title">Log</div>
    <div id="log-session-count" class="v4h-sub" style="font-size:13px;color:var(--text3);margin-top:2px"></div>
  </div>
  <div class="log-tabs">
    <button class="log-tab active" data-tab="timeline" onclick="setLogTab('timeline')">Timeline</button>
    <button class="log-tab" data-tab="month" onclick="setLogTab('month')">Calendar</button>
  </div>
  <div id="log-timeline-view" class="lg-wrap"></div>
  <div id="log-cycle-view" style="display:none"></div>
  <div id="log-month-view" style="display:none"></div>
  <div id="log-list-view" style="display:none"></div>
  <!-- Legacy nodes kept hidden -->
  <div id="cal-streak" style="display:none"></div>
  <div id="cal-timeline" style="display:none"></div>
  <div id="cal-month-label" style="display:none"></div>
  <div id="cal-grid" style="display:none"></div>
  <div id="cal-detail-panel" style="display:none"></div>
</div>

<!-- ADD WORKOUT ON ANY DAY SHEET -->
<div class="add-day-sheet" id="add-day-sheet">
  <div class="add-day-bg" onclick="closeAddDaySheet()"></div>
  <div class="add-day-box">
    <div class="add-day-handle"></div>
    <div id="add-day-inner"></div>
  </div>
</div>

<!-- PROGRESS — dashboard + per-lift drilldown -->
<div class="view" id="view-progress">
  <div class="v4h">
    <div class="v4h-eyebrow">Overview</div>
    <div class="v4h-title">Progress</div>
  </div>
  <div class="vi" style="padding-top:4px">
    <div class="pg-seg" id="pg-seg">
      <button data-t="block" onclick="setProgTab('block')">Block</button>
      <button data-t="lifts" onclick="setProgTab('lifts')">Lifts</button>
      <button data-t="body" onclick="setProgTab('body')">Body</button>
    </div>
    <div id="pg-block"></div>
    <div id="pg-lifts" style="display:none">
      <div id="pg-lift-list"></div>
      <div id="pg-lift-detail" style="display:none"><div id="progress-content"></div></div>
      <div id="kpi-section" style="margin-top:6px">
        <div class="card">
          <div class="ch" style="flex-direction:column;align-items:flex-start;gap:10px">
            <div style="display:flex;justify-content:space-between;align-items:center;width:100%">
              <div class="ct" id="kpi-title">Progress by Week</div>
              <button id="kpi-filter-btn" onclick="toggleKpiFilters()" class="pg-linkbtn">Filters</button>
            </div>
            <div class="kpi-row"><span class="kpi-row-lbl">Show</span><div style="display:flex;gap:6px;flex-wrap:wrap" id="kpi-metric-pills"></div></div>
            <div class="kpi-row"><span class="kpi-row-lbl">Group</span><div style="display:flex;gap:6px;flex-wrap:wrap" id="kpi-group-pills"></div></div>
            <div id="kpi-filters" style="display:none;flex-direction:column;gap:10px;width:100%">
              <div class="kpi-row"><span class="kpi-row-lbl">Program</span><div style="display:flex;gap:6px;flex-wrap:wrap" id="kpi-prog-pills"></div></div>
              <div class="kpi-row"><span class="kpi-row-lbl">Day</span><div style="display:flex;gap:6px;flex-wrap:wrap" id="kpi-day-pills"></div></div>
              <div class="kpi-row"><span class="kpi-row-lbl">Last</span><div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center" id="kpi-limit-pills"></div></div>
            </div>
          </div>
          <div style="padding:4px 16px 16px">
            <div id="kpi-no-data" style="display:none;text-align:center;padding:28px 0;font-size:13px;color:var(--text3)">No data available</div>
            <div style="position:relative;height:160px"><canvas id="kpi-cvs"></canvas></div>
          </div>
        </div>
      </div>
    </div>
    <div id="pg-body" style="display:none">
      <div class="pg-card">
        <div style="display:flex;justify-content:space-between;align-items:center">
          <div class="eyebrow">Bodyweight</div>
          <button onclick="openBwLog()" class="pg-linkbtn">+ Log weight</button>
        </div>
        <div id="bw-latest" style="font-size:13px;color:var(--text2);margin:10px 0 8px"></div>
        <div style="position:relative;height:180px"><canvas id="bw-cvs"></canvas></div>
        <div id="bw-empty" style="display:none;text-align:center;padding:16px 0;font-size:13px;color:var(--text3)">No weight logs yet. Log your weight to track the trend.</div>
      </div>
      <div style="font-size:11px;color:var(--text3);padding:0 4px">Your latest logged weight is also used for bodyweight lifts (pull-ups, dips) when estimating strength.</div>
    </div>
  </div>
</div>

<!-- PROGRAM -->
<div class="view" id="view-program">
  <div class="v4h">
    <div class="v4h-eyebrow" style="display:flex;justify-content:space-between;align-items:center">
      <button onclick="openProgramsOverlay()" style="background:none;border:none;cursor:pointer;color:var(--text3);font-family:var(--fb);font-size:10px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:0;display:flex;align-items:center;gap:4px"><svg viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" fill="none" stroke-width="2.5" stroke-linecap="round"><polyline points="15 18 9 12 15 6"/></svg>Programs</button>
      <button onclick="resetCycleToDefault()" style="font-size:10px;font-weight:700;color:var(--text4);background:none;border:none;cursor:pointer;font-family:var(--fb);letter-spacing:.06em;text-transform:uppercase;padding:0">Reset to default</button>
    </div>
    <div class="v4h-title">Program</div>
    <div id="prog-subtitle" class="v4h-sub" style="font-size:13px;color:var(--text3);margin-top:2px"></div>
  </div>
  <div class="vi" id="program-inner"></div>
</div>

<!-- PROFILE — identity + lifetime stats + settings -->
<div class="view" id="view-profile">
  <div class="v4h" style="display:flex;justify-content:space-between;align-items:flex-end">
    <div style="display:flex;align-items:center;gap:14px">
      <div id="prof-avatar" class="pav" onclick="openProfileEdit()" style="margin:0;cursor:pointer;flex-shrink:0">💪</div>
      <div>
        <div class="v4h-eyebrow">Profile</div>
        <div class="v4h-title" id="prof-name">—</div>
      </div>
    </div>
    <button onclick="openProfileEdit()" style="background:transparent;border:1px solid var(--border);color:var(--text2);padding:6px 10px;border-radius:6px;font-family:var(--fb);font-size:9px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;cursor:pointer">Edit</button>
  </div>
  <div class="v4ident">
    <div class="v4ident-tags" id="prof-tags"></div>
    <div id="prof-target-wrap"></div>
  </div>
  <div id="prof-program" style="margin:0 16px 4px"></div>
  <div id="prof-lifetime"></div>
  <!-- Trophy Cabinet -->
  <div style="display:flex;justify-content:space-between;align-items:center;margin:0 16px 8px;padding-left:4px">
    <div class="eyebrow" style="color:var(--amber)">★ Personal Records</div>
    <button onclick="openPrEditSheet()" style="font-size:9px;font-weight:700;color:var(--accent);background:none;border:none;cursor:pointer;font-family:var(--fb);letter-spacing:.1em;text-transform:uppercase;padding:2px 0">Edit</button>
  </div>
  <div id="pr-trophy" style="display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:0 16px;margin-bottom:16px"></div>
  <div class="eyebrow" style="margin:0 16px 8px;padding-left:4px">Training</div>
  <div class="v4set-list">
    <div class="v4set-row" onclick="openProgramsOverlay()">
      <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 3v9l5 3"/></svg>
      <div class="lbl">Programs</div>
      <div class="val" id="profile-prog-short">Normal</div>
      <div class="arrow">›</div>
    </div>
    <div class="v4set-row" onclick="openLibrary()">
      <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
      <div class="lbl">Exercise library</div>
      <div class="val" id="profile-lib-short">—</div>
      <div class="arrow">›</div>
    </div>
    <div class="v4set-row" onclick="openVacationSheet()">
      <svg viewBox="0 0 24 24"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/></svg>
      <div class="lbl">Holiday Mode</div>
      <div class="val" id="profile-vacation-short">Not set</div>
      <div class="arrow">›</div>
    </div>
  </div>
  <div class="eyebrow" style="margin:16px 16px 8px;padding-left:4px">Data</div>
  <div class="v4set-list">
    <div class="v4set-row" onclick="openSyncModal()">
      <svg viewBox="0 0 24 24"><path d="M3 12a9 9 0 0 1 15-6.7M21 12a9 9 0 0 1-15 6.7M21 4v5h-5M3 20v-5h5"/></svg>
      <div class="lbl">Sync</div>
      <div class="val ok" id="profile-sync-short">—</div>
      <div class="arrow">›</div>
    </div>
    <div class="v4set-row" onclick="checkForUpdate()">
      <svg viewBox="0 0 24 24"><path d="M12 3v12M7 10l5 5 5-5M5 21h14"/></svg>
      <div class="lbl">App version</div>
      <div class="val" id="profile-version">—</div>
      <div class="arrow">↻</div>
    </div>
    <div class="v4set-row" onclick="doExport()">
      <svg viewBox="0 0 24 24"><path d="M12 3v12M7 8l5-5 5 5M5 21h14"/></svg>
      <div class="lbl">Export data</div>
      <div class="val">CSV</div>
      <div class="arrow">›</div>
    </div>
  </div>
  <!-- Legacy mount points (kept hidden so old code doesn't crash) -->
  <div id="prof-sub" style="display:none"></div>
  <div id="prof-target" style="display:none"></div>
  <div id="prof-activity" style="display:none"></div>
  <div id="pr-list" style="display:none"></div>
  <div id="profile-pr-short" style="display:none"></div>
</div>

<!-- VACATION SHEET -->
<div class="add-day-sheet" id="vacation-sheet">
  <div class="add-day-bg" onclick="closeVacationSheet()"></div>
  <div class="add-day-box">
    <div class="add-day-handle"></div>
    <div id="vacation-inner"></div>
  </div>
</div>

<!-- PWA INSTALL BANNER -->
<div class="install-banner" id="install-banner">
  <div class="install-banner-icon">🏋️</div>
  <div class="install-banner-text">
    <div class="install-banner-title">Add 8Day to home screen</div>
    <div class="install-banner-sub" id="install-banner-sub">Train faster, works offline</div>
  </div>
  <button class="install-banner-btn" id="install-banner-btn" onclick="triggerInstall()">Add</button>
  <button class="install-banner-close" onclick="dismissInstallBanner()">×</button>
</div>

<!-- NAV — 5 tabs with elevated center start button -->
<nav class="nav">
  <button class="nb active" id="nav-today" onclick="switchView('today')">
    <svg viewBox="0 0 24 24"><path d="M3 12L12 4l9 8M5 10v10h14V10"/></svg>Today
  </button>
  <button class="nb" id="nav-calendar" onclick="switchView('calendar')">
    <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>Log
  </button>
  <button class="nb go" onclick="startWorkout()" aria-label="Start workout">
    <div class="gc">
      <svg viewBox="0 0 200 200" width="26" height="26" aria-hidden="true">
        <g transform="rotate(-15 100 100)" fill="currentColor">
          <rect x="30" y="62" width="14" height="76" rx="3"/>
          <rect x="156" y="62" width="14" height="76" rx="3"/>
          <rect x="44" y="96" width="112" height="8" rx="1"/>
        </g>
      </svg>
    </div>
  </button>
  <button class="nb" id="nav-progress" onclick="switchView('progress')">
    <svg viewBox="0 0 24 24"><path d="M3 20h18M6 16l4-5 3 3 5-7"/></svg>Progress
  </button>
  <button class="nb" id="nav-profile" onclick="switchView('profile')">
    <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a8 8 0 0 1 16 0v1"/></svg>Profile
  </button>
</nav>

<script>
// ── PLAN (editable via CUSTOM_PLAN override) ──────────────────────────────
const DEFAULT_PLAN = {
  'PUSH (Hypertrophy)': [
    {g:'Chest', ex:['Incline Press (DB)','Bench Press (DB)','High-to-Low Fly (Cable)','Deficit Push-Ups (Bodyweight)']},
    {g:'Shoulders / Triceps', ex:['Lateral Raises (DB)','Triceps Pushdown (Rope)']},
    {g:'Core', ex:['Plank (Bodyweight)']}
  ],
  'LEGS (Strength)': [
    {g:'Legs', ex:['Back Squat (BB)','Romanian Deadlift (BB)','Leg Press (Machine)','Walking Lunges (BB)','Standing Calf Raises (Machine)']},
    {g:'Core', ex:['Hanging Knee Raise (Bodyweight)']}
  ],
  'PULL': [
    {g:'Back', ex:['Pull-Ups (Bodyweight)','Bent Over Row (BB)','Chest-Supported Row (Machine)','Lat Pulldown (Machine)','Face Pulls (Rope)']},
    {g:'Arms', ex:['Bicep Curl (BB)','Hammer Curl (DB)']},
    {g:'Core', ex:['Crunch (Machine)']}
  ],
  'PUSH (Strength)': [
    {g:'Chest', ex:['Incline Press (BB)','Bench Press (BB)','Dips (Bodyweight)']},
    {g:'Shoulders', ex:['Overhead Press (BB)','Lateral Raises (DB)']},
    {g:'Core', ex:['Plank (Bodyweight)']}
  ],
  'LEGS (Hypertrophy)': [
    {g:'Legs', ex:['Hack Squat (Machine)','Bulgarian Split Squat (DB)','Seated Calf Raises (Machine)','Leg Curl (Machine)','Leg Extension (Machine)','Leg Press Burnout (Machine)']},
    {g:'Core', ex:['Hanging Knee Raise (Bodyweight)']}
  ]
};

// Load editable plan from localStorage
let PLAN = JSON.parse(localStorage.getItem('tr-plan-v1') || 'null') || JSON.parse(JSON.stringify(DEFAULT_PLAN));

const CYCLE_PATTERN = ['PUSH (Hypertrophy)','LEGS (Strength)','REST','PULL','REST','PUSH (Strength)','LEGS (Hypertrophy)','REST'];
const DAY_NAMES     = ['D2','D3','D4','D5','D6','D7','D8','D1'];

const DAY_FULL_NAMES = {
  'PUSH (Hypertrophy)':'Push — Hypertrophy',
  'LEGS (Strength)':'Legs — Strength',
  'PULL':'Pull',
  'PUSH (Strength)':'Push — Strength',
  'LEGS (Hypertrophy)':'Legs — Hypertrophy',
  'REST':'Rest Day',
  'WORKOUT A':'Strength Day',
  'WORKOUT B':'Shape Day',
  'WORKOUT C':'Workout C',
  'FULL BODY':'Full Body',
  'UPPER BODY':'Upper Body',
  'LOWER BODY':'Lower Body',
  'CARDIO':'Cardio'
};

