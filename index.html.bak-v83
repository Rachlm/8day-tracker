}

function closeEditLibEx(){document.getElementById('editex-sheet').classList.remove('open');}

function selectEditExType(type) {
  _editLibExType=type;
  document.getElementById('editex-reps-btn').classList.toggle('active',type==='reps');
  document.getElementById('editex-time-btn').classList.toggle('active',type==='time');
}

function confirmEditLibEx() {
  const ex=EX_LIBRARY.find(e=>e.name===_editLibExName);if(!ex)return;
  ex.group=document.getElementById('editex-group').value.trim()||ex.group||'Custom';
  ex.type=_editLibExType;
  saveLibrary();closeEditLibEx();renderLibrary();
}

// ── WORKOUT FEEDBACK ───────────────────────────────────────────────────────
function openFeedback() {
  selectedDifficulty='Moderate';
  document.querySelectorAll('.diff-btn').forEach(b=>b.classList.toggle('active',b.textContent.trim()==='Moderate'));
  document.getElementById('fb-comment').value='';
  document.getElementById('feedback-modal').classList.add('open');
}

function selectDiff(el, diff) {
  selectedDifficulty=diff;
  document.querySelectorAll('#diff-row .diff-btn').forEach(b=>b.classList.remove('active'));
  el.classList.add('active');
}

function saveFeedback() {
  if(!pendingSession)return;
  const comment=document.getElementById('fb-comment').value.trim();
  pendingSession.feedback={difficulty:selectedDifficulty,comment};
  saveSession(pendingSession);
  checkCycleComplete(pendingSession);
  pendingSession=null;
  document.getElementById('feedback-modal').classList.remove('open');
  switchView('today');
}

function skipFeedback() {
  if(pendingSession){
    checkCycleComplete(pendingSession);
    saveSession(pendingSession);
    pendingSession=null;
  }
  document.getElementById('feedback-modal').classList.remove('open');
  switchView('today');
}

function refreshActiveView() {
  const id=document.querySelector('.view.active')?.id;
  if(id==='view-today')renderToday();
  else if(id==='view-calendar')renderCalendar();
  else if(id==='view-progress')renderProgress();
  else if(id==='view-profile')renderProfile();
}

// ── NAV ────────────────────────────────────────────────────────────────────
function switchView(name) {
  document.querySelectorAll('.view').forEach(v=>v.classList.remove('active'));
  document.querySelectorAll('.nb[id]').forEach(b=>b.classList.remove('active'));
  document.getElementById('view-'+name).classList.add('active');
  document.getElementById('nav-'+name)?.classList.add('active');
  if(name==='today')renderToday();
  else if(name==='calendar')renderCalendar();
  else if(name==='progress')renderProgress();
  else if(name==='program')renderProgram();
  else if(name==='profile')renderProfile();
}

// ── TODAY (v4 Mission Control) ─────────────────────────────────────────────
function v4TypeClass(dt){
  if(!dt||dt==='REST')return 'rest';
  if(dt.startsWith('PUSH'))return 'push';
  if(dt.startsWith('LEGS'))return 'legs';
  if(dt.startsWith('PULL'))return 'pull';
  return 'rest';
}
function v4TypeColor(dt){
  const c=v4TypeClass(dt);
  if(c==='rest'&&dt&&dt!=='REST'&&TYPE_COLOR[dt]) return TYPE_COLOR[dt];
  return ({push:'var(--push)',legs:'var(--legs)',pull:'var(--pull)',rest:'var(--rest)'})[c];
}

function renderToday() {
  const today=todayStr(), info=getCycleInfo(today), sessions=all();
  const cycle=cycleFor(today);

  // ── Ribbon — sticky stats strip ──
  const ribbonEl=document.getElementById('today-ribbon');

  // ── Meta row (date + sync) ──
  const dt=new Date();
  const dateLong=dt.toLocaleDateString('en-GB',{weekday:'short',day:'numeric',month:'short'}).toUpperCase();
  const metaEl=document.getElementById('today-meta');
  metaEl.innerHTML=`
    <div class="v4h" style="padding:8px 4px 12px">
      <div class="v4h-eyebrow">${dateLong} · W${isoWeek(today)}${info.isPre||!info.cycleLabel?'':' · '+info.cycleLabel}</div>
      <div class="v4h-title" style="display:flex;justify-content:space-between;align-items:baseline">
        <span>Today</span>
        <span class="v4sync syncing" onclick="openSyncModal()" id="sync-pill"><span class="v4sync-dot" id="sync-dot"></span><span id="sync-label">Connecting…</span></span>
      </div>
    </div>`;

  // ── Hero card ──
  const heroEl=document.getElementById('today-hero');
  const logged=sessions.find(s=>s.date===today);
  const cycleLen=cycle.length;

  if(info.isPre){
    heroEl.innerHTML=`<div class="v4hero">
      <div class="v4hero-top">
        <div>
          <div class="v4hero-eyebrow" style="color:var(--text3)"><span class="dot" style="background:var(--text3)"></span> PREP PERIOD</div>
          <div class="v4hero-day">PREP</div>
        </div>
      </div>
      <div class="v4hero-info">Cycle 1 hasn't started yet — log a session whenever you're ready.</div>
      <div class="v4hero-cta"><button class="v4btn ghost" onclick="startWorkout()">+ Log custom session</button></div>
    </div>`;
  } else if(info.isVacation){
    heroEl.innerHTML=`<div class="v4hero">
      <div class="v4hero-top">
        <div>
          <div class="v4hero-eyebrow" style="color:var(--amber)"><span class="dot" style="background:var(--amber)"></span> HOLIDAY MODE</div>
          <div class="v4hero-day" style="color:var(--text2)">${(VACATION?.name||'').toUpperCase()}</div>
        </div>
        <div class="v4hero-meta">
          <div class="v4hero-cyc">🏖️</div>
          <div class="v4hero-prog">${info.daysLeft>0?info.daysLeft+'d left':'ends today'}</div>
        </div>
      </div>
      <div class="v4hero-info">Cycle paused · resumes ${info.daysLeft>0?'in '+info.daysLeft+' day'+(info.daysLeft!==1?'s':''):'tomorrow'}.</div>
      <div class="v4hero-cta">
        <button class="v4btn ghost" onclick="showLogDay('${today}')">+ Log a workout</button>
        <button class="v4btn ghost" style="margin-top:8px;font-size:10px;color:var(--text3)" onclick="clearVacation()">End holiday early</button>
      </div>
    </div>`;
  } else if(info.dayType==='REST'){
    // Find next training day
    let nextInfo=null,nextDateStr=null;
    for(let i=1;i<=cycleLen;i++){
      const d=new Date(today+'T00:00:00');d.setDate(d.getDate()+i);
      const ds=`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
      const ni=getCycleInfo(ds);
      if(ni.dayType&&ni.dayType!=='REST'){nextInfo=ni;nextDateStr=ds;break;}
    }
    const daysAway=nextDateStr?Math.round((new Date(nextDateStr+'T00:00:00')-new Date(today+'T00:00:00'))/86400000):0;
    heroEl.innerHTML=`<div class="v4hero">
      <div class="v4hero-top">
        <div>
          <div class="v4hero-eyebrow" style="color:var(--text3)"><span class="dot" style="background:var(--text3)"></span> REST DAY</div>
          <div class="v4hero-day" style="color:var(--text2)">REST</div>
        </div>
        <div class="v4hero-meta">
          <div class="v4hero-cyc">${info.cycleLabel}</div>
          <div class="v4hero-prog">${info.dayName}</div>
        </div>
      </div>
      <div class="v4hero-info">${nextInfo?`Next: ${dayTitle(nextInfo.dayType)} ${daysAway===1?'tomorrow':`in ${daysAway} days`}`:'Take it easy.'}</div>
      <div class="v4hero-cta">
        <button class="v4btn ghost" onclick="startWorkout()">+ Log custom session</button>
        <button class="v4btn ghost" style="margin-top:8px;font-size:10px;color:var(--text3)" onclick="openDayOverrideSheet('${today}')">Change today's plan</button>
      </div>
    </div>`;
  } else {
    // Training day
    const tc=v4TypeClass(info.dayType);
    const tcol=v4TypeColor(info.dayType);
    const exList=getActivePlanEx(info.dayType,today).flatMap(g=>g.ex);
    const previewLimit=4;
    const exRows=exList.slice(0,previewLimit).map(e=>{
      const prev=getPrevPerf(e,today);
      const bw=isBW(e),tb=isTimeBased(e);
      let targetHtml=`<span style="color:var(--text4)">—</span>`;
      const _cp=_getActiveCustomProgram(today);
      const _pr=_cp?progressionFor(e,_cp.prog,info.dayType):null;
      if(_pr){
        const wt=x=>_pr.kind==='bw'?(x>0?'+'+x+'kg':'BW'):x+'kg';
        const dl=_inDeload(_cp.prog,today);
        targetHtml=_pr.ready&&!dl
          ?`<div style="font-size:13px;font-weight:700;color:var(--green)">↑ ${wt(_pr.next)}</div><div style="font-size:9px;color:var(--text3);margin-top:1px;font-family:var(--fm)">all sets hit ${_pr.meta.maxReps}</div>`
          :`<div style="font-size:13px;font-weight:700">${wt(_pr.w)}</div><div style="font-size:9px;color:var(--text3);margin-top:1px;font-family:var(--fm)">${dl?'deload · 2 sets':`aim ${_pr.meta.maxReps} reps`}</div>`;
      } else if(prev){
        if(!bw&&!tb&&prev.w>0){
          const hist=getExHistory(e);
          const bestW=hist.length?Math.max(...hist.map(h=>h.w)):0;
          const next=prev.w>=bestW&&bestW>0?+(prev.w+2.5).toFixed(1):bestW;
          const prevTxt=`${prev.r}×${prev.w}`;
          targetHtml=next>0
            ?`<div style="font-size:13px;font-weight:700;color:var(--green)">→ ${next}kg</div><div style="font-size:9px;color:var(--text3);margin-top:1px;font-family:var(--fm)">last ${prevTxt}</div>`
            :`<span>${prevTxt}</span>`;
        } else if(tb){
          targetHtml=`<span>${prev.r}s</span>`;
        } else {
          targetHtml=`<span>${prev.r}r</span>`;
        }
      }
      const shortName=e.replace(/\s*\([^)]+\)/,'');
      const sub=e.match(/\(([^)]+)\)/)?.[1]||'';
      return `<div class="v4hero-row">
        <div>
          <div class="v4hero-row-n">${shortName}</div>
          ${sub?`<div class="v4hero-row-s">${sub}</div>`:''}
        </div>
        <div class="v4hero-row-r" style="text-align:right">${targetHtml}</div>
      </div>`;
    }).join('');
    const more=exList.length>previewLimit?`<div class="v4hero-more">+${exList.length-previewLimit} MORE</div>`:'';
    const cat=(dayCategory(info.dayType)||'').toUpperCase();
    const cyclePos=cycle.findIndex(c=>c.idx===info.dayName);
    heroEl.innerHTML=`<div class="v4hero">
      <div class="v4hero-top">
        <div>
          <div class="v4hero-eyebrow" style="color:${tcol}"><span class="dot" style="background:${tcol}"></span> ${cat}</div>
          <div class="v4hero-day">${dayTitle(info.dayType).toUpperCase()}</div>
        </div>
        <div class="v4hero-meta">
          <div class="v4hero-cyc">${info.cycleLabel}</div>
          <div class="v4hero-prog">${cyclePos+1} of ${cycleLen}</div>
        </div>
      </div>
      <div class="v4hero-info">${exList.length} exercises · ${info.dayName}</div>
      ${exRows?`<div class="v4hero-list">${exRows}${more}</div>`:''}
      <div class="v4hero-cta">${logged
        ?`<div class="v4btn done-state"><svg viewBox="0 0 24 24" width="14" height="14" style="vertical-align:-2px;margin-right:6px" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg> SESSION LOGGED</div>`
        :`<button class="v4btn primary" onclick="startWorkout()">▸ START ${dayTitle(info.dayType).toUpperCase()}</button>
         <button class="v4btn ghost" style="margin-top:8px;font-size:10px;color:var(--text3)" onclick="openDayOverrideSheet('${today}')">Change today's plan</button>`
      }</div>
    </div>`;
  }

  // Phase banner (deload / test week)
  const _ph=!info.isVacation?phaseOn(today):null;
  if(_ph) heroEl.insertAdjacentHTML('afterbegin',phaseBannerHtml(_ph,'margin-bottom:10px'));
  // Fatigue warning on Today too (dismissible)
  const _fat=fatigueAlert();
  if(_fat) heroEl.insertAdjacentHTML('afterbegin',`<div class="pg-banner warn-b" style="position:relative;padding-right:34px;margin-bottom:10px">⚠️ <strong>Deload suggested.</strong> ${_fat}${_xBtn('fatigue','1')}</div>`);

  // ── Cycle progress strip (just under hero) ──
  const kpisEl=document.getElementById('today-kpis');
  let cycHtml='';
  if(!info.isPre){
    const cyclePos=cycle.findIndex(c=>c.idx===info.dayName);
    const startD=new Date(today+'T00:00:00');
    startD.setDate(startD.getDate()-(cyclePos>=0?cyclePos:0));
    let bars='',labels='';
    let doneCount=0,workingCount=0;
    for(let i=0;i<cycleLen;i++){
      const d=new Date(startD); d.setDate(startD.getDate()+i);
      const ds=`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
      const di=getCycleInfo(ds);
      const isToday=ds===today;
      const isRest=di.dayType==='REST';
      const sessOnDay=sessions.find(s=>s.date===ds);
      if(!isRest)workingCount++;
      if(sessOnDay&&!isRest)doneCount++;
      const cls=isToday?'now':(sessOnDay&&!isRest?'done':(isRest?'rest':''));
      bars+=`<div class="v4cyc-bar ${cls}"></div>`;
      labels+=`<div class="v4cyc-lbl ${isToday?'now':''}">${di.dayName||('D'+(i+1))}</div>`;
    }
    cycHtml=`<div class="v4cyc" style="margin:0 0 0">
      <div class="v4cyc-hd">
        <div class="eyebrow">${info.cycleLabel} · ${info.dayName} / ${cycle[cycleLen-1]?.idx||'D'+cycleLen}</div>
        <div class="eyebrow" style="color:var(--text2)">${doneCount}/${workingCount} DONE</div>
      </div>
      <div class="v4cyc-bars">${bars}</div>
      <div class="v4cyc-lbls">${labels}</div>
    </div>`;
  }

  // ── Ribbon — single row: cycle strip + 3 stats ──
  const ws=new Date();ws.setDate(ws.getDate()-((ws.getDay()+6)%7));
  const wsStr=`${ws.getFullYear()}-${String(ws.getMonth()+1).padStart(2,'0')}-${String(ws.getDate()).padStart(2,'0')}`;
  const wkCount=sessions.filter(s=>s.date>=wsStr).length;
  const daysToGoal=PROFILE.target?Math.max(0,Math.round((new Date(PROFILE.target+'T00:00:00')-new Date(today+'T00:00:00'))/86400000)):null;
  const goalVal=daysToGoal!==null?`${daysToGoal}<sub style="font-size:10px;color:var(--text3);font-weight:600;margin-left:1px">d</sub>`:'—';
  const goalSub=daysToGoal!==null?'days left':'no target';
  const statCell=(label,val,sub,accent=false)=>
    `<div class="v4stat" style="padding:10px 6px;min-width:0">
      <div class="v4stat-l" style="font-size:8px">${label}</div>
      <div class="v4stat-v" style="font-size:20px${accent?';color:var(--accent)':''}">${val}</div>
      <div class="v4stat-s" style="font-size:9px">${sub}</div>
    </div>`;
  ribbonEl.innerHTML=`<div style="display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;gap:8px;max-width:500px;margin:0 auto;align-items:stretch">
    ${cycHtml||'<div></div>'}
    ${statCell('SESSIONS',sessions.length,'all-time')}
    ${statCell('THIS WK',wkCount,'sessions')}
    ${statCell('TO GOAL',goalVal,goalSub,true)}
  </div>`;
  kpisEl.innerHTML='';
  kpisEl.classList.remove('four');

  // ── Cycle summary banner ──
  const sumBanner=document.getElementById('cycle-summary-banner');
  if(PENDING_CYCLE_SUMMARY){
    const ps=PENDING_CYCLE_SUMMARY;
    const prHtml=ps.prs.length?`<div style="margin-top:8px;font-family:var(--fm);font-size:11px;color:var(--amber)">★ PRs: ${ps.prs.join(', ')}</div>`:'';
    sumBanner.innerHTML=`<div class="v4-cycsum">
      <button class="v4-cycsum-x" onclick="dismissCycleSummary()">×</button>
      <div class="v4-cycsum-eyebrow">✓ ${ps.label} COMPLETE</div>
      <div class="v4-cycsum-grid">
        <div class="v4-cycsum-cell"><div class="v4-cycsum-val">${ps.sessions}</div><div class="v4-cycsum-lbl">Sessions</div></div>
        <div class="v4-cycsum-cell"><div class="v4-cycsum-val">${Math.round(ps.totalVol/1000)}<sub style="font-size:.5em;color:var(--text3);font-weight:600;margin-left:2px">t</sub></div><div class="v4-cycsum-lbl">Volume</div></div>
        <div class="v4-cycsum-cell"><div class="v4-cycsum-val" style="color:${ps.avgDiff>=4?'var(--red)':ps.avgDiff>=3?'var(--amber)':'var(--green)'}">${ps.avgDiff.toFixed(1)}</div><div class="v4-cycsum-lbl">Fatigue</div></div>
      </div>
      ${prHtml}
    </div>`;
  } else {
    sumBanner.innerHTML='';
  }

  // ── Recent (kept, restyled with new tokens) ──
  const recent=[...sessions].reverse().slice(0,3);
  const recEl=document.getElementById('recent-sessions');
  if(!recent.length){recEl.innerHTML='';return;}
  recEl.innerHTML=`<div class="eyebrow" style="padding:0 4px 8px">Recent</div>`+recent.map(s=>{
    const tc=v4TypeClass(s.dayType);
    const ex=s.exercises.map(e=>e.name.split(' (')[0]).slice(0,3);
    const fb=s.feedback;
    const hasPR=sessionHasPR(s);
    const durMin=s.duration?Math.round(s.duration/60):null;
    return `<div class="si" onclick="showDetail('${s.id}')" style="background:var(--bg2);border:1px solid var(--border);border-radius:12px;padding:14px 16px;margin-bottom:8px;cursor:pointer">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px">
        <div style="min-width:0;flex:1">
          <div style="display:flex;align-items:center;gap:6px;margin-bottom:6px;flex-wrap:wrap">
            <span class="v4pill ${tc}">${dayFullLabel(s.dayType)}</span>
            ${hasPR?`<span class="v4pill amber">★ PR</span>`:''}
            ${fb?.difficulty?`<span class="eyebrow" style="color:var(--text3)">${fb.difficulty.toUpperCase()}</span>`:''}
          </div>
          <div style="font-size:14px;font-weight:600;color:var(--text)">${s.label}</div>
          <div class="tnum" style="font-size:11px;color:var(--text3);margin-top:4px">${s.exercises.length} ex · ${s.exercises.reduce((a,e)=>a+e.sets.length,0)} sets${durMin?` · ${durMin}m`:''}</div>
        </div>
        <div class="tnum" style="font-size:11px;color:var(--text3);white-space:nowrap;flex-shrink:0">${s.date}</div>
      </div>
    </div>`;
  }).join('');
}

// Helpers for hero card titles
function dayTitle(dt){
  if(!dt||dt==='REST')return 'Rest';
  if(DAY_DISPLAY[dt])return DAY_DISPLAY[dt].title;
  const m=dt.match(/^([A-Z]+)/);
  return m?m[1].charAt(0)+m[1].slice(1).toLowerCase():dt;
}
function dayCategory(dt){
  if(!dt)return '';
  if(DAY_DISPLAY[dt])return DAY_DISPLAY[dt].cat;
  const m=dt.match(/\(([^)]+)\)/);
  return m?m[1]:dt.split(' ')[0];
}
function dayFullLabel(dt){
  if(!dt||dt==='REST')return 'REST';
  if(DAY_DISPLAY[dt])return DAY_DISPLAY[dt].title.toUpperCase();
  const m=dt.match(/^([A-Z]+)\s*(?:\(([^)]+)\))?/);
  if(!m)return dt;
  return m[2]?`${m[1]} · ${m[2].toUpperCase()}`:m[1];
}

// ── KPI CHART ─────────────────────────────────────────────────────────────
const KPI_DAYS = [
  {key:'D2', short:'D2', full:'D2 · Push H'},
  {key:'D3', short:'D3', full:'D3 · Legs S'},
  {key:'D5', short:'D5', full:'D5 · Pull'},
  {key:'D7', short:'D7', full:'D7 · Push S'},
  {key:'D8', short:'D8', full:'D8 · Legs H'},
];
const KPI_METRICS = [
  {key:'volume',    label:'Volume'},
  {key:'maxweight', label:'Top kg'},
  {key:'totalreps', label:'Reps'},
  {key:'fatigue',   label:'Fatigue'},
];

function getKpiValue(sess, metric) {
  switch(metric) {
    case 'volume':
      return calcVolume(sess);
    case 'maxweight': {
      const weights = sess.exercises.flatMap(ex => ex.sets.map(s => s.w || 0)).filter(w => w > 0);
      return weights.length ? Math.max(...weights) : 0;
    }
    case 'totalreps':
      return sess.exercises.reduce((a, ex) => a + ex.sets.reduce((b, s) => b + (s.r || 0), 0), 0);
    case 'fatigue': {
      const map = {'Very Easy':1,'Easy':2,'Moderate':3,'Difficult':4,'Very Difficult':5};
      return map[sess.feedback?.difficulty] || 0;
    }
    default: return 0;
  }
}

// Chart view settings (remembered per device)
let kpiGroup = 'cycle', kpiLimit = 10, kpiProg = 'CURRENT';
try {
  const kv = JSON.parse(localStorage.getItem('tr-kpi-view-v1') || 'null');
  if (kv) {
    if (kv.group) kpiGroup = kv.group;
    if (kv.limit !== undefined) kpiLimit = kv.limit;
    if (kv.day) kpiDay = kv.day;
    if (kv.metric) kpiMetric = kv.metric;
    if (kv.prog) kpiProg = kv.prog;
  }
} catch (e) {}
const KPI_GROUPS = [
  {key:'day',   label:'Day'},
  {key:'week',  label:'Week'},
  {key:'month', label:'Month'},
  {key:'cycle', label:'Cycle'},
];
const KPI_LIMITS = [5, 10, 20, 0]; // 0 = all
const KPI_NORMAL_COLOR = '#22c55e';
function _saveKpiView() {
  try { localStorage.setItem('tr-kpi-view-v1', JSON.stringify({group:kpiGroup, limit:kpiLimit, day:kpiDay, metric:kpiMetric, prog:kpiProg})); } catch (e) {}
}
function setKpi(field, val) {
  if (field === 'group') kpiGroup = val;
  else if (field === 'limit') kpiLimit = Math.max(0, parseInt(val, 10) || 0);
  else if (field === 'day') kpiDay = val;
  else if (field === 'metric') kpiMetric = val;
  else if (field === 'prog') { kpiProg = val; kpiDay = 'ALL'; }
  _saveKpiView();
  renderKpiChart();
}
function _kpiLabelParts(s) {
  const parts = (s.label || '').split('·').map(p => p.trim());
  return { cyc: parts.find(p => /^[CW]\d+$/i.test(p)) || null, day: parts.find(p => /^D\d+$/i.test(p)) || null };
}
// Which program a session belongs to: label prefix first, then the schedule on that date
function _kpiSessProg(s) {
  const parts = (s.label || '').split('·').map(p => p.trim());
  if (parts.length >= 3 && /^[CW]\d+$/i.test(parts[1])) {
    const p = PROGRAMS.find(pr => (pr.name || '').slice(0,4).toUpperCase() === parts[0]);
    if (p) return p.id;
  }
  if (/^C\d+$/i.test(parts[0] || '')) return 'normal';
  const e = _getActiveProgramEntry(s.date);
  if (e && e.programId !== 'normal' && PROGRAMS.some(p => p.id === e.programId)) return e.programId;
  return 'normal';
}
function _kpiProgInfo(id) {
  if (id === 'normal') return { id, name: 'Normal 8-day', short: 'NORM', color: KPI_NORMAL_COLOR };
  const p = PROGRAMS.find(pr => pr.id === id);
  return { id, name: p?.name || 'Program', short: (p?.name || 'PROG').slice(0,4).toUpperCase(), color: _kpiColor(p?.color) };
}
function _kpiCurrentProg() {
  const e = _getActiveProgramEntry(todayStr());
  return (e && e.programId !== 'normal' && PROGRAMS.some(p => p.id === e.programId)) ? e.programId : 'normal';
}
function _kpiColor(c) {
  if (!c) return '#d4ff3a';
  if (c.startsWith('var(')) {
    const v = getComputedStyle(document.documentElement).getPropertyValue(c.slice(4, -1).trim()).trim();
    return v || '#d4ff3a';
  }
  return c;
}
function _kpiAlpha(c, a) {
  let m = c.match(/^#([0-9a-f]{3}|[0-9a-f]{6})$/i);
  if (m) {
    let h = m[1]; if (h.length === 3) h = h.split('').map(x => x + x).join('');
    return `rgba(${parseInt(h.slice(0,2),16)},${parseInt(h.slice(2,4),16)},${parseInt(h.slice(4,6),16)},${a})`;
  }
  m = c.match(/^rgba?\(([^)]+)\)/i);
  if (m) { const p = m[1].split(',').slice(0,3).join(','); return `rgba(${p},${a})`; }
  return c;
}
function _kpiDayShort(dt) {
  if (DAY_DISPLAY[dt]) return DAY_DISPLAY[dt].title;
  const m = (dt || '').match(/^([A-Za-z ]+?)\s*\(([^)]+)\)/);
  const cap = w => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase();
  if (m) return cap(m[1].trim()) + ' ' + m[2].trim().charAt(0).toUpperCase();
  return (dt || '').split(/\s+/).map(cap).join(' ').slice(0, 12);
}
const _MON = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
function _kpiBucket(s, prefixProg) {
  const d = new Date(s.date + 'T00:00:00');
  if (kpiGroup === 'day') {
    return { key: s.date, label: `${d.getDate()} ${_MON[d.getMonth()]}` };
  }
  if (kpiGroup === 'week') {
    // ISO week (Monday start)
    const t = new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));
    const dn = t.getUTCDay() || 7;
    t.setUTCDate(t.getUTCDate() + 4 - dn);
    const y = t.getUTCFullYear();
    const wk = Math.ceil(((t - Date.UTC(y, 0, 1)) / 86400000 + 1) / 7);
    return { key: `${y}-W${String(wk).padStart(2,'0')}`, label: `W${wk}${y !== new Date().getFullYear() ? " '" + String(y).slice(2) : ''}` };
  }
  if (kpiGroup === 'month') {
    return { key: s.date.slice(0, 7), label: `${_MON[d.getMonth()]} '${String(d.getFullYear()).slice(2)}` };
  }
  // cycle — always keyed per program so cycles of different programs never merge
  const pid = s._prog;
  const c = (pid !== 'normal' ? String(_kpiLabelParts(s).cyc || s.cycle || '?').replace(/^W/i, 'C') : (_kpiLabelParts(s).cyc || s.cycle || '?'));
  const pre = prefixProg && pid !== 'normal' ? _kpiProgInfo(pid).short + ' ' : '';
  return { key: pid + '|' + c, label: pre + c };
}

function renderKpiChart() {
  const dayPills = document.getElementById('kpi-day-pills');
  const metricPills = document.getElementById('kpi-metric-pills');
  const groupPills = document.getElementById('kpi-group-pills');
  const limitPills = document.getElementById('kpi-limit-pills');
  const progPills = document.getElementById('kpi-prog-pills');
  if (!dayPills) return;

  // All training sessions tagged with their program
  const allSess = all().filter(s => s.dayType !== 'REST').map(s => ({ ...s, _prog: _kpiSessProg(s) }));
  const curProg = _kpiCurrentProg();
  const progsWithData = [...new Set(allSess.map(s => s._prog))];

  // ── Program pills
  if (kpiProg !== 'CURRENT' && kpiProg !== 'ALL' && kpiProg !== 'normal' && !PROGRAMS.some(p => p.id === kpiProg)) kpiProg = 'CURRENT';
  const selProg = kpiProg === 'CURRENT' ? curProg : kpiProg;
  if (progPills) {
    const opts = [{ key: 'CURRENT', label: 'Current · ' + _kpiProgInfo(curProg).name }];
    const others = ['normal', ...PROGRAMS.map(p => p.id)].filter(id => id !== curProg && (progsWithData.includes(id) || id === 'normal'));
    others.forEach(id => opts.push({ key: id, label: _kpiProgInfo(id).name }));
    opts.push({ key: 'ALL', label: 'All' });
    progPills.innerHTML = opts.map(o => {
      const col = o.key === 'ALL' ? null : _kpiProgInfo(o.key === 'CURRENT' ? curProg : o.key).color;
      return `<div class="kpi-pill ${kpiProg === o.key ? 'active' : ''}" onclick="setKpi('prog','${o.key}')">${col ? `<span style="display:inline-block;width:7px;height:7px;border-radius:50%;background:${col};margin-right:5px;vertical-align:middle"></span>` : ''}${o.label}</div>`;
    }).join('');
  }

  // Sessions of the selected program
  const progSess = selProg === 'ALL' ? allSess : allSess.filter(s => s._prog === selProg);

  // ── Day pills built from the program's own workout types
  let dayTypes = [];
  if (selProg === 'normal') dayTypes = activeCycle().map(c => c.dayType);
  else if (selProg !== 'ALL') dayTypes = (PROGRAMS.find(p => p.id === selProg)?.cyclePattern) || [];
  dayTypes = [...new Set([...dayTypes, ...progSess.map(s => s.dayType)])].filter(dt => dt && dt !== 'REST');
  if (selProg === 'ALL') dayTypes.sort();
  const dayOpts = [{key:'ALL', short:'All'}, ...dayTypes.map(dt => ({ key: dt, short: _kpiDayShort(dt) }))];
  if (!dayOpts.some(d => d.key === kpiDay)) kpiDay = 'ALL';
  dayPills.innerHTML = dayOpts.map(d =>
    `<div class="kpi-pill ${kpiDay === d.key ? 'active' : ''}" onclick="setKpi('day','${d.key.replace(/'/g, "\\'")}')" title="${d.key.replace(/"/g, '&quot;')}">${d.short}</div>`
  ).join('');
  metricPills.innerHTML = KPI_METRICS.map(m =>
    `<div class="kpi-pill ${kpiMetric === m.key ? 'active' : ''}" onclick="setKpi('metric','${m.key}')">${m.label}</div>`
  ).join('');
  if (groupPills) groupPills.innerHTML = KPI_GROUPS.map(g =>
    `<div class="kpi-pill ${kpiGroup === g.key ? 'active' : ''}" onclick="setKpi('group','${g.key}')">${g.label}</div>`
  ).join('');
  if (limitPills) {
    const isPreset = KPI_LIMITS.includes(kpiLimit);
    limitPills.innerHTML = KPI_LIMITS.map(n =>
      `<div class="kpi-pill ${kpiLimit === n ? 'active' : ''}" onclick="setKpi('limit',${n})">${n ? 'Last ' + n : 'All'}</div>`
    ).join('') + `<input class="kpi-num" type="number" inputmode="numeric" min="1" placeholder="#" value="${!isPreset ? kpiLimit : ''}" onchange="if(+this.value>0)setKpi('limit',this.value)" title="Custom number"${!isPreset ? ' style="border-color:var(--accent)"' : ''}>`;
  }
  const groupName = (KPI_GROUPS.find(g => g.key === kpiGroup) || {}).label || 'Cycle';
  const titleEl = document.getElementById('kpi-title');
  if (titleEl) titleEl.textContent = `Progress by ${groupName}`;

  // Fatigue alert — last 3 workouts across all days with difficulty ≥ 4
  const allSorted = all().filter(s => s.feedback?.difficulty);
  const last3 = allSorted.slice(-3);
  const fatigueMap = {'Very Easy':1,'Easy':2,'Moderate':3,'Difficult':4,'Very Difficult':5};
  const highFatigue = last3.length === 3 && last3.every(s => (fatigueMap[s.feedback.difficulty] || 0) >= 4);
  const alertEl = document.getElementById('fatigue-alert');
  if (alertEl) alertEl.style.display = highFatigue ? '' : 'none';

  // Filter by workout type
  const sessions = progSess
    .filter(s => kpiDay === 'ALL' || s.dayType === kpiDay)
    .sort((a, b) => a.date.localeCompare(b.date));

  // Bucket by group
  const bucketMap = new Map();
  sessions.forEach(s => {
    const b = _kpiBucket(s, selProg === 'ALL');
    if (!bucketMap.has(b.key)) bucketMap.set(b.key, { label: b.label, first: s.date, items: [] });
    bucketMap.get(b.key).items.push(s);
  });
  let buckets = [...bucketMap.values()].sort((a, b) => a.first.localeCompare(b.first));
  if (kpiLimit > 0) buckets = buckets.slice(-kpiLimit);

  const noData = document.getElementById('kpi-no-data');
  const cvs = document.getElementById('kpi-cvs');
  if (!cvs) return;

  if (buckets.length === 0) {
    cvs.style.display = 'none';
    if (noData) noData.style.display = '';
    if (kpiChart) { kpiChart.destroy(); kpiChart = null; }
    return;
  }

  cvs.style.display = '';
  if (noData) noData.style.display = 'none';

  const aggregate = items => {
    const v = items.map(s => getKpiValue(s, kpiMetric));
    if (kpiMetric === 'fatigue') {
      const nz = v.filter(x => x > 0);
      return nz.length ? +(nz.reduce((a, b) => a + b, 0) / nz.length).toFixed(1) : null;
    }
    if (kpiMetric === 'maxweight') return Math.round(Math.max(0, ...v));
    return Math.round(v.reduce((a, b) => a + b, 0));
  };
  const labels = buckets.map(b => b.label);
  const vals   = buckets.map(b => aggregate(b.items));
  const counts = buckets.map(b => b.items.length);
  const unit   = kpiMetric === 'totalreps' ? ' reps' : kpiMetric === 'fatigue' ? '' : ' kg';
  // Program of each bar = program of its latest session
  const barProg = buckets.map(b => b.items[b.items.length - 1]._prog);
  const mixed   = buckets.map(b => new Set(b.items.map(s => s._prog)).size > 1);
  const barCol  = barProg.map(id => kpiMetric === 'fatigue' && selProg !== 'ALL' ? '#f97316' : _kpiProgInfo(id).color);
  // Program switch markers (between bars where the program changes)
  const switches = [];
  for (let i = 1; i < barProg.length; i++) if (barProg[i] !== barProg[i - 1]) switches.push({ i, name: _kpiProgInfo(barProg[i]).name });

  const switchPlugin = {
    id: 'kpiSwitch',
    afterDatasetsDraw(chart) {
      if (!switches.length) return;
      const { ctx, chartArea, scales: { x } } = chart;
      ctx.save();
      switches.forEach(sw => {
        const xPos = (x.getPixelForValue(sw.i - 1) + x.getPixelForValue(sw.i)) / 2;
        ctx.strokeStyle = '#9a9a9a'; ctx.lineWidth = 1; ctx.setLineDash([4, 3]);
        ctx.beginPath(); ctx.moveTo(xPos, chartArea.top); ctx.lineTo(xPos, chartArea.bottom); ctx.stroke();
        ctx.setLineDash([]);
        ctx.fillStyle = '#c8c8c8'; ctx.font = '600 9px DM Mono, monospace'; ctx.textAlign = 'left';
        const txt = '▸ ' + sw.name;
        const w = ctx.measureText(txt).width;
        const tx = Math.min(xPos + 3, chartArea.right - w - 2);
        ctx.fillText(txt, tx, chartArea.top + 9);
      });
      ctx.restore();
    }
  };

  if (kpiChart) { kpiChart.destroy(); kpiChart = null; }

  kpiChart = new Chart(cvs, {
    type: 'bar',
    data: {
      labels,
      datasets: [{
        data: vals,
        backgroundColor: barCol.map(c => _kpiAlpha(c, .18)),
        borderColor: barCol,
        borderWidth: 1.5,
        borderRadius: 4
      }]
    },
    plugins: [switchPlugin],
    options: {
      responsive: true,
      maintainAspectRatio: false,
      layout: { padding: { top: switches.length ? 12 : 0 } },
      plugins: {
        legend: { display: false },
        tooltip: { callbacks: {
          title: items => {
            const i = items[0].dataIndex;
            return labels[i] + (selProg === 'ALL' || mixed[i] ? ' · ' + (mixed[i] ? 'mixed programs' : _kpiProgInfo(barProg[i]).name) : '');
          },
          label: c => {
            if (kpiMetric === 'fatigue') {
              const lbl = ['','Very Easy','Easy','Moderate','Difficult','Very Difficult'];
              return lbl[c.parsed.y] || c.parsed.y;
            }
            return c.parsed.y.toLocaleString() + unit;
          },
          afterLabel: c => counts[c.dataIndex] > 1 ? `${counts[c.dataIndex]} sessions${kpiMetric === 'fatigue' ? ' (avg)' : kpiMetric === 'maxweight' ? ' (max)' : ' (total)'}` : ''
        }}
      },
      scales: {
        y: {
          beginAtZero: true,
          max: kpiMetric === 'fatigue' ? 5 : undefined,
          ticks: {
            color: '#505050',
            font: { size: 10, family: 'DM Mono' },
            callback: v => kpiMetric === 'fatigue'
              ? (['','VE','E','M','D','VD'][v] || '')
              : (v >= 1000 ? (v/1000).toFixed(1)+'k' : v)
          },
          grid: { color: '#2a2a2a' },
          border: { display: false }
        },
        x: {
          ticks: { color: '#505050', font: { size: 10, family: 'DM Mono' }, maxRotation: 45, autoSkip: true },
          grid: { display: false },
          border: { display: false }
        }
      }
    }
  });
}

// Keep old name as alias so nothing else breaks
function renderVolumeChart() { renderKpiChart(); }

function persistWorkout() {
  if(activeWorkout) localStorage.setItem('tr-active-wk-v1', JSON.stringify(activeWorkout));
  else localStorage.removeItem('tr-active-wk-v1');
}

function restoreWorkout() {
  const raw = localStorage.getItem('tr-active-wk-v1');
  if(!raw) return;
  try {
    activeWorkout = JSON.parse(raw);
    _topUpWorkoutFromPlan();
    document.getElementById('wk-title').textContent = DAY_FULL_NAMES[activeWorkout.dayType]||activeWorkout.dayType;
    document.getElementById('wk-sub').textContent = activeWorkout.label || activeWorkout.date;
    renderWkEx();
    if(activeWorkout.minimized){showPill();}
    else{document.getElementById('workout-view').classList.add('open');}
    clearInterval(wkInterval);
    const elapsed = Math.floor((Date.now() - activeWorkout.startedAt) / 1000);
    const initT = `${Math.floor(elapsed/60)}:${String(elapsed%60).padStart(2,'0')}`;
    document.getElementById('wk-timer').textContent = initT;
    const p=document.getElementById('wk-pill-timer');if(p)p.textContent=initT;
    wkInterval = setInterval(() => {
      const e = Math.floor((Date.now() - activeWorkout.startedAt) / 1000);
      const t=`${Math.floor(e/60)}:${String(e%60).padStart(2,'0')}`;
      document.getElementById('wk-timer').textContent = t;
      const p=document.getElementById('wk-pill-timer');if(p)p.textContent=t;
    }, 1000);
  } catch(e) { localStorage.removeItem('tr-active-wk-v1'); }
}

// ── WORKOUT ────────────────────────────────────────────────────────────────
// Adds any plan exercises missing from a workout saved by an older version (runs once per workout)
function _topUpWorkoutFromPlan(){
  if(!activeWorkout||activeWorkout._toppedUp||!activeWorkout.dayType)return;
  activeWorkout._toppedUp=true;
  try{
    const names=[...new Set(getActivePlanEx(activeWorkout.dayType,activeWorkout.date).flatMap(g=>g.ex))];
    const have=new Set(activeWorkout.exercises.map(e=>e.name));
    names.forEach(n=>{if(!have.has(n))activeWorkout.exercises.push({name:n,sets:buildSets(n,activeWorkout.date,activeWorkout.dayType)});});
  }catch(e){}
  persistWorkout();
}

function startWorkout(forDate, forDayType, forLabel) {
  // If workout already active, just resume it
  if(activeWorkout){_topUpWorkoutFromPlan();renderWkEx();resumeWk();return;}
  const date=forDate||todayStr();
  const info=getCycleInfo(date);
  const isCustom=!!forLabel&&!forDayType;
  const dayType=forDayType||(info.dayType&&info.dayType!=='REST'?info.dayType:'PUSH (Hypertrophy)');
  const groups=isCustom?[]:getActivePlanEx(dayType,date);
  const defaultEx=[...new Set(groups.flatMap(g=>g.ex))];
  const label=forLabel||info.label||'Custom';
  activeWorkout={
    date,label,cycle:info.cycleLabel||'Custom',dayType:forDayType||info.dayType||'Custom',
    startedAt:Date.now(),_toppedUp:true,
    exercises:defaultEx.map(name=>({name,sets:buildSets(name,date,dayType)}))
  };
  persistWorkout(); // save immediately so reload always recovers
  document.getElementById('wk-title').textContent=DAY_FULL_NAMES[dayType]||dayType;
  document.getElementById('wk-sub').textContent=info.label||date;
  renderWkEx();
  document.getElementById('workout-view').classList.add('open');
  hidePill();
  clearInterval(wkInterval);
  wkInterval=setInterval(()=>{
    const e=Math.floor((Date.now()-activeWorkout.startedAt)/1000);
    const t=`${Math.floor(e/60)}:${String(e%60).padStart(2,'0')}`;
    document.getElementById('wk-timer').textContent=t;
    const p=document.getElementById('wk-pill-timer');if(p)p.textContent=t;
    if(e%30===0) persistWorkout();
  },1000);
}

function buildSets(nm, date, dt) {
  const ps=getPrevSets(nm,date);
  const tb=isTimeBased(nm);
  // Check active program planMeta for target sets count
  let numSets=3;
  const custom=_getActiveCustomProgram(date||todayStr());
  if(custom&&custom.prog.planMeta){
    const dType=dt||getCycleInfo(date||todayStr()).dayType;
    const meta=custom.prog.planMeta[dType]?.[nm];
    if(meta?.sets)numSets=meta.sets;
    if(_inDeload(custom.prog,date||todayStr()))numSets=Math.min(numSets,2);
  }
  return Array.from({length:numSets},(_,i)=>{
    const prev=ps?.sets[i];
    if(tb) return {r:prev?.r||30,w:0,done:false};
    return {r:prev?.r||'',w:prev?.w||'',done:false};
  });
}

function getBestSet(exName, beforeDate) {
  let best=null, bestVol=0, bestLabel='';
  all().filter(s=>s.date<beforeDate).forEach(s=>{
    const ex=s.exercises.find(e=>e.name===exName);
    if(!ex)return;
    const tb=isTimeBased(exName);
    ex.sets.forEach(st=>{
      const vol=tb?(st.r||0):(st.r||0)*(st.w||0);
      if(vol>bestVol){bestVol=vol;best=st;bestLabel=s.label;}
    });
  });
  if(!best)return null;
  const tb=isTimeBased(exName);
  const display=tb?`${best.r}s`:`${(bestVol/1000>=1?(bestVol/1000).toFixed(1)+'k':bestVol)} kg (${best.r}×${best.w}kg)`;
  return {vol:bestVol,label:bestLabel,display};
}

function renderWkEx() {
  if(!activeWorkout)return;
  const total=activeWorkout.exercises.length;
  const mode=localStorage.getItem('tr-wk-mode-v1')||'focus';
  const inner=document.getElementById('workout-inner');

  // Mode bar
  const totalSets=activeWorkout.exercises.reduce((a,e)=>a+e.sets.length,0);
  const doneSets=activeWorkout.exercises.reduce((a,e)=>a+e.sets.filter(s=>s.done&&!s.wu).length,0);
  const modeBar=`<div class="wk-modebar">
    <div class="wk-mode-meta">${doneSets}/${totalSets} sets · ${total} ex</div>
    <div class="wk-mode-toggle">
      <button class="wk-mode-btn ${mode==='focus'?'active':''}" onclick="setWkMode('focus')">Focus</button>
      <button class="wk-mode-btn ${mode==='table'?'active':''}" onclick="setWkMode('table')">Table</button>
    </div>
  </div>`;

  if(mode==='focus'){
    inner.innerHTML=modeBar+activeWorkout.exercises.map((ex,ei)=>renderFocusExercise(ex,ei,total)).join('')
      +`<div class="addexbar" onclick="openSheet()">+ Add Exercise</div>`;
  } else {
    inner.innerHTML=modeBar+activeWorkout.exercises.map((ex,ei)=>renderTableExercise(ex,ei,total)).join('')
      +`<div class="addexbar" onclick="openSheet()">+ Add Exercise</div>`;
  }
}

function setWkMode(m){
  localStorage.setItem('tr-wk-mode-v1',m);
  renderWkEx();
}

// Get the active set index for an exercise: first non-done non-warmup, else last set
function activeSetIdx(ex){
  for(let i=0;i<ex.sets.length;i++){if(!ex.sets[i].done&&!ex.sets[i].wu)return i;}
  // Fallback: first non-done set, even if warmup
  for(let i=0;i<ex.sets.length;i++){if(!ex.sets[i].done)return i;}
  return ex.sets.length-1;
}

// Per-exercise active set is stored on the workout for cross-render persistence
function getActiveSetIdx(ei){
  if(!activeWorkout)return 0;
  const ex=activeWorkout.exercises[ei];
  if(activeWorkout._activeSet&&activeWorkout._activeSet[ei]!=null){
    const i=activeWorkout._activeSet[ei];
    if(i>=0&&i<ex.sets.length)return i;
  }
  return activeSetIdx(ex);
}
function setActiveSetIdx(ei,si){
  if(!activeWorkout)return;
  if(!activeWorkout._activeSet)activeWorkout._activeSet={};
  activeWorkout._activeSet[ei]=si;
  renderWkEx();
}

function renderFocusExercise(ex,ei,total){
  const tb=isTimeBased(ex.name);
  const ps=getPrevSets(ex.name,activeWorkout.date);
  const best=getBestSet(ex.name,activeWorkout.date);
  const canUp=ei>0,canDown=ei<total-1;
  const aSi=getActiveSetIdx(ei);
  const aSet=ex.sets[aSi];
  const prevSet=ps?.sets[aSi]||null;
  const bestLine=best
    ?`<div class="fexb-best">★ <b>Best</b> ${best.label} — ${best.display}</div>`
    :`<div class="fexb-best">No history yet</div>`;

  // Set chips
  const chipsHtml=ex.sets.map((s,si)=>{
    const cls=`fset-chip ${s.wu?'warmup':''} ${s.done?'done':''} ${si===aSi?'active':''}`;
    const lbl=s.wu?'W':(si+1);
    return `<div class="${cls}" onclick="setActiveSetIdx(${ei},${si})">${lbl}</div>`;
  }).join('')+`<button class="fset-add" onclick="addSet(${ei})" title="Add set">+</button>`;

  // Active-set body
  const prevTxt=prevSet
    ?(tb?(prevSet.r?`${prevSet.r}s`:'—'):(prevSet.w>0?`${prevSet.r} × ${prevSet.w} kg`:`${prevSet.r} reps`))
    :'—';

  let body='';
  if(tb){
    const cur=aSet.r||0;
    body=`<div class="fbody ${aSet.done?'done-state':''}">
      <div class="flbl"><span>Seconds</span><span class="flbl-prev">Last: ${prevTxt}</span></div>
      <div class="fstepper">
        <button class="fstep-btn minor" onclick="adjSet(${ei},${aSi},'r',-5)">−5</button>
        <button class="fstep-btn" onclick="adjSet(${ei},${aSi},'r',-1)">−1</button>
        <div class="finput-wrap"><input class="finput" type="number" inputmode="numeric" placeholder="${prevSet?.r||30}" value="${cur||''}" oninput="updSet(${ei},${aSi},'r',+this.value)"><span class="finput-suffix">SEC</span></div>
        <button class="fstep-btn" onclick="adjSet(${ei},${aSi},'r',1)">+1</button>
        <button class="fstep-btn minor" onclick="adjSet(${ei},${aSi},'r',5)">+5</button>
      </div>
      ${actionRow(ei,aSi,aSet)}
    </div>`;
  } else {
    body=`<div class="fbody ${aSet.done?'done-state':''}">
      <div class="flbl"><span>Reps</span><span class="flbl-prev">Last: ${prevTxt}</span></div>
      <div class="fstepper">
        <button class="fstep-btn minor" onclick="adjSet(${ei},${aSi},'r',-5)">−5</button>
        <button class="fstep-btn" onclick="adjSet(${ei},${aSi},'r',-1)">−1</button>
        <div class="finput-wrap"><input class="finput" type="number" inputmode="numeric" placeholder="${prevSet?.r||10}" value="${aSet.r||''}" oninput="updSet(${ei},${aSi},'r',+this.value)"></div>
        <button class="fstep-btn" onclick="adjSet(${ei},${aSi},'r',1)">+1</button>
        <button class="fstep-btn minor" onclick="adjSet(${ei},${aSi},'r',5)">+5</button>
      </div>
      <div class="flbl"><span>Weight</span><span class="flbl-prev">${prevSet&&prevSet.w?`Last: ${prevSet.w} kg`:'Bodyweight or 0'}</span></div>
      <div class="fstepper">
        <button class="fstep-btn minor" onclick="adjSet(${ei},${aSi},'w',-5)">−5</button>
        <button class="fstep-btn" onclick="adjSet(${ei},${aSi},'w',-2.5)">−2.5</button>
        <div class="finput-wrap"><input class="finput" type="number" inputmode="decimal" step="0.5" placeholder="${prevSet?.w||0}" value="${aSet.w||''}" oninput="updSet(${ei},${aSi},'w',+this.value)"><span class="finput-suffix">KG</span></div>
        <button class="fstep-btn" onclick="adjSet(${ei},${aSi},'w',2.5)">+2.5</button>
        <button class="fstep-btn minor" onclick="adjSet(${ei},${aSi},'w',5)">+5</button>
      </div>
      ${actionRow(ei,aSi,aSet)}
    </div>`;
  }

  return `<div class="fexb" id="fexb-${ei}">
    <div class="fexb-head">
      <div style="min-width:0;flex:1">
        <div class="fexb-name">${ex.name}${tb?'<span class="tbadge-ex">TIME</span>':''}</div>
        ${bestLine}
      </div>
      <button class="fex-del" onclick="removeExWk(${ei})" title="Remove exercise from this workout"><svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg></button>
      <div class="fexb-mv">
        <button class="fmv-btn" onclick="moveExWk(${ei},'up')" ${canUp?'':'disabled'}>▲</button>
        <button class="fmv-btn" onclick="moveExWk(${ei},'down')" ${canDown?'':'disabled'}>▼</button>
      </div>
    </div>
    <div class="fset-chips">${chipsHtml}</div>
    ${body}
  </div>`;
}

function actionRow(ei,si,set){
  return `<div class="fact-row">
    <button class="fact-wu ${set.wu?'active':''}" onclick="toggleWarmup(${ei},${si})">${set.wu?'★ Warm-up':'Warm-up'}</button>
    <button class="fact-check ${set.done?'done':''}" onclick="toggleSet(${ei},${si})">
      ${set.done?'<svg viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg> Done — tap to undo':'<svg viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg> Mark set complete'}
    </button>
    <button class="fact-del" onclick="delSet(${ei},${si})" title="Delete set">×</button>
  </div>`;
}

function adjSet(ei,si,f,delta){
  if(!activeWorkout)return;
  const set=activeWorkout.exercises[ei].sets[si];
  const cur=+(set[f]||0);
  let nv=+(cur+delta).toFixed(2);
  if(nv<0)nv=0;
  set[f]=nv;
  renderWkEx();
  persistWorkout();
}

// Original (table) renderer — preserved for power users
function renderTableExercise(ex,ei,total){
  const ps=getPrevSets(ex.name,activeWorkout.date);
  const tb=isTimeBased(ex.name);
  const best=getBestSet(ex.name,activeWorkout.date);
  const bestHtml=best
    ?`<div style="font-size:10px;color:var(--amber);margin-top:2px;font-family:'DM Mono',monospace">★ Best: ${best.label} — ${best.display}</div>`
    :`<div style="font-size:10px;color:var(--text3);margin-top:2px">No best yet</div>`;
  const hdr=tb
    ?`<div class="sth"><span>#</span><span>Previous</span><span colspan="2">Secs</span><span></span><span></span></div>`
    :`<div class="sth"><span>#</span><span>Previous</span><span>Reps</span><span>kg</span><span></span></div>`;
  const canUp=ei>0, canDown=ei<total-1;
  return `<div class="exb" id="exb-${ei}">
    <div class="exbh">
      <div style="display:flex;align-items:center;gap:8px;flex-shrink:0">
        <div style="display:flex;flex-direction:column;gap:2px">
          <button onclick="moveExWk(${ei},'up')" style="width:24px;height:20px;border:none;background:none;cursor:pointer;color:var(--text3);font-size:13px;line-height:1;padding:0;border-radius:4px;${canUp?'':'opacity:.2;pointer-events:none'}">▲</button>
          <button onclick="moveExWk(${ei},'down')" style="width:24px;height:20px;border:none;background:none;cursor:pointer;color:var(--text3);font-size:13px;line-height:1;padding:0;border-radius:4px;${canDown?'':'opacity:.2;pointer-events:none'}">▼</button>
        </div>
        <div>
          <div class="exbn">${ex.name}${tb?'<span class="tbadge-ex">TIME</span>':''}</div>
          <div class="exbs">${ps?`(${ps.label})`:'No history'}</div>
          ${bestHtml}
        </div>
      </div>
      <div style="display:flex;align-items:center;gap:6px;flex-shrink:0">
        <button class="fex-del" onclick="removeExWk(${ei})" title="Remove exercise from this workout"><svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg></button>
        <button class="addset" onclick="addSet(${ei})">+ Set</button>
      </div>
    </div>
    <div class="stbl">
      ${hdr}
      ${ex.sets.map((s,si)=>setRowHTML(ei,si,s,ps?.sets[si]||null,tb)).join('')}
    </div>
  </div>`;
}

function moveExWk(ei, dir) {
  if(!activeWorkout)return;
  const exs=activeWorkout.exercises;
  const ni=dir==='up'?ei-1:ei+1;
  if(ni<0||ni>=exs.length)return;
  [exs[ei],exs[ni]]=[exs[ni],exs[ei]];
  renderWkEx();
  persistWorkout();
}

function removeExWk(ei){
  if(!activeWorkout)return;
  const ex=activeWorkout.exercises[ei];
  if(!ex)return;
  const doneCnt=ex.sets.filter(s=>s.done).length;
  const msg=`Remove "${ex.name}" from this workout?`+(doneCnt?`\n\n${doneCnt} completed set${doneCnt>1?'s':''} will be lost.`:'')+`\n\n(Your program is not changed — you'll be asked at the end.)`;
  if(!confirm(msg))return;
  activeWorkout.exercises.splice(ei,1);
  // shift per-exercise active-set pointers
  if(activeWorkout._activeSet){
    const nx={};
    Object.keys(activeWorkout._activeSet).forEach(k=>{
      const i=+k;
      if(i<ei)nx[i]=activeWorkout._activeSet[k];
      else if(i>ei)nx[i-1]=activeWorkout._activeSet[k];
    });
    activeWorkout._activeSet=nx;
  }
  renderWkEx();
  persistWorkout();
}

function setRowHTML(ei,si,set,prevSet,tb=false) {
  // prevSet is the actual previous set at this index: {r, w} or null
  const prevTxt=tb
    ?(prevSet?.r?`${prevSet.r}s`:'—')
    :(prevSet?(prevSet.w>0?`${prevSet.r}×${prevSet.w}`:`${prevSet.r}r`):'—');
  if(tb){
    return `<div class="srow ${set.done?'done':''} ${set.wu?'warmup':''}" id="sr-${ei}-${si}">
      <div class="snum ${set.wu?'wu':''}" onclick="toggleWarmup(${ei},${si})" title="Tap to mark as warm-up">${set.wu?'W':si+1}</div>
      <div class="prev">${prevTxt}</div>
      <input class="sinput" type="number" inputmode="numeric" placeholder="${prevSet?.r||'30'}" value="${set.r||''}" oninput="updSet(${ei},${si},'r',+this.value)" style="color:var(--purple)">
      <div style="display:flex;align-items:center;justify-content:center;font-size:11px;color:var(--purple);font-weight:700;letter-spacing:.04em">sec</div>
      <button class="cbtn ${set.done?'done':''}" onclick="toggleSet(${ei},${si})">
        <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
      </button>
    </div>`;
  }
  return `<div class="srow ${set.done?'done':''} ${set.wu?'warmup':''}" id="sr-${ei}-${si}">
    <div class="snum ${set.wu?'wu':''}" onclick="toggleWarmup(${ei},${si})" title="Tap to mark as warm-up">${set.wu?'W':si+1}</div>
    <div class="prev">${prevTxt}</div>
    <input class="sinput" type="number" inputmode="numeric" placeholder="${prevSet?.r||'12'}" value="${set.r||''}" oninput="updSet(${ei},${si},'r',+this.value)">
    <input class="sinput" type="number" inputmode="decimal" step="0.5" placeholder="${prevSet?.w||'0'}" value="${set.w||''}" oninput="updSet(${ei},${si},'w',+this.value)">
    <button class="cbtn ${set.done?'done':''}" onclick="toggleSet(${ei},${si})">
      <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
    </button>
  </div>`;
}

function updSet(ei,si,f,v){if(activeWorkout)activeWorkout.exercises[ei].sets[si][f]=v;}

function toggleSet(ei,si) {
  if(!activeWorkout)return;
  const set=activeWorkout.exercises[ei].sets[si];
  set.done=!set.done;
  const ex=activeWorkout.exercises[ei];
  const ps=getPrevSets(ex.name,activeWorkout.date);
  const tb=isTimeBased(ex.name);
  const mode=localStorage.getItem('tr-wk-mode-v1')||'focus';
  if(mode==='focus'){
    // Advance active set on completion
    if(set.done){
      // find next non-done, non-warmup
      let nxt=-1;
      for(let i=0;i<ex.sets.length;i++){if(!ex.sets[i].done&&!ex.sets[i].wu){nxt=i;break;}}
      if(nxt<0)for(let i=0;i<ex.sets.length;i++){if(!ex.sets[i].done){nxt=i;break;}}
      if(nxt>=0){
        if(!activeWorkout._activeSet)activeWorkout._activeSet={};
        activeWorkout._activeSet[ei]=nxt;
      }
    }
    renderWkEx();
  } else {
    const row=document.getElementById(`sr-${ei}-${si}`);
    if(row)row.outerHTML=setRowHTML(ei,si,set,ps?.sets[si]||null,tb);
  }
  if(set.done){
    persistWorkout();
    startRest(90);
    const prevBest=getBestSet(ex.name,activeWorkout.date);
    const curVol=tb?(set.r||0):(set.r||0)*(set.w||0);
    if(curVol>0&&(!prevBest||curVol>prevBest.vol)) showPrToast(ex.name,set,tb);
  } else {
    persistWorkout();
  }
}

function delSet(ei,si){
  if(!activeWorkout)return;
  const ex=activeWorkout.exercises[ei];
  if(ex.sets.length<=1)return; // keep at least one
  ex.sets.splice(si,1);
  // adjust active pointer if needed
  if(activeWorkout._activeSet&&activeWorkout._activeSet[ei]!=null){
    const a=activeWorkout._activeSet[ei];
    if(a>=ex.sets.length)activeWorkout._activeSet[ei]=ex.sets.length-1;
  }
  renderWkEx();
  persistWorkout();
}

let _prToastTimer=null;
function showPrToast(name, set, tb) {
  const t=document.getElementById('pr-toast');
  const m=document.getElementById('pr-toast-msg');
  if(!t||!m)return;
  const display=tb?`${set.r}s`:`${set.r}×${set.w}kg`;
  m.textContent=`New PR: ${name.split(' (')[0]} — ${display}`;
  t.classList.add('show');
  clearTimeout(_prToastTimer);
  _prToastTimer=setTimeout(()=>t.classList.remove('show'),3500);
}

function addSet(ei) {
  if(!activeWorkout)return;
  const ex=activeWorkout.exercises[ei];
  const last=ex.sets[ex.sets.length-1];
  ex.sets.push({r:last?.r||'',w:last?.w||'',done:false});
  const mode=localStorage.getItem('tr-wk-mode-v1')||'focus';
  if(mode==='focus'){
    renderWkEx();
  } else {
    const ps=getPrevSets(ex.name,activeWorkout.date);
    const tb=isTimeBased(ex.name);
    const hdr=tb
      ?`<div class="sth"><span>#</span><span>Previous</span><span>Secs</span><span></span><span></span></div>`
      :`<div class="sth"><span>#</span><span>Previous</span><span>Reps</span><span>kg</span><span></span></div>`;
    const blk=document.getElementById(`exb-${ei}`);
    if(blk)blk.querySelector('.stbl').innerHTML=hdr+ex.sets.map((s,si)=>setRowHTML(ei,si,s,ps?.sets[si]||null,tb)).join('');
  }
  persistWorkout();
}

function startRest(secs) {
  clearInterval(restInterval);restSecs=secs;
  const t=document.getElementById('rest-toast');t.classList.add('show');
  document.getElementById('rest-cnt').textContent=restSecs;
  restInterval=setInterval(()=>{restSecs--;document.getElementById('rest-cnt').textContent=restSecs;if(restSecs<=0)skipRest();},1000);
}
function skipRest(){clearInterval(restInterval);document.getElementById('rest-toast').classList.remove('show');}
function adjustRest(delta){restSecs=Math.max(5,restSecs+delta);document.getElementById('rest-cnt').textContent=restSecs;}

function openSheet() {
  document.getElementById('ex-sheet').classList.add('open');
  document.getElementById('sheet-search').value='';filterSheet('');
  setTimeout(()=>document.getElementById('sheet-search').focus(),100);
}
function closeSheet() {document.getElementById('ex-sheet').classList.remove('open');}

function filterSheet(v) {
  const added=new Set(activeWorkout?.exercises.map(e=>e.name)||[]);
  const dt=activeWorkout?.dayType;
  const groups=getPlanEx(dt);
  let html='';
  groups.forEach(g=>{
    const f=g.ex.filter(n=>!v||n.toLowerCase().includes(v.toLowerCase()));
    if(!f.length)return;
    html+=`<div class="sglbl">${g.g}</div>`;
    f.forEach(n=>{
      const tb=isTimeBased(n);
      html+=`<div class="sitem" onclick="addExWk('${n.replace(/'/g,"\\'")}')"><div><div class="sitem-name">${n}${tb?'<span class="tbadge-ex">TIME</span>':''}</div></div>${added.has(n)?'<div class="schk"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></div>':''}</div>`;
    });
  });
  // Library exercises not already in plan groups
  const planExNames=new Set(groups.flatMap(g=>g.ex));
  const libEx=EX_LIBRARY.filter(e=>!planExNames.has(e.name)&&(!v||e.name.toLowerCase().includes(v.toLowerCase())));
  if(libEx.length){
    html+=`<div class="sglbl">Library</div>`;
    libEx.forEach(e=>{
      html+=`<div class="sitem" onclick="addExWk('${e.name.replace(/'/g,"\\'")}')"><div><div class="sitem-name">${e.name}${e.type==='time'?'<span class="tbadge-ex">TIME</span>':''}</div></div>${added.has(e.name)?'<div class="schk"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></div>':''}</div>`;
    });
  }
  const allKnown=new Set([...groups.flatMap(g=>g.ex),...EX_LIBRARY.map(e=>e.name)]);
  if(v&&![...allKnown].some(n=>n.toLowerCase()===v.toLowerCase()))
    html+=`<div class="sglbl">Custom</div><div class="sitem" onclick="addExWk('${v.replace(/'/g,"\\'")}',true)"><div><div class="sitem-name">+ "${v}"</div><div class="sitem-sub">Add as custom</div></div></div>`;
  document.getElementById('sheet-list').innerHTML=html||`<div style="padding:20px;text-align:center;color:var(--text3)">No results</div>`;
}

function addExWk(name, isCustom=false) {
  if(!activeWorkout)return;
  closeSheet();
  // Program is no longer changed here — finishWorkout() asks whether to add it to the program
  ensureInLibrary(name);
  if(!activeWorkout.exercises.find(e=>e.name===name)){
    activeWorkout.exercises.push({name,sets:buildSets(name,activeWorkout.date,activeWorkout.dayType)});
    renderWkEx();
    persistWorkout();
  }
}

function finishWorkout() {
  if(!activeWorkout)return;
  clearInterval(wkInterval);skipRest();
  const exercises=activeWorkout.exercises.map(ex=>({...ex,sets:ex.sets.filter(s=>s.done&&(s.r||s.w))})).filter(ex=>ex.sets.length>0);
  if(!exercises.length){if(!confirm('No completed sets. Discard?'))return;closeWk();return;}
  pendingSession={id:'u'+Date.now(),date:activeWorkout.date,label:activeWorkout.label,cycle:activeWorkout.cycle,dayType:activeWorkout.dayType,notes:'',exercises,volume:calcVolume({exercises}),duration:Math.floor((Date.now()-activeWorkout.startedAt)/1000)};
  const diff=_computePlanDiff(activeWorkout,exercises);
  closeWk();
  if(diff&&(diff.added.length||diff.removed.length))openPlanChanges(diff);
  else openFeedback();
}

// ── PROGRAM CHANGES AFTER WORKOUT ─────────────────────────────────────────
let _planDiff=null;
function _computePlanDiff(wk,doneExercises){
  try{
    const dt=wk.dayType;
    if(!dt||dt==='REST'||dt==='Custom')return null;
    const planNames=[...new Set(getActivePlanEx(dt,wk.date).flatMap(g=>g.ex))];
    const planSet=new Set(planNames);
    const wkNames=new Set(wk.exercises.map(e=>e.name));
    // Added = exercises actually performed (≥1 completed set) that aren't in the program
    const added=doneExercises.map(e=>e.name).filter(n=>!planSet.has(n));
    // Removed = program exercises the user deleted from the workout
    const removed=planNames.filter(n=>!wkNames.has(n));
    return {dayType:dt,date:wk.date,added:[...new Set(added)],removed};
  }catch(e){return null;}
}
function openPlanChanges(diff){
  _planDiff=diff;
  const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
  const custom=_getActiveCustomProgram(diff.date);
  document.getElementById('planchg-sub').textContent=`This workout was different from your ${custom?custom.prog.name||'program':'program'} for ${diff.dayType}.`;
  let html='';
  if(diff.added.length){
    html+=`<div class="pc-lbl" style="color:var(--green)">Added in this workout</div>`;
    html+=diff.added.map((n,i)=>`<label class="pc-row"><input type="checkbox" data-pc="add" data-i="${i}" checked><div><div style="font-weight:600">${esc(n)}</div><div style="font-size:11px;color:var(--text3)">Add to program</div></div></label>`).join('');
  }
  if(diff.removed.length){
    html+=`<div class="pc-lbl" style="color:var(--red)">Removed from this workout</div>`;
    html+=diff.removed.map((n,i)=>`<label class="pc-row"><input type="checkbox" data-pc="rem" data-i="${i}"><div><div style="font-weight:600">${esc(n)}</div><div style="font-size:11px;color:var(--text3)">Remove from program</div></div></label>`).join('');
  }
  document.getElementById('planchg-list').innerHTML=html;
  document.getElementById('planchg-modal').classList.add('open');
}
function applyPlanChanges(){
  const diff=_planDiff;
  if(diff){
    const toAdd=[],toRem=[];
    document.querySelectorAll('#planchg-list input[data-pc]').forEach(cb=>{
      if(!cb.checked)return;
      const i=+cb.dataset.i;
      if(cb.dataset.pc==='add')toAdd.push(diff.added[i]);else toRem.push(diff.removed[i]);
    });
    if(toAdd.length||toRem.length){
      const dt=diff.dayType;
      const custom=_getActiveCustomProgram(diff.date);
      let plan;
      if(custom){if(!custom.prog.plan)custom.prog.plan={};plan=custom.prog.plan;}
      else plan=PLAN;
      if(!plan[dt])plan[dt]=[];
      // Removals
      if(toRem.length){
        plan[dt].forEach(g=>g.ex=g.ex.filter(n=>!toRem.includes(n)));
        if(!custom&&CUSTOM_EX[dt])CUSTOM_EX[dt]=CUSTOM_EX[dt].filter(n=>!toRem.includes(n));
        if(custom&&custom.prog.planMeta?.[dt])toRem.forEach(n=>delete custom.prog.planMeta[dt][n]);
      }
      // Additions go into the "Custom" group of that day
      if(toAdd.length){
        let cg=plan[dt].find(g=>g.g==='Custom');
        if(!cg){cg={g:'Custom',ex:[]};plan[dt].push(cg);}
        toAdd.forEach(n=>{if(!cg.ex.includes(n))cg.ex.push(n);ensureInLibrary(n);});
      }
      if(custom)savePrograms();else saveMeta();
    }
  }
  _closePlanChanges();
}
function skipPlanChanges(){_closePlanChanges();}
function _closePlanChanges(){
  _planDiff=null;
  document.getElementById('planchg-modal').classList.remove('open');
  if(pendingSession)openFeedback();else switchView('today');
}

function closeWk(){document.getElementById('workout-view').classList.remove('open');hidePill();activeWorkout=null;clearInterval(wkInterval);persistWorkout();}
function minimizeWk(){if(activeWorkout)activeWorkout.minimized=true;persistWorkout();document.getElementById('workout-view').classList.remove('open');showPill();}
function resumeWk(){if(activeWorkout)activeWorkout.minimized=false;persistWorkout();document.getElementById('workout-view').classList.add('open');hidePill();}
function showPill(){document.getElementById('wk-pill').classList.add('active');}
function hidePill(){document.getElementById('wk-pill').classList.remove('active');}

// ── LOG / CALENDAR ────────────────────────────────────────────────────────
let logTab='timeline', logMonthDate=new Date();

function prevMonth(){logMonthDate.setMonth(logMonthDate.getMonth()-1);renderMonthTab();}
function nextMonth(){logMonthDate.setMonth(logMonthDate.getMonth()+1);renderMonthTab();}

function setLogTab(tab){
  logTab=tab;
  document.querySelectorAll('.log-tab').forEach(b=>b.classList.toggle('active',b.dataset.tab===tab));
  ['timeline','cycle','month','list'].forEach(v=>{
    const el=document.getElementById('log-'+v+'-view');
    if(el)el.style.display=logTab===v?'':'none';
  });
  if(tab==='timeline')renderTimelineTab();
  else if(tab==='cycle')renderCycleTab();
  else if(tab==='month')renderMonthTab();
  else renderListTab();
}

function renderCalendar() {
  const sessions=all();
  const _wk=sessions.filter(s=>s.date>=_mondayOf(todayStr())&&s.date<=todayStr()&&s.dayType!=='REST').length;
  document.getElementById('log-session-count').textContent=`${sessions.length} session${sessions.length!==1?'s':''} logged · ${_wk} this week`;
  if(logTab==='timeline')renderTimelineTab();
  else if(logTab==='cycle')renderCycleTab();
  else if(logTab==='month')renderMonthTab();
  else renderListTab();
}

function _ds(d){return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;}

function v4TypeClassFull(dt){
  if(!dt||dt==='REST')return 'rest';
  if(dt==='WORKOUT A')return 'push';
  if(dt==='WORKOUT B')return 'legs';
  if(dt==='WORKOUT C')return 'push-s';
  if(dt==='FULL BODY'||dt==='CARDIO')return 'pull';
  if(dt==='UPPER BODY')return 'push';
  if(dt==='LOWER BODY')return 'legs';
  if(dt.includes('PUSH')&&dt.includes('Strength'))return 'push-s';
  if(dt.includes('PUSH'))return 'push';
  if(dt.includes('LEGS')&&dt.includes('Hypertrophy'))return 'legs-h';
  if(dt.includes('LEGS'))return 'legs';
  if(dt.includes('PULL'))return 'pull';
  return 'rest';
}
function dayAbbr(dt){
  if(!dt||dt==='REST')return '';
  if(dt==='WORKOUT A')return 'STR';
  if(dt==='WORKOUT B')return 'SHP';
  if(dt==='WORKOUT C')return 'Wkt C';
  if(dt==='FULL BODY')return 'Full';
  if(dt==='UPPER BODY')return 'Upper';
  if(dt==='LOWER BODY')return 'Lower';
  if(dt==='CARDIO')return 'Cardio';
  if(dt.includes('PUSH')&&dt.includes('Hypertrophy'))return 'Push H';
  if(dt.includes('PUSH')&&dt.includes('Strength'))return 'Push S';
  if(dt.includes('LEGS')&&dt.includes('Strength'))return 'Legs S';
  if(dt.includes('LEGS')&&dt.includes('Hypertrophy'))return 'Legs H';
  if(dt.includes('PULL'))return 'Pull';
  return dt.split(' ')[0];
}
function _fmtRange(a,b){
  const fmt={month:'short',day:'numeric'};
  return new Date(a+'T00:00:00').toLocaleDateString('en-GB',fmt)+' — '+new Date(b+'T00:00:00').toLocaleDateString('en-GB',fmt);
}
function _fmtLong(ds){return new Date(ds+'T00:00:00').toLocaleDateString('en-GB',{weekday:'short',day:'numeric',month:'long'});}

let _logShowOlder=false;
function renderCycleTab(){
  const sessions=all(), today=todayStr(), cycle=activeCycle(), cycleLen=cycle.length;
  const anchor=new Date('2026-04-03T00:00:00');
  const el=document.getElementById('log-cycle-view');
  if(!el)return;
  let html='';
  const cards=[];

  // PREP card
  const prepSessions=sessions.filter(s=>getCycleInfo(s.date).isPre).sort((a,b)=>a.date.localeCompare(b.date));
  if(prepSessions.length){
    const pDates=prepSessions.map(s=>s.date);
    cards.push({d:pDates[0],h:`<div class="cyc-card">
      <div class="cyc-hd"><div><div class="cyc-title">PREP</div><div class="cyc-dates">${_fmtRange(pDates[0],pDates[pDates.length-1])}</div></div></div>
      <div style="display:flex;flex-wrap:wrap;gap:6px">${prepSessions.map(s=>`
        <div onclick="showDetail('${s.id}')" style="background:var(--bg3);border-radius:8px;padding:7px 10px;cursor:pointer;min-width:60px;text-align:center">
          <div style="font-size:9px;font-weight:700;color:var(--text3);font-family:var(--fb)">${s.date.slice(5)}</div>
          <div style="font-size:12px;font-weight:600;color:var(--text);margin-top:2px">${s.label}</div>
        </div>`).join('')}
      </div>
    </div>`});
  }

  // Cycle cards — Normal Training cycles until a program starts, then the program's own cycles
  const _cp=_getActiveCustomProgram(today);
  const normalUntil=_cp?_cp.entry.startDate:null;
  const _cycleCard=(days)=>{
    const startStr=days[0].ds, endStr=days[days.length-1].ds;
    const trainingDays=days.filter(d=>d.info.dayType!=='REST');
    const loggedCount=trainingDays.filter(d=>d.sess).length;
    const isActive=days.some(d=>d.isToday);
    const allFuture=days.every(d=>d.isFuture);
    const isComplete=!isActive&&!allFuture&&loggedCount>=trainingDays.length&&trainingDays.length>0;
    const cyLabel=days[0].info.cycleLabel||'';
    const badge=isComplete?`<span class="cyc-badge done">● COMPLETE</span>`:isActive?`<span class="cyc-badge now">● ACTIVE</span>`:'';
    const cells=days.map(({ds,info,sess,isToday,isFuture})=>{
      const isRest=info.dayType==='REST';
      const tcf=v4TypeClassFull(info.dayType);
      const clsList=['cyc-day'];
      const hasPR=sess?sessionHasPR(sess):false;
      if(isRest)clsList.push('day-rest');
      else{
        clsList.push('day-'+tcf);
        if(isToday)clsList.push('day-today');
        else if(isFuture)clsList.push('day-future');
        else if(!sess)clsList.push('missed');
        if(hasPR)clsList.push('cyc-day-pr');
      }
      const onclick=isRest&&!sess?'':` onclick="showLogDay('${ds}')"`;
      const abbr=dayAbbr(sess?sess.dayType:info.dayType);
      return `<div class="${clsList.join(' ')}"${onclick}>
        ${isToday?`<span class="cyc-day-now">NOW</span>`:''}
        <div class="cyc-day-name">${info.dayName||''}</div>
        ${!isRest||sess?`<div class="cyc-day-abbr">${abbr}</div>`:''}
        ${sess?`<div class="cyc-day-check">${hasPR?'★':'✓'}</div>`:''}
      </div>`;
    }).join('');
    return {allFuture,html:`<div class="cyc-card${isActive?' cyc-active':''}">
      <div class="cyc-hd">
        <div><div class="cyc-title">${cyLabel}</div><div class="cyc-dates">${_fmtRange(startStr,endStr)}</div></div>
        ${badge}
      </div>
      <div class="cyc-days${days.length>8?' cyc-days-wide':''}">${cells}</div>
    </div>`};
  };
  const _daysFrom=(startDs,len)=>{
    const out=[];
    for(let i=0;i<len;i++){
      const ds=_addDays(startDs,i), info=getCycleInfo(ds);
      out.push({ds,info,sess:sessions.find(s=>s.date===ds),isToday:ds===today,isFuture:ds>today,isPast:ds<today});
    }
    return out;
  };
  const todayDate=new Date(today+'T00:00:00');
  const daysFromAnchor=Math.max(0,Math.floor((todayDate-anchor)/86400000));
  const currentCycleNum=Math.floor(daysFromAnchor/cycleLen)+1;
  for(let cn=1;cn<=currentCycleNum+1;cn++){
    const cycleStart=new Date(anchor);
    cycleStart.setDate(cycleStart.getDate()+(cn-1)*cycleLen);
    const cs=_ds(cycleStart);
    if(normalUntil&&cs>=normalUntil)break;
    let _nd=_daysFrom(cs,cycleLen); if(normalUntil)_nd=_nd.filter(d=>d.ds<normalUntil);
    const card=_cycleCard(_nd);
    if(_nd.some(d=>d.sess)||_nd.some(d=>d.isToday)||!card.allFuture&&_nd.some(d=>d.ds>=_addDays(today,-56)))cards.push({d:cs,h:card.html});
    if(card.allFuture&&cn>currentCycleNum)break;
  }
  if(_cp){
    const plen=_cp.prog.cyclePattern.length;
    for(let k=0;k<200;k++){
      const cs=_addDays(_cp.entry.startDate,k*plen);
      if(cs>today)break;
      cards.push({d:cs,h:_cycleCard(_daysFrom(cs,plen)).html});
    }
  }

  // ── Custom / non-Normal-Training sessions ─────────────────────────────────
  const normalCyclePatt=/^C\d+$/;
  const customSessions=sessions.filter(s=>s.cycle&&!normalCyclePatt.test(s.cycle)&&s.cycle!=='Prep'&&s.cycle!=='Custom'&&!(normalUntil&&s.date>=normalUntil&&_cp.prog.cyclePattern.includes(s.dayType)));
  if(customSessions.length){
    // Group by cycle label
    const groups={};
    customSessions.forEach(s=>{
      if(!groups[s.cycle])groups[s.cycle]=[];
      groups[s.cycle].push(s);
    });
    Object.entries(groups).forEach(([label,sessGroup])=>{
      sessGroup.sort((a,b)=>a.date.localeCompare(b.date));
      const dates=sessGroup.map(s=>s.date);
      const prog=PROGRAMS.find(p=>sessGroup[0].cycle===p.name||label.toLowerCase().includes(p.name.toLowerCase()));
      const progColor=prog?.color||'var(--amber)';
      const sCards=sessGroup.map(s=>{
        const tc=v4TypeClass(s.dayType);
        const hasPR=sessionHasPR(s);
        const durMin=s.duration?Math.round(s.duration/60):null;
        return `<div onclick="showDetail('${s.id}')" style="background:var(--bg3);border-radius:10px;padding:10px 12px;cursor:pointer;flex:1;min-width:120px">
          <div style="display:flex;align-items:center;gap:6px;margin-bottom:4px;flex-wrap:wrap">
            <span class="v4pill ${tc}">${dayAbbr(s.dayType)||s.dayType}</span>
            ${hasPR?`<span class="v4pill amber">★ PR</span>`:''}
          </div>
          <div style="font-size:12px;font-weight:600;color:var(--text)">${s.date.slice(5)}</div>
          <div style="font-size:10px;color:var(--text3);margin-top:2px;font-family:var(--fm)">${s.exercises.length} ex${durMin?` · ${durMin}m`:''}</div>
        </div>`;
      }).join('');
      cards.push({d:dates[0],h:`<div class="cyc-card" style="border-left-color:${progColor}">
        <div class="cyc-hd">
          <div><div class="cyc-title">${label.toUpperCase()}</div><div class="cyc-dates">${_fmtRange(dates[0],dates[dates.length-1])}</div></div>
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap">${sCards}</div>
      </div>`});
    });
  }

  // Newest first: current + 2 previous cycles, the rest behind a toggle
  cards.sort((a,b)=>b.d.localeCompare(a.d));
  const shown=cards.slice(0,3), older=cards.slice(3);
  html=shown.map(c=>c.h).join('');
  if(older.length){
    html+=`<button class="log-older-btn" onclick="_logShowOlder=!_logShowOlder;renderCycleTab()">${_logShowOlder?'Hide older cycles ▴':`Show ${older.length} older cycle${older.length!==1?'s':''} ▾`}</button>`;
    if(_logShowOlder)html+=older.map(c=>c.h).join('');
  }
  el.innerHTML=html||'<div style="padding:32px 16px;text-align:center;font-size:13px;color:var(--text3)">No sessions yet.</div>';
}


let _addDayDs='', _addDaySelType='';

function showLogDay(ds){
  const sess=all().find(s=>s.date===ds);
  if(sess){showDetail(sess.id);return;}
  _addDayDs=ds;
  const info=getCycleInfo(ds);
  _addDaySelType=getDayType(ds)||'';
  if(_addDaySelType==='REST')_addDaySelType='';
  _renderAddDaySheet();
  document.getElementById('add-day-sheet').classList.add('open');
}

function _renderAddDaySheet(){
  const ds=_addDayDs;
  const info=getCycleInfo(ds);
  const _today=todayStr();
  if(ds!==_today){
    const t=getDayType(ds), isRestOv=DAY_OVERRIDES[ds]==='REST', isTr=t&&t!=='REST'&&t!=='NONE';
    const past=ds<_today;
    const btn=(label,js,primary)=>`<button onclick="${js}" style="width:100%;padding:13px;background:${primary?'var(--text)':'var(--bg3)'};color:${primary?'var(--bg)':'var(--text2)'};font-family:var(--fb);font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;border:1px solid ${primary?'var(--text)':'var(--border)'};border-radius:12px;cursor:pointer;margin-bottom:10px">${label}</button>`;
    let body='';
    if(past){
      body=isRestOv
        ?`<div style="font-size:13px;color:var(--text2);margin-bottom:14px">Marked as rest. It doesn't count as missed.</div>${btn('Undo — count as missed',`closeAddDaySheet();clearDayOverride('${ds}')`)}`
        :isTr?`<div style="font-size:13px;color:var(--text2);margin-bottom:14px"><span style="color:var(--red);font-weight:700">Missed</span> · ${_esc(DAY_FULL_NAMES[t]||t)} was planned. This day has passed, so it can't be logged anymore. If you were sick or away, mark it as rest so it doesn't count as missed.</div>${btn('😴 Mark as rest (sick / away)',`closeAddDaySheet();setDayOverride('${ds}','REST')`,true)}`
        :`<div style="font-size:13px;color:var(--text2);margin-bottom:14px">Rest day. Nothing was logged.</div>`;
    } else {
      body=`<div style="font-size:13px;color:var(--text2);margin-bottom:14px">${isTr?`Planned: <strong style="color:${_typeColor(t)}">${_esc(DAY_FULL_NAMES[t]||t)}</strong>. You can start it on the day.`:'Rest day.'}</div>
        ${isRestOv?btn('Undo rest',`closeAddDaySheet();clearDayOverride('${ds}')`):isTr?btn('😴 Mark as rest',`closeAddDaySheet();setDayOverride('${ds}','REST')`):''}
        ${btn('Change plan for this day',`closeAddDaySheet();openDayOverrideSheet('${ds}')`)}`;
    }
    document.getElementById('add-day-inner').innerHTML=`
      <div style="font-size:10px;font-weight:700;color:var(--text3);letter-spacing:.12em;text-transform:uppercase;font-family:var(--fb);margin-bottom:4px">W${isoWeek(ds)} · ${_esc(info.label||ds)}</div>
      <div style="font-size:20px;font-weight:700;margin-bottom:12px">${_fmtLong(ds)}</div>${body}`;
    return;
  }
  const allTypes=cycleFor(ds).map(d=>d.dayType).filter(dt=>dt&&dt!=='REST');
  const uniqueTypes=[...new Set(allTypes)];
  const selType=_addDaySelType;
  const planEx=selType?getActivePlanEx(selType,ds).flatMap(g=>g.ex):[];

  const typePills=uniqueTypes.map(dt=>{
    const tcf=v4TypeClassFull(dt);
    const colors={push:'rgba(96,165,250,1)',legs:'rgba(251,146,60,1)',pull:'rgba(74,222,128,1)','push-s':'rgba(167,139,250,1)','legs-h':'rgba(251,191,36,1)'};
    const col=colors[tcf]||'var(--text3)';
    const isSelected=dt===selType;
    return `<button class="day-type-pill${isSelected?' sel':''}" onclick="_selectAddDayType('${dt.replace(/'/g,"\\'")}')" style="${isSelected?`color:${col};border-color:${col};background:${col}18`:''}">
      ${dayAbbr(dt)}
    </button>`;
  }).join('');

  document.getElementById('add-day-inner').innerHTML=`
    <div style="font-size:10px;font-weight:700;color:var(--text3);letter-spacing:.12em;text-transform:uppercase;font-family:var(--fb);margin-bottom:4px">${info.label||ds}</div>
    <div style="font-size:20px;font-weight:700;margin-bottom:16px">${_fmtLong(ds)}</div>
    <div style="font-size:10px;font-weight:700;color:var(--text3);letter-spacing:.08em;text-transform:uppercase;font-family:var(--fb);margin-bottom:8px">Choose workout</div>
    <div class="day-type-pills">${typePills}</div>
    ${selType&&planEx.length?`
      <div style="background:var(--bg3);border-radius:10px;padding:10px 12px;margin-bottom:14px">
        ${planEx.slice(0,6).map(e=>`<div style="font-size:13px;color:var(--text2);padding:2px 0">· ${e.replace(/\s*\([^)]+\)/,'')}</div>`).join('')}
        ${planEx.length>6?`<div style="font-size:11px;color:var(--text3);margin-top:2px">+${planEx.length-6} more</div>`:''}
      </div>
      <button onclick="closeAddDaySheet();startWorkout('${ds}','${selType.replace(/'/g,"\\'")}')" style="width:100%;padding:14px;background:var(--text);color:var(--bg);font-family:var(--fb);font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;border:none;border-radius:12px;cursor:pointer;margin-bottom:12px">▸ Start ${dayAbbr(selType)}</button>
    `:''}
    <button onclick="closeAddDaySheet();setDayOverride('${ds}','REST')" style="width:100%;padding:13px;background:var(--bg3);color:var(--text2);font-family:var(--fb);font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;border:1px solid var(--border);border-radius:12px;cursor:pointer;margin-bottom:12px">😴 Mark as Rest Day</button>
    <div style="font-size:10px;font-weight:700;color:var(--text3);letter-spacing:.08em;text-transform:uppercase;font-family:var(--fb);margin-bottom:8px">Custom workout</div>
    <div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:10px">
      ${['Mobility','Stretching','Home Training','Active Recovery','Cardio','Yoga'].map(p=>
        `<button onclick="closeAddDaySheet();startWorkout('${ds}',null,'${p}')" style="padding:7px 12px;border-radius:8px;font-family:var(--fb);font-size:10px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;cursor:pointer;border:1px solid var(--border);background:var(--bg3);color:var(--text2)">${p}</button>`
      ).join('')}
    </div>
    <div style="display:flex;gap:8px;align-items:center">
      <input id="add-day-name" type="text" placeholder="Or type your own…" style="flex:1;padding:11px 12px;background:var(--bg3);border:1px solid var(--border);border-radius:10px;color:var(--text);font-family:inherit;font-size:14px;outline:none;box-sizing:border-box">
      <button onclick="startCustomDayWorkout('${ds}')" style="padding:11px 16px;background:var(--text);color:var(--bg);font-family:var(--fb);font-size:11px;font-weight:700;letter-spacing:.06em;border:none;border-radius:10px;cursor:pointer;white-space:nowrap">Log it</button>
    </div>`;
}

function _selectAddDayType(dt){
  _addDaySelType=(_addDaySelType===dt)?'':dt;
  _renderAddDaySheet();
}

function closeAddDaySheet(){document.getElementById('add-day-sheet').classList.remove('open');}
function startCustomDayWorkout(ds){
  const name=document.getElementById('add-day-name').value.trim()||'Custom';
  closeAddDaySheet();
  startWorkout(ds,null,name);
}

function renderMonthTab(){
  const sessions=all(), today=todayStr();
  const y=logMonthDate.getFullYear(), m=logMonthDate.getMonth();
  const el=document.getElementById('log-month-view');if(!el)return;
  const monthName=logMonthDate.toLocaleDateString('en-GB',{month:'long',year:'numeric'});
  const firstDay=new Date(y,m,1), lastDay=new Date(y,m+1,0);
  const startDow=(firstDay.getDay()+6)%7;
  const dows=['WK','MO','TU','WE','TH','FR','SA','SU'];
  const _lc={push:'rgba(96,165,250,1)',legs:'rgba(251,146,60,1)',pull:'rgba(74,222,128,1)','push-s':'rgba(167,139,250,1)','legs-h':'rgba(251,191,36,1)'};
  const _mid=`${y}-${String(m+1).padStart(2,'0')}-15`;
  const legend=[...new Set([...cycleFor(_mid),...cycleFor(today)].map(c=>c.dayType).filter(dt=>dt&&dt!=='REST'))]
    .map(dt=>({label:DAY_FULL_NAMES[dt]||dt,color:_lc[v4TypeClassFull(dt)]||'var(--text3)'}))
    .concat([{label:'Rest',color:'var(--text4)'}]);
  let cells='';
  const _wkCell=ds=>`<div class="log-month-wk${isoWeek(ds)===isoWeek(today)&&_mondayOf(ds)===_mondayOf(today)?' now':''}">${isoWeek(ds)}</div>`;
  const _first=`${y}-${String(m+1).padStart(2,'0')}-01`;
  cells+=_wkCell(_first);
  for(let i=0;i<startDow;i++)cells+=`<div class="log-month-day empty"></div>`;
  for(let day=1;day<=lastDay.getDate();day++){
    const ds=`${y}-${String(m+1).padStart(2,'0')}-${String(day).padStart(2,'0')}`;
    if(day>1&&new Date(ds+'T00:00:00').getDay()===1)cells+=_wkCell(ds);
    const sess=sessions.find(s=>s.date===ds);
    const info=getCycleInfo(ds);
    const dt=sess?sess.dayType:getDayType(ds);
    const isToday=ds===today;
    const isRest=dt==='REST'&&!sess;
    const tcf=v4TypeClassFull(dt);
    const hasPR=sess?sessionHasPR(sess):false;
    const onclick=(info.isPre&&!sess)?'':` onclick="showLogDay('${ds}')"`;
    const clsList=['log-month-day'];
    if(isToday)clsList.push('today');
    if(!sess&&!isRest&&ds<today&&!info.isPre&&!info.isVacation&&dt&&dt!=='NONE')clsList.push('missed');
    if(isRest)clsList.push('day-rest');
    else if(tcf!=='rest')clsList.push(tcf);
    if(sess)clsList.push('done');
    else if(!isRest&&ds>=today&&!info.isPre)clsList.push('planned');
    const abbr=dayAbbr(dt);
    cells+=`<div class="${clsList.join(' ')}"${onclick}>
      <div class="log-month-day-num">${day}</div>
      ${abbr&&!isRest?`<div class="log-month-day-type">${abbr}</div>`:''}
      ${sess?`<div class="log-month-day-check">${hasPR?'★':'✓'}</div>`:clsList.includes('missed')?`<div class="log-month-day-check" style="color:var(--red)">×</div>`:''}
    </div>`;
  }
  el.innerHTML=`
    <div class="log-month-nav">
      <button class="log-month-btn" onclick="logMonthDate.setMonth(logMonthDate.getMonth()-1);renderMonthTab()"><svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" fill="none" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg></button>
      <div class="log-month-title">${monthName}</div>
      <button class="log-month-btn" onclick="logMonthDate.setMonth(logMonthDate.getMonth()+1);renderMonthTab()"><svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" fill="none" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg></button>
    </div>
    <div class="log-legend">${legend.map(l=>`<span class="log-legend-item"><span class="log-legend-dot" style="background:${l.color}"></span>${l.label}</span>`).join('')}</div>
    <div class="log-legend" style="margin-top:-4px"><span class="log-legend-item"><span class="lgk lgk-done">✓</span>Done</span><span class="log-legend-item"><span class="lgk lgk-plan"></span>Planned</span><span class="log-legend-item"><span class="lgk lgk-miss">×</span>Missed</span></div>
    <div class="log-month-grid">${dows.map(d=>`<div class="log-month-dow">${d}</div>`).join('')}${cells}</div>`;
}

function renderListTab(){
  const sessions=[...all()].sort((a,b)=>b.date.localeCompare(a.date));
  const el=document.getElementById('log-list-view');if(!el)return;
  if(!sessions.length){el.innerHTML='<div style="padding:32px 16px;text-align:center;font-size:13px;color:var(--text3)">No sessions logged yet.</div>';return;}
  const diffColor={'Very Easy':'var(--green)','Easy':'var(--green)','Moderate':'var(--amber)','Difficult':'var(--orange)','Very Difficult':'var(--red)'};
  let _lastMonth='';
  el.innerHTML=sessions.map(s=>{
    const mk=s.date.slice(0,7);
    const mHead=mk!==_lastMonth?`<div class="eyebrow log-month-head">${new Date(s.date+'T00:00:00').toLocaleDateString('en-GB',{month:'long',year:'numeric'})}</div>`:'';
    _lastMonth=mk;
    const tc=v4TypeClass(s.dayType);
    const hasPR=sessionHasPR(s);
    const vol=calcVolume(s);
    const volStr=vol>0?`${Math.round(vol/100)/10}t`:'';
    const durMin=s.duration?Math.round(s.duration/60):null;
    const fb=s.feedback;
    return `${mHead}<div class="log-list-item" onclick="showDetail('${s.id}')">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px;margin-bottom:6px">
        <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap">
          <span class="v4pill ${tc}">${dayFullLabel(s.dayType)}</span>
          ${hasPR?`<span class="v4pill amber">★ PR</span>`:''}
          ${fb?.difficulty?`<span class="eyebrow" style="color:${diffColor[fb.difficulty]||'var(--text3)'};">${fb.difficulty.toUpperCase()}</span>`:''}
        </div>
        <span class="eyebrow" style="color:var(--text3);white-space:nowrap;flex-shrink:0">${_fmtLong(s.date)}</span>
      </div>
      <div style="font-size:12px;color:var(--text3);margin-bottom:3px;font-family:var(--fm)">${_esc(s.label||'')}</div>
      <div style="font-size:11px;color:var(--text3);font-family:var(--fm)">${s.exercises.length} ex · ${s.exercises.reduce((a,e)=>a+e.sets.length,0)} sets${volStr?` · ${volStr}`:''}${durMin?` · ${durMin}m`:''}</div>
    </div>`;
  }).join('');
}

// Legacy wrapper kept for backward compatibility
function showCalDay(ds){showLogDay(ds);}

function _legacyCalendar() {
  // retired — not called
  const sessions=all();
  const today=todayStr();

  // Streak strip — same calc as Today
  let streak=0;
  for(let i=0;i<60;i++){
    const d=new Date(today+'T00:00:00');d.setDate(d.getDate()-i);
    const ds=`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
    const di=getCycleInfo(ds);
    if(di.dayType==='REST'||di.isPre)continue;
    if(sessions.find(s=>s.date===ds))streak++;
    else if(i>0)break;
  }
  // This month sessions
  const firstOfMonth=new Date(); firstOfMonth.setDate(1);
  const firstMonthStr=`${firstOfMonth.getFullYear()}-${String(firstOfMonth.getMonth()+1).padStart(2,'0')}-01`;
  const monthCount=sessions.filter(s=>s.date>=firstMonthStr).length;
  document.getElementById('cal-streak').innerHTML=`<div class="v4streak">
    <div>
      <div class="v4streak-col-l">STREAK</div>
      <div class="v4streak-col-v" style="color:${streak>0?'var(--accent)':'var(--text)'}">${streak}<sub>days</sub></div>
    </div>
    <div style="text-align:right">
      <div class="v4streak-col-l">THIS MONTH</div>
      <div class="v4streak-col-v">${monthCount}<sub>sessions</sub></div>
    </div>
  </div>`;

  // Walk back 42 days from today, build rows
  const tl=document.getElementById('cal-timeline');
  let html='';
  let lastCycleLabel=null;
  for(let i=0;i<42;i++){
    const d=new Date(today+'T00:00:00');d.setDate(d.getDate()-i);
    const ds=`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
    const info=getCycleInfo(ds);
    const sess=sessions.find(s=>s.date===ds);
    const dt=sess?sess.dayType:getDayType(ds);
    const isToday=ds===today;
    const isFuture=ds>today; // n/a here but safety
    const isRest=dt==='REST'&&!sess;
    const isPre=info.isPre;
    // Cycle divider — when cycle label changes going DOWN (older)
    if(!isPre&&info.cycleLabel!==lastCycleLabel&&lastCycleLabel!==null){
      html+=`<div class="v4tl-divider"><hr/><span>${lastCycleLabel} BEGINS</span><hr/></div>`;
    }
    lastCycleLabel=isPre?lastCycleLabel:info.cycleLabel;

    const dayShort=d.toLocaleDateString('en-GB',{weekday:'short'}).toUpperCase();
    const dayNum=String(d.getDate()).padStart(2,'0');
    const monShort=d.toLocaleDateString('en-GB',{month:'short'}).toUpperCase();
    const tc=v4TypeClass(dt);
    const cyclePart=isPre?'PREP':info.label;
    const tagText=(()=>{
      if(isPre)return 'PREP';
      if(isRest)return 'REST';
      return dayCategory(dt)||dt.split(' ')[0];
    })();
    const stats=sess
      ? (()=>{
          const setCount=sess.exercises.reduce((a,e)=>a+e.sets.length,0);
          const vol=Math.round(calcVolume(sess)/100)/10; // tonnes 1dp
          const pr=sessionHasPR(sess);
          return `${sess.exercises.length} ex · ${setCount} sets${vol?` · ${vol}t`:''}${pr?' · <em>★ PR</em>':''}`;
        })()
      : (isToday?'today · planned':(isRest?'':'no session'));

    const labelName=sess?sess.label:(isPre?'Prep period':(isRest?'Rest day':dt));
    const onclick=isPre?'':`onclick="showCalDay('${ds}')"`;
    html+=`<div class="v4tl-row ${tc} ${isToday?'today':''} ${isRest?'rest':''}" ${onclick}>
      <div class="v4tl-date">
        <div class="v4tl-day">${dayShort}</div>
        <div class="v4tl-num">${dayNum}</div>
        <div class="v4tl-mon">${monShort}</div>
      </div>
      <div class="v4tl-bar"></div>
      <div class="v4tl-body">
        <div class="v4tl-tags">
          <span class="v4pill ${tc}">${tagText}</span>
          <span class="eyebrow" style="color:var(--text3)">${cyclePart}</span>
          ${isToday?`<span class="v4pill accent">● NOW</span>`:''}
        </div>
        <div class="v4tl-name">${labelName}</div>
        ${stats?`<div class="v4tl-stats">${stats}</div>`:''}
      </div>
    </div>`;
  }
  tl.innerHTML=html;
}

// showCalDay now handled by showLogDay (legacy alias defined above)

// ── CALENDAR DAY OVERRIDES ────────────────────────────────────────────────

async function saveDayOverrides() {
  localStorage.setItem('tr-day-ov-v1',JSON.stringify(DAY_OVERRIDES));
  if(!fbReady||!db)return;
  const tid=trainerId();
  try{await db.doc(`trainers/${tid}/meta`).set({dayOverrides:DAY_OVERRIDES},{merge:true});}catch(e){}
}

let _overrideTargetDate='';

function openDayOverrideSheet(ds) {
  _overrideTargetDate=ds;
  document.getElementById('day-override-title').textContent='Plan for '+ds;
  const cycle=activeCycle();
  const hasOverride=DAY_OVERRIDES.hasOwnProperty(ds);
  const isAlreadyRest=getDayType(ds)==='REST';
  let html=`<div style="padding:8px 16px 4px"><button onclick="setDayOverride('${ds}','REST')" style="width:100%;padding:13px;background:${isAlreadyRest?'rgba(74,222,128,.1)':'var(--bg3)'};color:${isAlreadyRest?'var(--green)':'var(--text2)'};font-family:var(--fb);font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;border:1px solid ${isAlreadyRest?'var(--green)':'var(--border)'};border-radius:12px;cursor:pointer">😴 Rest Day${isAlreadyRest?' ✓':''}</button></div>
  <div class="sglbl" style="margin-top:4px">From program</div>`;
  // All program day types from the active cycle (unique)
  const seen=new Set();
  cycle.forEach(({dayType,label})=>{
    if(seen.has(dayType))return; seen.add(dayType);
    const col=TYPE_COLOR[dayType]||'var(--text3)';
    const current=getDayType(ds);
    const isCur=current===dayType;
    html+=`<div class="sitem" onclick="setDayOverride('${ds}','${dayType.replace(/'/g,"\\'")}')">
      <div><div class="sitem-name" style="${isCur?'color:var(--green);font-weight:700':''}">${label||DAY_FULL_NAMES[dayType]||dayType}</div></div>
      ${isCur?'<div class="schk"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></div>':'<div style="width:8px;height:8px;border-radius:50%;background:'+col+';flex-shrink:0;margin-right:4px"></div>'}
    </div>`;
  });
  // No workout / clear
  html+=`<div class="sitem" onclick="setDayOverride('${ds}','NONE')">
    <div><div class="sitem-name" style="${getDayType(ds)==='NONE'?'color:var(--green);font-weight:700':''}">— No workout planned</div></div>
    ${getDayType(ds)==='NONE'?'<div class="schk"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></div>':''}
  </div>`;
  // Quick custom presets
  const presets=['Mobility','Stretching','Home Training','Active Recovery','Cardio','Yoga'];
  const cur=getDayType(ds)||'';
  html+=`<div class="sglbl" style="margin-top:4px">Custom</div>
  <div style="display:flex;flex-wrap:wrap;gap:6px;padding:8px 16px 10px">
    ${presets.map(p=>`<button onclick="setDayOverride('${ds}','${p}')" style="padding:7px 12px;border-radius:8px;font-family:var(--fb);font-size:10px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;cursor:pointer;border:1px solid ${cur===p?'var(--accent)':'var(--border)'};background:${cur===p?'rgba(212,255,58,.12)':'var(--bg3)'};color:${cur===p?'var(--accent)':'var(--text2)'}">${p}</button>`).join('')}
  </div>
  <div style="padding:0 16px 8px;display:flex;gap:8px;align-items:center">
    <input id="override-custom-input" type="text" placeholder="Type your own…" style="flex:1;padding:10px 12px;background:var(--bg3);border:1px solid var(--border);border-radius:8px;color:var(--text);font-family:inherit;font-size:13px;outline:none" value="${!['REST','NONE',...presets,...cycle.map(c=>c.dayType)].includes(cur)&&cur?cur:''}">
    <button onclick="saveCustomOverride('${ds}')" style="padding:10px 16px;background:var(--text);color:var(--bg);border:none;border-radius:8px;font-family:var(--fb);font-size:11px;font-weight:700;letter-spacing:.06em;cursor:pointer">Set</button>
  </div>`;
  if(hasOverride){
    html+=`<div style="padding:4px 16px 6px"><button onclick="clearDayOverride('${ds}')" style="width:100%;padding:11px;background:none;border:1px solid var(--border);border-radius:10px;color:var(--text3);font-family:inherit;font-size:13px;cursor:pointer">↺ Reset to cycle default</button></div>`;
  }
  document.getElementById('day-override-list').innerHTML=html;
  document.getElementById('day-override-sheet').classList.add('open');
}

function closeDayOverrideSheet(){document.getElementById('day-override-sheet').classList.remove('open');}

function setDayOverride(ds, dayType) {
  closeDayOverrideSheet();
  DAY_OVERRIDES[ds]=dayType;
  saveDayOverrides();
  refreshActiveView();
  if(document.getElementById('view-calendar')?.classList.contains('active'))showCalDay(ds);
}

function saveCustomOverride(ds) {
  const val=document.getElementById('override-custom-input')?.value.trim();
  if(!val)return;
  setDayOverride(ds, val);
}

function clearDayOverride(ds) {
  closeDayOverrideSheet();
  delete DAY_OVERRIDES[ds];
  saveDayOverrides();
  renderCalendar();
  showCalDay(ds);
}
const CYCLE_ORDER = [
  {idx:'D2',dayType:'PUSH (Hypertrophy)',dayNum:'Day 2'},
  {idx:'D3',dayType:'LEGS (Strength)',dayNum:'Day 3'},
  {idx:'D4',dayType:'REST',dayNum:'Day 4'},
  {idx:'D5',dayType:'PULL',dayNum:'Day 5'},
  {idx:'D6',dayType:'REST',dayNum:'Day 6'},
  {idx:'D7',dayType:'PUSH (Strength)',dayNum:'Day 7'},
  {idx:'D8',dayType:'LEGS (Hypertrophy)',dayNum:'Day 8'},
  {idx:'D1',dayType:'REST',dayNum:'Day 1'},
];

function renderProgram() {
  const cycle=_getEditCycle();
  const plan=_getEditPlan();
  const isCustomProg=!!_editProgId;
  const customProg=isCustomProg?PROGRAMS.find(p=>p.id===_editProgId):null;
  const inner=document.getElementById('program-inner');
  const sub=document.getElementById('prog-subtitle');
  if(sub)sub.textContent=cycle.length+'-day cycle'+(customProg?' · '+customProg.name+' exercises':' · tap to expand & edit');
  // Sort by day number (D1 first, then D2…D8) for display
  const displayCycle=isCustomProg?cycle:[...cycle].sort((a,b)=>parseInt(a.idx.slice(1))-parseInt(b.idx.slice(1)));
  inner.innerHTML=displayCycle.map(({idx,dayType,label},di)=>{
    const col=TYPE_COLOR[dayType]||'var(--border)';
    const tcf=v4TypeClassFull(dayType);
    const groups=plan[dayType]||[];
    const allEx=groups.flatMap(g=>g.ex);
    const isRest=dayType==='REST';
    const dtSafe=dayType.replace(/'/g,"\\'");
    const canUp=di>0, canDown=di<displayCycle.length-1;
    const abbr=isRest?'REST':dayAbbr(dayType);
    const pillColors={push:'rgba(96,165,250,',legs:'rgba(251,146,60,','push-s':'rgba(167,139,250,',pull:'rgba(74,222,128,','legs-h':'rgba(251,191,36,',rest:'rgba(100,100,100,'};
    const pc=pillColors[tcf]||'rgba(100,100,100,';
    return `<div class="cycle-day" style="border-left-color:${col}">
      <div class="cycle-day-hdr" onclick="toggleProgDay('${dayType}')">
        <div class="cdh-left">
          <div class="cd-pill" style="background:${pc}.15);color:${pc}1)">${idx}</div>
          <div>
            <div class="cd-title">${label||DAY_FULL_NAMES[dayType]||dayType}</div>
            <div class="cd-sub">${isRest?'Rest day':`${allEx.length} exercise${allEx.length!==1?'s':''}`}</div>
          </div>
        </div>
        <div class="prog-day-btns">
          ${!isCustomProg?`
          <button class="pdbn" onclick="event.stopPropagation();moveProgDay('${dtSafe}','up')" ${!canUp?'style="opacity:.2;pointer-events:none"':''}>↑</button>
          <button class="pdbn" onclick="event.stopPropagation();moveProgDay('${dtSafe}','down')" ${!canDown?'style="opacity:.2;pointer-events:none"':''}>↓</button>
          <button class="pdbn" onclick="event.stopPropagation();renameProgDay('${dtSafe}')">✏</button>
          <button class="pdbn" onclick="event.stopPropagation();deleteProgDay('${dtSafe}')" style="color:var(--red)">✕</button>`:''}
          <div class="arrow" id="prog-arrow-${dayType.replace(/[\s()]/g,'_')}">›</div>
        </div>
      </div>
      <div class="cd-body" id="prog-body-${dayType.replace(/[\s()]/g,'_')}">
        ${isRest?`<div style="color:var(--text3);font-size:12px;padding:4px 0;font-family:var(--fb);letter-spacing:.02em">Rest day — no exercises planned.</div>`
          :renderProgGroups(dayType)}
        ${!isRest?`<button class="add-ex-to-day" onclick="openProgSheet('${dtSafe}')">+ Add exercise</button>`:''}
      </div>
    </div>`;
  }).join('')+(isCustomProg?'':
    `<button onclick="addProgDay()" style="width:100%;margin-top:8px;padding:14px;background:transparent;border:1px dashed var(--border);border-radius:14px;color:var(--text3);font-family:var(--fb);font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;cursor:pointer">+ Add training day</button>`);
}

function renderProgGroups(dayType) {
  const groups=_getEditPlan()[dayType]||[];
  if(!groups.length)return`<div style="color:var(--text3);font-size:13px">No exercises yet</div>`;
  const flat=groups.flatMap(g=>g.ex);
  const prog=_editProgId?PROGRAMS.find(p=>p.id===_editProgId):null;
  const planMeta=prog?.planMeta||{};
  return flat.map((nm,fi)=>{
    const safe=nm.replace(/'/g,"\\'");
    const dtSafe=dayType.replace(/'/g,"\\'");
    const meta=planMeta[dayType]?.[nm];
    const setsLbl=meta?(meta.sets+'×'+(meta.minReps===meta.maxReps?meta.maxReps:meta.minReps+'–'+meta.maxReps)):'3×?';
    return `<div class="cd-ex-row">
      <div style="display:flex;align-items:center;gap:6px;flex:1;min-width:0">
        <div style="display:flex;flex-direction:column;gap:1px;flex-shrink:0">
          <button class="ex-mv" onclick="moveExInPlan('${dtSafe}','${safe}','up')" ${fi===0?'style="opacity:.2;pointer-events:none"':''}>▲</button>
          <button class="ex-mv" onclick="moveExInPlan('${dtSafe}','${safe}','down')" ${fi===flat.length-1?'style="opacity:.2;pointer-events:none"':''}>▼</button>
        </div>
        <div style="flex:1;min-width:0">
          <div class="cd-ex-name">${nm}</div>
        </div>
        <button onclick="editExTarget('${dtSafe}','${safe}')" style="font-size:11px;font-weight:700;color:var(--accent);background:rgba(212,255,58,.1);border:1px solid rgba(212,255,58,.25);border-radius:8px;padding:3px 8px;cursor:pointer;flex-shrink:0;font-family:var(--fm)">${setsLbl}</button>
      </div>
      <button class="rmex-btn" onclick="removeExFromPlan('${dtSafe}','${safe}')">−</button>
    </div>`;
  }).join('');
}

function editExTarget(dayType, exName) {
  const prog=_editProgId?PROGRAMS.find(p=>p.id===_editProgId):null;
  if(!prog)return;
  if(!prog.planMeta)prog.planMeta={};
  if(!prog.planMeta[dayType])prog.planMeta[dayType]={};
  const cur=prog.planMeta[dayType][exName]||{sets:3,minReps:8,maxReps:12};
  const val=prompt(`${exName}\nFormat: sets × minReps–maxReps\nExamples: 3×8-12  or  2×10-15  or  3×12`,`${cur.sets}×${cur.minReps}-${cur.maxReps}`);
  if(!val)return;
  const m=val.match(/(\d+)\s*[×x]\s*(\d+)\s*[-–]\s*(\d+)/)||val.match(/(\d+)\s*[×x]\s*(\d+)/);
  if(!m){alert('Format: 3×8-12');return;}
  prog.planMeta[dayType][exName]={sets:parseInt(m[1]),minReps:parseInt(m[2]),maxReps:parseInt(m[3]||m[2])};
  savePrograms();
  const key=dayType.replace(/[\s()]/g,'_');
  renderProgram();
  document.getElementById(`prog-body-${key}`)?.classList.add('open');
  if(document.getElementById(`prog-arrow-${key}`))document.getElementById(`prog-arrow-${key}`).textContent='∨';
}


function toggleProgDay(dayType) {
  const key=dayType.replace(/[\s()]/g,'_');
  const body=document.getElementById(`prog-body-${key}`);
  const arrow=document.getElementById(`prog-arrow-${key}`);
  const open=body.classList.toggle('open');
  if(arrow)arrow.textContent=open?'∨':'›';
}

function removeExFromPlan(dayType, exName) {
  if(!confirm(`Remove "${exName}" from ${dayType}?`))return;
  const plan=_getEditPlan();
  const groups=plan[dayType];if(!groups)return;
  groups.forEach(g=>g.ex=g.ex.filter(e=>e!==exName));
  // Also remove from planMeta
  if(_editProgId){const prog=PROGRAMS.find(p=>p.id===_editProgId);if(prog?.planMeta?.[dayType])delete prog.planMeta[dayType][exName];}
  _saveEditPlan();renderProgram();
  // Reopen the group that was open
  const key=dayType.replace(/[\s()]/g,'_');
  document.getElementById(`prog-body-${key}`)?.classList.add('open');
  document.getElementById(`prog-arrow-${key}`)&&(document.getElementById(`prog-arrow-${key}`).textContent='∨');
}

let progSheetDayType='';
function openProgSheet(dayType) {
  progSheetDayType=dayType;
  document.getElementById('prog-sheet-title').textContent=`Add to ${dayType}`;
  document.getElementById('prog-sheet-search').value='';filterProgSheet('');
  document.getElementById('prog-sheet').classList.add('open');
  setTimeout(()=>document.getElementById('prog-sheet-search').focus(),100);
}
function closeProgSheet(){document.getElementById('prog-sheet').classList.remove('open');}

function filterProgSheet(v) {
  const existing=new Set((_getEditPlan()[progSheetDayType]||[]).flatMap(g=>g.ex));
  const allKnown=new Set([
    ...Object.values(DEFAULT_PLAN).flatMap(gs=>gs.flatMap(g=>g.ex)),
    ...EX_LIBRARY.map(e=>e.name)
  ]);
  const filtered=[...allKnown].filter(n=>(!v||n.toLowerCase().includes(v.toLowerCase()))&&!existing.has(n)).sort();
  let html=filtered.map(n=>{
    const tb=isTimeBased(n);
    return `<div class="sitem" onclick="addExToPlan('${n.replace(/'/g,"\\'")}')"><div class="sitem-name">${n}${tb?'<span class="tbadge-ex">TIME</span>':''}</div></div>`;
  }).join('');
  if(v&&![...allKnown].some(n=>n.toLowerCase()===v.toLowerCase()&&!existing.has(n))){
    html+=`<div class="sitem" onclick="addExToPlan('${v.replace(/'/g,"\\'")}',true)"><div><div class="sitem-name">+ "${v}"</div><div class="sitem-sub">Add new exercise</div></div></div>`;
  }
  document.getElementById('prog-sheet-list').innerHTML=html||`<div style="padding:20px;text-align:center;color:var(--text3)">All exercises already added</div>`;
}

function addExToPlan(name, isNew=false) {
  const plan=_getEditPlan();
  closeProgSheet();
  if(!plan[progSheetDayType])plan[progSheetDayType]=[{g:'Custom',ex:[]}];
  let customGroup=plan[progSheetDayType].find(g=>g.g==='Custom');
  if(!customGroup){customGroup={g:'Custom',ex:[]};plan[progSheetDayType].push(customGroup);}
  if(!customGroup.ex.includes(name))customGroup.ex.push(name);
  ensureInLibrary(name);
  _saveEditPlan();renderProgram();
  // Reopen
  const key=progSheetDayType.replace(/[\s()]/g,'_');
  document.getElementById(`prog-body-${key}`)?.classList.add('open');
  if(document.getElementById(`prog-arrow-${key}`))document.getElementById(`prog-arrow-${key}`).textContent='∨';
}

// ── PROGRAM CUSTOMIZATION ─────────────────────────────────────────────────

function activeCycle() {
  if(CUSTOM_CYCLE) return CUSTOM_CYCLE;
  return CYCLE_ORDER.map(c=>({idx:c.idx, dayType:c.dayType, label:DAY_FULL_NAMES[c.dayType]||c.dayType}));
}

async function saveCycle() {
  localStorage.setItem('tr-cycle-v1',JSON.stringify(CUSTOM_CYCLE));
  if(!fbReady||!db)return;
  const tid=trainerId();
  try{await db.doc(`trainers/${tid}/meta`).set({cycle:CUSTOM_CYCLE},{merge:true});}catch(e){}
}

async function resetCycleToDefault() {
  if(!confirm('Reset Normal Training to the default 8-day cycle? Your sessions and exercises are kept — only the cycle structure resets.'))return;
  CUSTOM_CYCLE=null;
  localStorage.removeItem('tr-cycle-v1');
  if(fbReady&&db){
    const tid=trainerId();
    try{await db.doc(`trainers/${tid}/meta`).set({cycle:null},{merge:true});}catch(e){}
  }
  renderProgram();
  refreshActiveView();
}

function reopenProgDay(dayType) {
  renderProgram();
  const key=dayType.replace(/[\s()]/g,'_');
  document.getElementById(`prog-body-${key}`)?.classList.add('open');
  const arr=document.getElementById(`prog-arrow-${key}`);
  if(arr)arr.textContent='∨';
}

function renameProgDay(dayType) {
  if(!CUSTOM_CYCLE) CUSTOM_CYCLE=activeCycle();
  const entry=CUSTOM_CYCLE.find(c=>c.dayType===dayType);
  if(!entry)return;
  const name=prompt('Rename day:',entry.label||DAY_FULL_NAMES[dayType]||dayType);
  if(!name||!name.trim())return;
  entry.label=name.trim();
  saveCycle();renderProgram();
}

function deleteProgDay(dayType) {
  if(!CUSTOM_CYCLE) CUSTOM_CYCLE=activeCycle();
  const entry=CUSTOM_CYCLE.find(c=>c.dayType===dayType);
  if(!confirm(`Delete "${entry?.label||dayType}" from your cycle?\n\nExercises are removed from the schedule but session history is kept.`))return;
  CUSTOM_CYCLE=CUSTOM_CYCLE.filter(c=>c.dayType!==dayType);
  saveCycle();renderProgram();
}

function addProgDay() {
  const name=prompt('Day name (e.g. Push, Pull, Legs, Rest):','');
  if(!name||!name.trim())return;
  if(!CUSTOM_CYCLE) CUSTOM_CYCLE=activeCycle();
  const label=name.trim();
  const dayType='DAY_'+Date.now();
  CUSTOM_CYCLE.push({idx:'D'+(CUSTOM_CYCLE.length+1), dayType, label});
  PLAN[dayType]=[];
  saveCycle();saveMeta();renderProgram();
}

function moveProgDay(dayType, dir) {
  if(!CUSTOM_CYCLE) CUSTOM_CYCLE=activeCycle();
  const i=CUSTOM_CYCLE.findIndex(c=>c.dayType===dayType);
  if(i<0)return;
  const ni=dir==='up'?i-1:i+1;
  if(ni<0||ni>=CUSTOM_CYCLE.length)return;
  [CUSTOM_CYCLE[i],CUSTOM_CYCLE[ni]]=[CUSTOM_CYCLE[ni],CUSTOM_CYCLE[i]];
  saveCycle();renderProgram();
}

function moveExInPlan(dayType, exName, dir) {
  const plan=_getEditPlan();
  const groups=plan[dayType];if(!groups)return;
  const flat=groups.flatMap(g=>g.ex);
  const i=flat.indexOf(exName);
  if(i<0)return;
  const ni=dir==='up'?i-1:i+1;
  if(ni<0||ni>=flat.length)return;
  [flat[i],flat[ni]]=[flat[ni],flat[i]];
  plan[dayType]=[{g:'Exercises',ex:flat}];
  _saveEditPlan();reopenProgDay(dayType);
}

// ── DETAIL ─────────────────────────────────────────────────────────────────
function showDetail(id) {
  const s=all().find(x=>x.id===id);if(!s)return;
  currentDetailId=id;
  const isEditable=US.some(x=>x.id===id);
  document.getElementById('detail-edit-btn').style.display=isEditable?'':'none';
  const col=TYPE_COLOR[s.dayType]||'#666';
  const dayName=DAY_FULL_NAMES[s.dayType]||s.dayType||'Session';
  document.getElementById('detail-title').textContent=dayName;
  const totalSets=s.exercises.reduce((a,e)=>a+e.sets.filter(st=>!st.wu).length,0);
  const totalVol=calcVolume(s);
  const durMin=s.duration?Math.round(s.duration/60):null;
  const diffColor={'Very Easy':'var(--green)','Easy':'var(--green)','Moderate':'var(--amber)','Difficult':'var(--orange)','Very Difficult':'var(--red)'};
  const fb=s.feedback;
  const fbHtml=fb?`<div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:10px">
    ${fb.difficulty?`<span style="font-size:12px;font-weight:700;padding:3px 10px;border-radius:20px;background:${diffColor[fb.difficulty]||'#666'}18;color:${diffColor[fb.difficulty]||'#666'};border:1px solid ${diffColor[fb.difficulty]||'#666'}33">${fb.difficulty}</span>`:''}
    ${fb.comment?`<span style="font-size:13px;color:var(--text2)">${_esc(fb.comment)}</span>`:''}
  </div>`:'';
  const prCount=s.exercises.filter(ex=>exSessions(ex.name).some(e=>e.id===s.id&&e.isPR)).length;
  let html=`<div style="margin-bottom:18px">
    <div style="font-size:22px;font-weight:700;margin-bottom:4px;color:${col}">${_esc(dayName)}</div>
    <div style="font-size:13px;color:var(--text2);margin-bottom:2px">${_fmtLong(s.date)}</div>
    <div style="font-size:11px;color:var(--text3);margin-bottom:12px;font-family:var(--fm)">${_esc(s.label||'')}</div>
    <div class="pg-tiles" style="grid-template-columns:repeat(4,minmax(0,1fr));margin-top:0">
      <div class="pg-tile"><div class="v" style="font-size:15px">${s.exercises.length}</div><div class="eyebrow">Exercises</div></div>
      <div class="pg-tile"><div class="v" style="font-size:15px">${totalSets}</div><div class="eyebrow">Sets</div></div>
      <div class="pg-tile"><div class="v" style="font-size:15px">${totalVol>0?(totalVol/1000).toFixed(1)+'t':'—'}</div><div class="eyebrow">Volume</div></div>
      <div class="pg-tile"><div class="v" style="font-size:15px;color:${prCount?'var(--amber)':'var(--text)'}">${durMin?durMin+'m':prCount?'★'+prCount:'—'}</div><div class="eyebrow">${durMin?'Duration':'PRs'}</div></div>
    </div>
    ${fbHtml}
    ${s.notes?`<div style="margin-top:12px;background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:10px 12px;font-size:13px;color:var(--text2)">📝 ${_esc(s.notes)}</div>`:''}
  </div>`;
  if(s.dayType&&s.dayType!=='REST'){
    const planned=[...new Set(getActivePlanEx(s.dayType,s.date).flatMap(g=>g.ex))];
    if(planned.length){
      const loggedNames=new Set(s.exercises.map(e=>e.name));
      const missed=planned.filter(n=>!loggedNames.has(n));
      const added=s.exercises.map(e=>e.name).filter(n=>!planned.includes(n));
      if(missed.length||added.length){
        html+=`<div style="background:var(--bg2);border-radius:12px;border:1px solid var(--border);padding:12px 14px;margin-bottom:12px;font-size:12px">
          <div style="font-size:10px;font-weight:700;color:var(--text3);text-transform:uppercase;letter-spacing:.07em;margin-bottom:8px">Planned vs actual</div>
          ${missed.length?`<div style="color:var(--text3);margin-bottom:4px">⏭ Skipped: <span style="color:var(--text2)">${missed.map(n=>_esc(_shortName(n))).join(', ')}</span></div>`:''}
          ${added.length?`<div style="color:var(--text3)">➕ Added: <span style="color:var(--green)">${added.map(n=>_esc(_shortName(n))).join(', ')}</span></div>`:''}
        </div>`;
      }
    }
  }
  s.exercises.forEach(ex=>{
    const kind=exKind(ex.name);
    const hist=exSessions(ex.name);
    const idx=hist.findIndex(e=>e.id===s.id);
    const me=idx>=0?hist[idx]:null, prev=idx>0?hist[idx-1]:null;
    const prBadge=me&&me.isPR?` <span style="font-size:11px;color:var(--amber);font-weight:700">★ PR</span>`:'';
    const cmp=prev?(me.score>prev.score+1e-9?'var(--green)':me.score<prev.score-1e-9?'var(--red)':'var(--text3)'):'var(--text3)';
    html+=`<div class="dex" onclick="closeDetail();openLift('${_jsq(ex.name)}')" style="cursor:pointer">
      <div class="dex-name">${_esc(ex.name)}${ex.note?' ⚠️':''}${prBadge}</div>
      <div class="dsets">${ex.sets.map((st,i)=>`<div class="dset" style="${st.wu?'opacity:.5;font-style:italic':''}">${st.wu?'W':i+1-ex.sets.slice(0,i).filter(x=>x.wu).length}: ${_esc(setText(kind,st))}</div>`).join('')}</div>
      ${prev?`<div style="font-size:11px;color:${cmp};margin-top:6px;font-family:var(--fm)">last time (${_fmtShort(prev.date)}): ${_esc(prev.txt)}</div>`:''}
    </div>`;
  });
  document.getElementById('detail-inner').innerHTML=html;
  document.getElementById('detail-sheet').classList.add('open');
}
function closeDetail(){document.getElementById('detail-sheet').classList.remove('open');}

function repeatSession(id) {
  const s=all().find(x=>x.id===id);if(!s)return;
  if(activeWorkout&&!confirm('You have an active workout. Replace it?'))return;
  closeDetail();
  if(activeWorkout){closeWk();}
  const date=todayStr();
  const info=getCycleInfo(date);
  activeWorkout={
    date,label:info.label||s.label||'Custom',cycle:info.cycleLabel||'Custom',
    dayType:s.dayType,startedAt:Date.now(),
    exercises:s.exercises.map(ex=>({name:ex.name,sets:buildSets(ex.name,date,s.dayType)}))
  };
  persistWorkout();
  document.getElementById('wk-title').textContent=DAY_FULL_NAMES[s.dayType]||s.dayType;
  document.getElementById('wk-sub').textContent=info.label||date;
  renderWkEx();
  document.getElementById('workout-view').classList.add('open');
  hidePill();
  clearInterval(wkInterval);
  wkInterval=setInterval(()=>{
    const e=Math.floor((Date.now()-activeWorkout.startedAt)/1000);
    const t=`${Math.floor(e/60)}:${String(e%60).padStart(2,'0')}`;
    document.getElementById('wk-timer').textContent=t;
    const p=document.getElementById('wk-pill-timer');if(p)p.textContent=t;
    if(e%30===0)persistWorkout();
  },1000);
}

// ── PROGRESS ───────────────────────────────────────────────────────────────
// ── DATE HELPERS (local time, never UTC) ──────────────────────────────────
function _ymd(d){return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;}
function _addDays(ds,n){const d=new Date(ds+'T00:00:00');d.setDate(d.getDate()+n);return _ymd(d);}
function _mondayOf(ds){const d=new Date(ds+'T00:00:00');d.setDate(d.getDate()-((d.getDay()+6)%7));return _ymd(d);}
function isoWeek(ds){const d=new Date(ds+'T00:00:00');const t=new Date(Date.UTC(d.getFullYear(),d.getMonth(),d.getDate()));const dn=t.getUTCDay()||7;t.setUTCDate(t.getUTCDate()+4-dn);const y=t.getUTCFullYear();return Math.ceil(((t-Date.UTC(y,0,1))/86400000+1)/7);}
function _fmtShort(ds){const d=new Date(ds+'T00:00:00');return d.getDate()+' '+_MON[d.getMonth()];}
function _esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
function _jsq(s){return String(s).replace(/\\/g,'\\\\').replace(/'/g,"\\'");}

// ── PERFORMANCE ENGINE (one scoring rule for PRs everywhere) ─────────────────
// load lifts: estimated 1RM (Epley) · bodyweight lifts: bodyweight + added kg, then 1RM · timed: seconds
function latestBodyweight(){ return (BW_LOG&&BW_LOG.length)?BW_LOG[BW_LOG.length-1].w:((PROFILE&&PROFILE.weight)||0); }
function exKind(name){
  if(isTimeBased(name)) return 'time';
  if(/\(Bodyweight/.test(name)) return 'bw';
  return 'load';
}
function e1rm(w,r){ w=+w||0; r=+r||0; if(w<=0||r<=0) return 0; return w*(1+Math.min(r,20)/30); }
function _bwRef(){ return latestBodyweight()||75; }
function setScore(kind,s){
  const r=+s.r||0, w=+s.w||0;
  if(kind==='time') return r;
  if(kind==='bw') return r>0?e1rm(_bwRef()+w,r):0;
  return e1rm(w,r);
}
function setText(kind,s){
  const r=+s.r||0, w=+s.w||0;
  if(kind==='time') return r+'s';
  if(kind==='bw') return (w>0?'+'+w+'kg':'BW')+' × '+r;
  return w+' × '+r;
}
// "65 × 8/8/7" when the weight is the same on every set
function setsText(kind,sets){
  if(!sets.length) return '';
  if(kind==='time') return sets.map(s=>(+s.r||0)+'s').join(' / ');
  const ws=[...new Set(sets.map(s=>+s.w||0))];
  if(ws.length===1){
    const w=ws[0], reps=sets.map(s=>+s.r||0).join('/');
    if(kind==='bw') return (w>0?'+'+w+'kg':'BW')+' × '+reps;
    return w+' × '+reps;
  }
  return sets.map(s=>setText(kind,s)).join(', ');
}

let _exSessCache={}, _exSessSig='';
function _exSig(){ return H.length+'|'+US.length+'|'+(US.length?US[US.length-1].id:'')+'|'+(BW_LOG?BW_LOG.length:0)+'|'+EX_LIBRARY.length; }
function exSessions(name){
  const sig=_exSig();
  if(sig!==_exSessSig){ _exSessCache={}; _exSessSig=sig; }
  if(_exSessCache[name]) return _exSessCache[name];
  const kind=exKind(name), out=[]; let runBest=0;
  all().forEach(s=>{
    const ex=(s.exercises||[]).find(e=>e.name===name); if(!ex) return;
    const sets=(ex.sets||[]).filter(st=>!st.wu&&((+st.r||0)>0||(+st.w||0)>0));
    if(!sets.length) return;
    let best=sets[0], bestSc=-1, topW=0;
    sets.forEach(st=>{ const sc=setScore(kind,st); if(sc>bestSc){bestSc=sc;best=st;} if((+st.w||0)>topW) topW=+st.w; });
    const isPR=runBest>0&&bestSc>runBest+1e-9;
    out.push({id:s.id,date:s.date,label:s.label,dayType:s.dayType,sets,best,score:bestSc,topW,isPR,kind,txt:setsText(kind,sets)});
    runBest=Math.max(runBest,bestSc);
  });
  _exSessCache[name]=out;
  return out;
}
function exBest(name){ const h=exSessions(name); if(!h.length) return null; return h.reduce((b,e)=>e.score>b.score?e:b,h[0]); }
function allRecentPRs(fromDate){
  const out=[];
  allExNames().forEach(nm=>exSessions(nm).forEach(e=>{ if(e.isPR&&(!fromDate||e.date>=fromDate)) out.push({name:nm,...e}); }));
  return out.sort((a,b)=>b.date.localeCompare(a.date));
}
function countPRs(fromDate){ return allRecentPRs(fromDate).length; }

// ── PROGRAM BLOCK ───────────────────────────────────────────────────────────
function activeBlock(dateStr){
  const c=_getActiveCustomProgram(dateStr||todayStr()); if(!c) return null;
  return {prog:c.prog, entry:c.entry, start:c.entry.startDate, end:c.prog.endDate||null, phases:c.prog.phases||[]};
}
function phaseOn(dateStr){ const b=activeBlock(dateStr); if(!b) return null; return b.phases.find(p=>dateStr>=p.start&&dateStr<=p.end)||null; }
function _inDeload(prog,ds){ return (prog?.phases||[]).some(p=>p.type==='deload'&&ds>=p.start&&ds<=p.end); }
function cycleFor(dateStr){
  const c=_getActiveCustomProgram(dateStr||todayStr());
  if(c) return c.prog.cyclePattern.map((dt,i)=>({idx:'D'+(i+1),dayType:dt,label:DAY_FULL_NAMES[dt]||dt}));
  return activeCycle();
}
function progStep(name){ return /Back Squat|Romanian Deadlift/i.test(name)?5:2.5; }
// Progression rule: when every working set reaches the top of the rep range → add the smallest jump
function progressionFor(name, prog, dt){
  const meta=prog?.planMeta?.[dt]?.[name]; if(!meta||!meta.maxReps) return null;
  const kind=exKind(name); if(kind==='time') return null;
  const hist=exSessions(name).filter(e=>!_inDeload(prog,e.date));
  if(!hist.length) return null;
  const last=hist[hist.length-1];
  const need=meta.sets||3;
  const ready=last.sets.length>=need&&last.sets.every(st=>(+st.r||0)>=meta.maxReps);
  const w=last.topW||0;
  return {ready,last,meta,w,next:ready?+(w+progStep(name)).toFixed(1):w,kind};
}
function stalledInfo(name, prog){
  const h=exSessions(name).filter(e=>!_inDeload(prog,e.date));
  if(h.length<4) return null;
  const last3=h.slice(-3), before=Math.max(...h.slice(0,-3).map(e=>e.score));
  return Math.max(...last3.map(e=>e.score))<=before+1e-9 ? h[h.length-1] : null;
}
function muscleOf(name){
  const n=name.toLowerCase();
  if(/wall sit|squat|lunge|leg press|leg curl|leg extension|deadlift|rdl|calf|hip thrust|step-up/.test(n)) return 'Legs';
  if(/knee raise|leg raise|plank|crunch|ab rollout|ab wheel|l-sit|sit-up/.test(n)) return 'Core';
  if(/rear-delt|rear delt|lateral|overhead press|pike|arnold|front raise|upright|face pull/.test(n)) return 'Shoulders';
  if(/curl|tricep|pushdown|skull/.test(n)) return 'Arms';
  if(/row|pull-up|pull up|chin|pulldown|dead hang/.test(n)) return 'Back';
  if(/bench|incline|chest|fly|push-up|dip|press/.test(n)) return 'Chest';
  return 'Other';
}
function weeklySetsByMuscle(days){
  const from=_addDays(todayStr(),-(days-1)), m={};
  all().filter(s=>s.date>=from&&s.date<=todayStr()&&s.dayType!=='REST').forEach(s=>(s.exercises||[]).forEach(ex=>{
    const n=(ex.sets||[]).filter(st=>!st.wu).length; if(!n) return;
    const g=muscleOf(ex.name); m[g]=(m[g]||0)+n;
  }));
  Object.keys(m).forEach(k=>m[k]=m[k]/(days/7));
  return m;
}
function _progExercises(prog){
  // [{dt, label, ex:[names]}] in cycle order
  const seen=new Set(), out=[];
  (prog.cyclePattern||[]).forEach(dt=>{
    if(!dt||dt==='REST'||seen.has(dt)) return; seen.add(dt);
    out.push({dt,label:DAY_FULL_NAMES[dt]||dt,ex:[...new Set((prog.plan?.[dt]||[]).flatMap(g=>g.ex||[]))]});
  });
  return out;
}
function _normalExercises(){
  const seen=new Set(), out=[];
  activeCycle().forEach(c=>{
    const dt=c.dayType; if(!dt||dt==='REST'||seen.has(dt)) return; seen.add(dt);
    out.push({dt,label:DAY_FULL_NAMES[dt]||dt,ex:[...new Set(getPlanEx(dt).flatMap(g=>g.ex))]});
  });
  return out;
}
function _spark(vals,color){
  vals=vals.filter(v=>v>0).slice(-8);
  if(vals.length<2) return '<svg width="52" height="18"></svg>';
  const mn=Math.min(...vals), mx=Math.max(...vals), rg=(mx-mn)||1;
  const pts=vals.map((v,i)=>`${(i/(vals.length-1)*50+1).toFixed(1)},${(16-(v-mn)/rg*14).toFixed(1)}`).join(' ');
  return `<svg width="52" height="18" viewBox="0 0 52 18"><polyline points="${pts}" fill="none" stroke="${color}" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"/></svg>`;
}
function _shortName(n){ return n.replace(/\s*\([^)]+\)\s*$/,''); }
function _tool(n){ return n.match(/\(([^)]+)\)\s*$/)?.[1]||''; }


// ── LOG v2: weekly timeline, newest first ───────────────────────────────────
let _logFilter='all', _logWeeks=6;
const APP_VERSION='v83';

// Shared missed-day logic (Progress → Block and Log use the same list)
// Past training days with nothing logged; a workout on a rest day makes up the oldest open miss.
function blockMissedDays(b){
  if(!b) return [];
  const today=todayStr();
  const sess=all().filter(s=>s.date>=b.start&&s.dayType!=='REST');
  const missed=[];
  for(let d=b.start; d<today; d=_addDays(d,1)){
    const n=sess.filter(s=>s.date===d).length;
    if(_isTrainingDay(d,b.prog,b.entry)){ if(!n) missed.push(d); }
    else for(let k=0;k<n&&missed.length;k++) missed.shift();
  }
  return missed;
}
function _typeColor(dt){ return TYPE_COLOR[dt]||v4TypeColor(dt)||'var(--text3)'; }
function _dayAbbrOr(dt){ return DAY_DISPLAY[dt]?.abbr||dayAbbr(dt)||(dt?dt.slice(0,3).toUpperCase():''); }
function setLogFilter(f){ _logFilter=f; renderTimelineTab(); }
function moreLogWeeks(){ _logWeeks+=8; renderTimelineTab(); }

function _sessSummary(s){
  // first two exercises with their working sets, e.g. "Back Squat 62.5 × 8/8/8"
  return (s.exercises||[]).slice(0,2).map(ex=>{
    const e=exSessions(ex.name).find(x=>x.id===s.id);
    return e?`${_shortName(ex.name)} ${e.txt}`:_shortName(ex.name);
  }).join(' · ');
}

function renderTimelineTab(){
  const el=document.getElementById('log-timeline-view'); if(!el) return;
  const today=todayStr(), b=activeBlock(today);
  const sessions=all().filter(s=>s.dayType!=='REST');
  const missedAll=b?blockMissedDays(b):[];
  let html='';

  // ── Summary card: this week + next up ──
  const wkStart=_mondayOf(today), wkEnd=_addDays(wkStart,6);
  const wkSess=sessions.filter(s=>s.date>=wkStart&&s.date<=wkEnd);
  let wkPlanned=0;
  for(let d=wkStart; d<=wkEnd; d=_addDays(d,1)){ const t=getDayType(d); if(t&&t!=='REST'&&t!=='NONE') wkPlanned++; }
  let nextDt=null,nextDs=null;
  const loggedToday=sessions.some(s=>s.date===today);
  for(let i=loggedToday?1:0;i<=21;i++){ const ds=_addDays(today,i); const t=getDayType(ds); if(t&&t!=='REST'&&t!=='NONE'){nextDt=t;nextDs=ds;break;} }
  const nextWhen=nextDs?(nextDs===today?'Today':nextDs===_addDays(today,1)?'Tomorrow':_fmtLong(nextDs)):'';
  html+=`<div class="lg-sum">
    <div class="lg-sum-cell"><div class="eyebrow">This week</div><div class="lg-sum-v">${wkSess.length}<span>/${Math.max(wkPlanned,wkSess.length)}</span></div></div>
    <div class="lg-sum-cell" style="flex:1.6;min-width:0"><div class="eyebrow">Next up</div>
      <div class="lg-sum-v" style="font-size:15px;color:${nextDt?_typeColor(nextDt):'var(--text3)'};white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${nextDt?_esc(DAY_FULL_NAMES[nextDt]||nextDt):'—'}</div>
      <div class="pg-s" style="margin-top:1px">${_esc(nextWhen)}</div></div>
    ${b?`<div class="lg-sum-cell ${missedAll.length?'lg-sum-btn':''}" ${missedAll.length?`onclick="setLogFilter('${_logFilter==='missed'?'all':'missed'}')"`:''}><div class="eyebrow">Missed</div><div class="lg-sum-v" style="color:${missedAll.length?'var(--red)':'var(--text)'}">${missedAll.length}</div>${missedAll.length?`<div class="pg-s" style="margin-top:1px;color:var(--text2)">${_logFilter==='missed'?'hide ▴':'show ▾'}</div>`:''}</div>`:''}
  </div>`;

  // ── Filter chips ──
  const types=[...new Set(cycleFor(today).map(c=>c.dayType).filter(dt=>dt&&dt!=='REST'))];
  const hasOther=sessions.some(s=>!types.includes(s.dayType));
  const chips=[{k:'all',l:'All'},...types.map(dt=>({k:dt,l:DAY_FULL_NAMES[dt]||_dayAbbrOr(dt)})),{k:'pr',l:'★ PRs'}];
  if(hasOther) chips.push({k:'other',l:'Other'});
  if(b) chips.push({k:'missed',l:`Missed${missedAll.length?' '+missedAll.length:''}`});
  html+=`<div class="lg-chips">${chips.map(c=>`<button class="lg-chip${_logFilter===c.k?' on':''}" onclick="setLogFilter('${_jsq(c.k)}')">${_esc(c.l)}</button>`).join('')}</div>`;

  // ── Missed-only view ──
  if(_logFilter==='missed'){
    html+=missedAll.length?`<div class="lg-week"><div class="lg-week-hd"><div class="lg-week-t">Missed days</div><div class="lg-week-m">sick or away? tap to mark as rest</div></div>
      ${[...missedAll].reverse().map(d=>_missedRow(d,b)).join('')}</div>`
      :`<div class="lg-empty">No missed days in this block. 👏</div>`;
    el.innerHTML=html; return;
  }

  // ── Weekly groups, newest first ──
  const filt=s=>_logFilter==='all'||(_logFilter==='pr'?sessionHasPR(s):_logFilter==='other'?!types.includes(s.dayType):s.dayType===_logFilter);
  const shownSess=sessions.filter(filt);
  const missedSet=new Set(_logFilter==='all'?missedAll:[]);
  const weekKeys=[...new Set([...shownSess.map(s=>_mondayOf(s.date)),...[...missedSet].map(_mondayOf),...(_logFilter==='all'?[wkStart]:[])])].sort((a,c)=>c.localeCompare(a));
  if(!weekKeys.length){ html+=`<div class="lg-empty">No sessions match this filter.</div>`; el.innerHTML=html; return; }
  const lastWk=_addDays(wkStart,-7);
  weekKeys.slice(0,_logWeeks).forEach(wk=>{
    const we=_addDays(wk,6);
    const ws=shownSess.filter(s=>s.date>=wk&&s.date<=we).sort((a,c)=>c.date.localeCompare(a.date)||(c.id>a.id?1:-1));
    const wm=[...missedSet].filter(d=>d>=wk&&d<=we);
    const vol=ws.reduce((a,s)=>a+calcVolume(s),0);
    const wn=isoWeek(wk), tag=wk===wkStart?'This week':wk===lastWk?'Last week':'';
    const title=`W${wn}`+(_addDays(wk,3).slice(0,4)!==today.slice(0,4)?` <span style="font-size:14px;color:var(--text3)">${_addDays(wk,3).slice(0,4)}</span>`:'');
    // 7-day strip Mon→Sun
    let strip='';
    for(let i=0;i<7;i++){
      const d=_addDays(wk,i), ss=sessions.filter(s=>s.date===d), t=getDayType(d);
      const isTr=t&&t!=='REST'&&t!=='NONE';
      let cls='lg-dot', style='', inner='';
      if(ss.length){ cls+=' done'; style=`background:${_typeColor(ss[0].dayType)}`; inner=sessionHasPR(ss[0])?'★':'✓'; }
      else if(missedAll.includes(d)){ cls+=' miss'; inner='×'; }
      else if(d>today&&isTr){ cls+=' plan'; style=`border-color:${_typeColor(t)}`; }
      else if(d>=today&&isTr&&d===today){ cls+=' plan'; style=`border-color:${_typeColor(t)}`; }
      if(d===today) cls+=' now';
      strip+=`<div class="lg-day"><div class="${cls}" style="${style}">${inner}</div><div class="lg-dl">${'MTWTFSS'[i]}</div></div>`;
    }
    const rows=[...ws.map(s=>({d:s.date,h:_sessRow(s)})),...wm.map(d=>({d,h:_missedRow(d,b)}))].sort((a,c)=>c.d.localeCompare(a.d)).map(r=>r.h).join('');
    html+=`<div class="lg-week">
      <div class="lg-week-hd"><div><div class="lg-week-t">${title}${tag?`<span class="lg-tag">${tag}</span>`:''}</div><div class="lg-week-m">${_fmtShort(wk)} – ${_fmtShort(we)}</div></div>
        <div class="lg-week-m" style="text-align:right"><span style="color:var(--text);font-weight:700">${ws.length}</span> session${ws.length!==1?'s':''}${vol>0?` · ${(vol/1000).toFixed(1)}t`:''}</div></div>
      <div class="lg-strip">${strip}</div>
      ${rows||`<div class="lg-week-m" style="padding:6px 2px 2px">Nothing logged yet this week.</div>`}
    </div>`;
  });
  if(weekKeys.length>_logWeeks) html+=`<button class="log-older-btn" style="width:100%;margin:4px 0 12px" onclick="moreLogWeeks()">Show older weeks (${weekKeys.length-_logWeeks}) ▾</button>`;
  el.innerHTML=html;
}

function _sessRow(s){
  const col=_typeColor(s.dayType), pr=sessionHasPR(s);
  const d=new Date(s.date+'T00:00:00');
  const durMin=s.duration?Math.round(s.duration/60):null;
  const vol=calcVolume(s);
  const diffCol={'Very Easy':'var(--green)','Easy':'var(--green)','Moderate':'var(--amber)','Difficult':'var(--orange)','Very Difficult':'var(--red)'}[s.feedback?.difficulty];
  const name=DAY_FULL_NAMES[s.dayType]||s.dayType||s.label||'Session';
  return `<div class="lg-row" onclick="showDetail('${_jsq(s.id)}')">
    <div class="lg-date" style="border-color:${col}"><div class="lg-dw">${d.toLocaleDateString('en-GB',{weekday:'short'}).toUpperCase()}</div><div class="lg-dn">${d.getDate()}</div></div>
    <div class="lg-body">
      <div class="lg-name"><span style="color:${col}">${_esc(name)}</span>${pr?'<span class="lg-pr">★ PR</span>':''}${diffCol?`<span class="lg-diff" style="background:${diffCol}" title="${_esc(s.feedback.difficulty)}"></span>`:''}</div>
      <div class="lg-sub">${_esc(_sessSummary(s))}</div>
    </div>
    <div class="lg-meta">${vol>0?`<div>${(vol/1000).toFixed(1)}t</div>`:''}<div>${s.exercises.length} ex${durMin?` · ${durMin}m`:''}</div></div>
  </div>`;
}
function _missedRow(d,b){
  const t=getDayType(d);
  const dd=new Date(d+'T00:00:00');
  return `<div class="lg-row lg-missed" onclick="showLogDay('${d}')">
    <div class="lg-date"><div class="lg-dw">${dd.toLocaleDateString('en-GB',{weekday:'short'}).toUpperCase()}</div><div class="lg-dn">${dd.getDate()}</div></div>
    <div class="lg-body"><div class="lg-name" style="color:var(--red)">Missed · <span style="color:var(--text2)">${_esc(DAY_FULL_NAMES[t]||t||'Training')}</span></div><div class="lg-sub">Sick or away? Tap to mark as rest</div></div>
    <div class="lg-meta" style="font-size:16px">⋯</div>
  </div>`;
}

function checkForUpdate(){
  const done=()=>location.reload();
  try{
    if('serviceWorker' in navigator) navigator.serviceWorker.getRegistration().then(r=>{ if(r) r.update().finally(done); else done(); }).catch(done);
    else done();
  }catch(e){ done(); }
}

// ── DISMISSIBLE ALERTS (synced with profile) ───────────────────────────────
function isDismissed(key,sig){ return !!(PROFILE.dismissed&&PROFILE.dismissed[key]===sig); }
function dismissAlert(key,sig){
  PROFILE.dismissed=PROFILE.dismissed||{}; PROFILE.dismissed[key]=sig;
  saveProfileData(); refreshActiveView();
}
function _xBtn(key,sig){ return `<button class="pg-x" aria-label="Dismiss" onclick="event.stopPropagation();dismissAlert('${_jsq(key)}','${_jsq(sig)}')">×</button>`; }
// Fatigue warning: once dismissed it stays hidden until fatigue drops and rises again
function fatigueAlert(){
  const msg=getDeloadBanner();
  if(!msg){ if(PROFILE.dismissed&&PROFILE.dismissed.fatigue){ delete PROFILE.dismissed.fatigue; saveProfileData(); } return null; }
  if(PROFILE.dismissed&&PROFILE.dismissed.fatigue) return null;
  return msg;
}
function phaseBannerHtml(ph,extraStyle){
  if(!ph) return '';
  const sig=ph.type+'|'+ph.start;
  if(isDismissed('phase',sig)) return '';
  return `<div class="pg-banner ${ph.type==='deload'?'deload-b':'test-b'}" style="position:relative;padding-right:34px;${extraStyle||''}"><strong>${_esc(ph.label||ph.type)}</strong> · ${ph.type==='deload'?'same weights, 2 sets per exercise':'go for your best top sets'} · until ${_fmtShort(ph.end)}${_xBtn('phase',sig)}</div>`;
}

// ── PROGRESS VIEW ─────────────────────────────────────────────────────────────
let _missedOpen=false;
function toggleMissed(){ _missedOpen=!_missedOpen; renderBlockTab(); }
let progTab='block', _liftOpen=null, _showOlder=false, _olderQ='', _kpiFiltersOpen=false;
try{ const t=localStorage.getItem('tr-prog-tab-v1'); if(t==='block'||t==='lifts'||t==='body') progTab=t; }catch(e){}

function setProgTab(t){
  progTab=t; try{localStorage.setItem('tr-prog-tab-v1',t);}catch(e){}
  if(t!=='lifts') _liftOpen=null;
  renderProgress();
  const v=document.getElementById('view-progress'); if(v) v.scrollTop=0;
}
function renderProgress(){
  document.querySelectorAll('#pg-seg button').forEach(b=>b.classList.toggle('on',b.dataset.t===progTab));
  ['block','lifts','body'].forEach(t=>{ const el=document.getElementById('pg-'+t); if(el) el.style.display=t===progTab?'':'none'; });
  if(progTab==='block') renderBlockTab();
  else if(progTab==='lifts') renderLiftsTab();
  else renderBodyTab();
}

function renderBlockTab(){
  const el=document.getElementById('pg-block'); if(!el) return;
  const today=todayStr(), b=activeBlock(today);
  let html='';

  // Fatigue / deload warning (single rule, single place)
  const fat=fatigueAlert();
  if(fat) html+=`<div class="pg-banner warn-b" style="position:relative;padding-right:34px">⚠️ <strong>Deload suggested.</strong> ${fat}${_xBtn('fatigue','1')}</div>`;

  if(b){
    const {prog,entry}=b;
    const ph=phaseOn(today);
    html+=phaseBannerHtml(ph);

    // Weeks timeline
    const startMon=_mondayOf(b.start), endMon=b.end?_mondayOf(b.end):_mondayOf(today);
    let weeks=[]; for(let w=startMon; w<=endMon; w=_addDays(w,7)) weeks.push(w);
    const curMon=_mondayOf(today);
    const totalW=weeks.length, curIdx=weeks.indexOf(curMon);
    const shown=weeks.slice(-12);
    const sess=all().filter(s=>s.date>=b.start&&s.dayType!=='REST');
    const tl=shown.map(w=>{
      const we=_addDays(w,6);
      const phw=b.phases.find(p=>p.start<=we&&p.end>=w);
      let col='var(--bg4)';
      if(w<curMon){ const n=sess.filter(s=>s.date>=w&&s.date<=we).length; col=n?'var(--green)':'var(--red)'; }
      if(phw) col=phw.type==='deload'?'var(--blue)':'var(--amber)';
      const isCur=w===curMon;
      return `<div style="background:${col};${isCur?'outline:2px solid var(--accent);outline-offset:1px':''}" title="${_fmtShort(w)}"></div>`;
    }).join('');
    const labels=b.phases.map(p=>`<span style="color:${p.type==='deload'?'var(--blue)':'var(--amber)'}">${_esc(p.label||p.type)} ${_fmtShort(p.start)}</span>`).join('');

    // Adherence (calendar days vs logged workouts)
    let planned=0;
    for(let d=b.start; d<=today; d=_addDays(d,1)){
      const logged=sess.some(s=>s.date===d);
      if(d<today||logged){ if(_isTrainingDay(d,prog,entry)) planned++; }
    }
    const done=sess.filter(s=>s.date<=today).length;
    const missedDays=blockMissedDays(b);
    const missed=missedDays.length;
    let nextDt=null,nextDs=null;
    const loggedToday=sess.some(s=>s.date===today);
    for(let i=loggedToday?1:0;i<=21;i++){ const ds=_addDays(today,i); const t=getDayType(ds); if(t&&t!=='REST'&&t!=='NONE'){nextDt=t;nextDs=ds;break;} }
    const nextLbl=nextDt?(DAY_DISPLAY[nextDt]?.abbr||dayAbbr(nextDt)||dayTitle(nextDt)):'—';
    const nextWhen=nextDs?(nextDs===today?'today':nextDs===_addDays(today,1)?'tomorrow':_fmtShort(nextDs)):'';
    const ended=b.end&&today>b.end;

    html+=`<div class="pg-card">
      <div class="eyebrow" style="color:${_kpiColor(prog.color)}">${_esc(prog.name)}</div>
      <div style="display:flex;justify-content:space-between;align-items:baseline;margin-top:6px">
        <div class="pg-big">${ended?'Block finished':curIdx>=0?`Week ${curIdx+1} of ${totalW}`:`Week ${totalW}`}<span style="font-size:16px;color:var(--text3);margin-left:8px">W${isoWeek(today)}</span></div>
        <div class="tnum" style="font-size:11px;color:var(--text3)">${b.end?'ends '+_fmtShort(b.end):'no end date'}</div>
      </div>
      <div class="pg-tl">${tl}</div>
      <div style="display:flex;justify-content:space-between;gap:8px;font-size:10px;margin-top:5px;font-weight:600">${labels||'<span></span>'}</div>
      <div class="pg-tiles">
        <div class="pg-tile"><div class="v">${done}<span style="color:var(--text3);font-size:12px">/${planned}</span></div><div class="eyebrow">Done</div></div>
        <div class="pg-tile${missed?' pg-tile-btn':''}" ${missed?`onclick="toggleMissed()"`:''}><div class="v" style="color:${missed?'var(--red)':'var(--text)'}">${missed}${missed?`<span style="font-size:11px;color:var(--text3);margin-left:4px">${_missedOpen?'▴':'▾'}</span>`:''}</div><div class="eyebrow">Missed</div></div>
        <div class="pg-tile"><div class="v" style="color:var(--accent)">${_esc(nextLbl)}</div><div class="eyebrow">Next ${nextWhen}</div></div>
      </div>
      ${missed?`<button class="pg-missed-btn" onclick="toggleMissed()">${_missedOpen?'Hide missed days ▴':`See ${missed} missed day${missed!==1?'s':''} ▾`}</button>`:''}
      ${missed&&_missedOpen?`<div class="pg-missed">
        <div class="eyebrow" style="margin-bottom:2px">Missed days · tap to mark as rest if you were sick or away</div>
        <div class="pg-rows">${[...missedDays].reverse().map(d=>{
          const t=getDayType(d);
          return `<div class="pg-row" onclick="showLogDay('${d}')">
            <div><div class="pg-n" style="font-size:13px">${_fmtLong(d)}</div><div class="pg-s">planned: ${_esc(DAY_FULL_NAMES[t]||t||'')}</div></div>
            <div class="pg-v" style="color:var(--text3)">W${isoWeek(d)}</div></div>`;}).join('')}</div>
      </div>`:''}
    </div>`;

    // Ready to add weight + stalled
    const groups=_progExercises(prog);
    const ready=[], stalled=[];
    groups.forEach(g=>g.ex.forEach(nm=>{
      const p=progressionFor(nm,prog,g.dt);
      if(p&&p.ready) ready.push({nm,p,dt:g.dt});
      const st=stalledInfo(nm,prog);
      if(st&&!(p&&p.ready)) stalled.push({nm,st});
    }));
    const wTxt=(p,w)=>p.kind==='bw'?(w>0?'+'+w+' kg':'BW'):w+' kg';
    html+=`<div class="pg-card">
      <div class="eyebrow" style="color:var(--green)">↑ Ready to add weight</div>
      ${ready.length?`<div class="pg-rows">${ready.map(r=>`<div class="pg-row" onclick="openLift('${_jsq(r.nm)}')">
        <div><div class="pg-n">${_esc(_shortName(r.nm))}</div><div class="pg-s">last ${_esc(r.p.last.txt)} · hit ${r.p.meta.maxReps} on all sets</div></div>
        <div class="pg-v" style="color:var(--green)">${wTxt(r.p,r.p.w)} → ${wTxt(r.p,r.p.next)}</div></div>`).join('')}</div>`
        :`<div style="font-size:12px;color:var(--text3);margin-top:8px">Nothing yet. A lift shows up here once every set reaches the top of its rep range.</div>`}
    </div>`;
    if(stalled.length) html+=`<div class="pg-card">
      <div class="eyebrow" style="color:var(--amber)">Stalled · no progress in 3 sessions</div>
      <div class="pg-rows">${stalled.map(s=>`<div class="pg-row" onclick="openLift('${_jsq(s.nm)}')">
        <div><div class="pg-n">${_esc(_shortName(s.nm))}</div><div class="pg-s">last ${_esc(s.st.txt)}</div></div>
        <div class="pg-v" style="color:var(--text3)">›</div></div>`).join('')}</div>
    </div>`;
  } else {
    const sess30=all().filter(s=>s.date>=_addDays(today,-29)&&s.dayType!=='REST');
    html+=`<div class="pg-card">
      <div class="eyebrow">No program block active</div>
      <div style="font-size:13px;color:var(--text2);margin-top:6px">Start a program in Profile → Programs to see weeks, adherence and progression here.</div>
      <div class="pg-tiles">
        <div class="pg-tile"><div class="v">${sess30.length}</div><div class="eyebrow">Sessions 30d</div></div>
        <div class="pg-tile"><div class="v">${(sess30.reduce((a,s)=>a+calcVolume(s),0)/1000).toFixed(1)}<span style="font-size:11px;color:var(--text3)">t</span></div><div class="eyebrow">Volume</div></div>
        <div class="pg-tile"><div class="v" style="color:var(--amber)">${countPRs(_addDays(today,-29))}</div><div class="eyebrow">PRs</div></div>
      </div>
    </div>`;
  }

  // Weekly sets per muscle (avg of last 4 weeks)
  const ms=weeklySetsByMuscle(28);
  const order=['Legs','Back','Chest','Shoulders','Arms','Core','Other'].filter(k=>ms[k]>0);
  const mx=Math.max(1,...order.map(k=>ms[k]));
  const mcol={Legs:'var(--legs)',Back:'var(--pull)',Chest:'var(--push)',Shoulders:'var(--purple)',Arms:'var(--text2)',Core:'var(--amber)',Other:'var(--text4)'};
  html+=`<div class="pg-card">
    <div class="eyebrow">Sets per week · last 4 weeks</div>
    ${order.length?`<div class="pg-mus">${order.map(k=>`<span>${k}</span><div class="pg-bar" style="width:${(ms[k]/mx*100).toFixed(0)}%;background:${mcol[k]}"></div><span class="tnum">${Math.round(ms[k])}</span>`).join('')}</div>`
      :`<div style="font-size:12px;color:var(--text3);margin-top:8px">No sessions in the last 4 weeks.</div>`}
  </div>`;

  // Recent PRs (same rule as Profile and the Log)
  const from=b?b.start:_addDays(today,-29);
  const prs=allRecentPRs(from).slice(0,5);
  html+=`<div class="pg-card">
    <div class="eyebrow" style="color:var(--amber)">★ Recent PRs</div>
    ${prs.length?`<div class="pg-rows">${prs.map(p=>`<div class="pg-row" onclick="openLift('${_jsq(p.name)}')">
      <div><div class="pg-n">${_esc(_shortName(p.name))}</div><div class="pg-s">${_esc(setText(p.kind,p.best))} · ${_fmtShort(p.date)}</div></div>
      <div class="pg-v" style="color:var(--amber)">${p.kind==='load'?'~'+Math.round(p.score)+' kg':'★'}</div></div>`).join('')}</div>`
      :`<div style="font-size:12px;color:var(--text3);margin-top:8px">No PRs in this ${b?'block':'period'} yet. More reps at the same weight counts too.</div>`}
  </div>`;
  el.innerHTML=html;
}

function openLift(name){ _liftOpen=name; currentProgressEx=name; progTab='lifts'; try{localStorage.setItem('tr-prog-tab-v1','lifts');}catch(e){} if(!document.getElementById('view-progress').classList.contains('active')) switchView('progress'); else renderProgress(); const v=document.getElementById('view-progress'); if(v) v.scrollTop=0; }
function closeLift(){ _liftOpen=null; renderProgress(); }
function toggleOlder(){ _showOlder=!_showOlder; renderLiftsTab(); }
function filterOlder(q){ _olderQ=q; _renderOlderList(); }
function toggleKpiFilters(){ _kpiFiltersOpen=!_kpiFiltersOpen; const f=document.getElementById('kpi-filters'); if(f) f.style.display=_kpiFiltersOpen?'flex':'none'; const bt=document.getElementById('kpi-filter-btn'); if(bt) bt.textContent=_kpiFiltersOpen?'Hide filters':'Filters'; }

function _liftRow(nm, prog, dt){
  const h=exSessions(nm), last=h[h.length-1];
  const p=prog?progressionFor(nm,prog,dt):null;
  const kind=exKind(nm);
  const sub=last?`${_esc(last.txt)}${kind==='load'&&last.score?` · e1RM ${Math.round(last.score)}`:''}`:'not logged yet';
  const col=h.length>1&&last.score>=h[h.length-2].score?'var(--green)':'var(--amber)';
  return `<div class="pg-row" onclick="openLift('${_jsq(nm)}')">
    <div style="min-width:0"><div class="pg-n">${_esc(_shortName(nm))} <span class="pg-tool">${_esc(_tool(nm))}</span></div><div class="pg-s">${sub}</div></div>
    <div style="display:flex;align-items:center;gap:6px;flex-shrink:0">
      ${p&&p.ready?'<span class="pg-tag" style="background:#4ade8022;color:var(--green)">↑ add</span>':''}
      ${last&&last.isPR?'<span style="color:var(--amber)">★</span>':''}
      ${_spark(h.map(e=>e.score),col)}
    </div></div>`;
}
function renderLiftsTab(){
  const list=document.getElementById('pg-lift-list'), det=document.getElementById('pg-lift-detail');
  if(!list||!det) return;
  if(_liftOpen){ list.style.display='none'; det.style.display=''; renderProgressFor(_liftOpen); return; }
  list.style.display=''; det.style.display='none';
  const b=activeBlock(todayStr());
  const groups=b?_progExercises(b.prog):_normalExercises();
  const inPlan=new Set(groups.flatMap(g=>g.ex));
  let html=groups.map(g=>`<div class="pg-card">
    <div class="eyebrow" style="color:${v4TypeColor(g.dt)}">${_esc(g.label)}</div>
    <div class="pg-rows">${g.ex.map(nm=>_liftRow(nm,b?.prog,g.dt)).join('')||'<div style="font-size:12px;color:var(--text3);padding-top:8px">No exercises in this day.</div>'}</div>
  </div>`).join('');
  const older=allExNames().filter(n=>!inPlan.has(n));
  html+=`<div class="pg-card" style="border-style:dashed">
    <div class="pg-row" style="border:none;padding:0;cursor:pointer" onclick="toggleOlder()">
      <div class="pg-n" style="color:var(--text2)">${_showOlder?'Hide':'Show'} older exercises</div><div class="pg-v" style="color:var(--text3)">${older.length} ${_showOlder?'▴':'▾'}</div></div>
    ${_showOlder?`<input type="search" placeholder="Search exercise" value="${_esc(_olderQ)}" oninput="filterOlder(this.value)" class="pg-search"><div class="pg-rows" id="pg-older"></div>`:''}
  </div>`;
  list.innerHTML=html;
  if(_showOlder) _renderOlderList();
  renderKpiChart();
}
function _renderOlderList(){
  const el=document.getElementById('pg-older'); if(!el) return;
  const b=activeBlock(todayStr());
  const inPlan=new Set((b?_progExercises(b.prog):_normalExercises()).flatMap(g=>g.ex));
  const q=_olderQ.trim().toLowerCase();
  const older=allExNames().filter(n=>!inPlan.has(n)&&(!q||n.toLowerCase().includes(q)));
  el.innerHTML=older.map(nm=>_liftRow(nm,null,null)).join('')||'<div style="font-size:12px;color:var(--text3);padding-top:8px">No matches.</div>';
}

function renderProgressFor(name){
  currentProgressEx=name;
  const content=document.getElementById('progress-content'); if(!content) return;
  const h=exSessions(name), kind=exKind(name);
  const head=`<button class="pg-back" onclick="closeLift()">‹ All lifts</button>
    <div style="margin:6px 0 12px"><div class="pg-big">${_esc(_shortName(name))}</div><div class="eyebrow" style="margin-top:4px">${_esc(_tool(name))} · ${muscleOf(name)}</div></div>`;
  if(!h.length){ content.innerHTML=head+`<div class="pg-card" style="text-align:center;color:var(--text3);font-size:13px">No sets logged yet.</div>`; return; }
  const best=exBest(name), last=h[h.length-1], prev=h.length>1?h[h.length-2]:null;
  const pureBW=kind==='bw'&&h.every(e=>e.sets.every(s=>!(+s.w>0)));
  const metricOf=e=>kind==='time'?e.best.r:pureBW?Math.max(...e.sets.map(s=>+s.r||0)):Math.round(e.score*10)/10;
  const unit=kind==='time'?'s':pureBW?' reps':' kg';
  const chg=prev?Math.round((metricOf(last)-metricOf(prev))*10)/10:null;
  const b=activeBlock(todayStr());
  let pTxt='';
  if(b){ for(const g of _progExercises(b.prog)){ if(g.ex.includes(name)){ const p=progressionFor(name,b.prog,g.dt); if(p){ pTxt=p.ready?`<span style="color:var(--green)">↑ Next time: ${p.kind==='bw'?'+'+p.next+' kg':p.next+' kg'}</span> · all sets hit ${p.meta.maxReps}`:`Next time: same weight, aim for ${p.meta.maxReps} reps on every set (${p.meta.sets||3} × ${p.meta.minReps}–${p.meta.maxReps})`; } break; } } }
  content.innerHTML=head+`
    ${pTxt?`<div class="pg-banner" style="background:var(--bg2);border:1px solid var(--border);font-size:12px">${pTxt}</div>`:''}
    <div class="pg-tiles" style="margin:0 0 10px">
      <div class="pg-tile"><div class="v" style="font-size:15px">${_esc(setText(kind,best.best))}</div><div class="eyebrow">Best set</div></div>
      <div class="pg-tile"><div class="v" style="font-size:15px;color:var(--amber)">${kind==='load'?'~'+Math.round(best.score)+' kg':pureBW?Math.max(...h.map(e=>metricOf(e)))+' reps':kind==='bw'?'~'+Math.round(best.score)+' kg':best.best.r+'s'}</div><div class="eyebrow">${kind==='time'?'Longest':pureBW?'Most reps':kind==='bw'?'Est. 1RM incl. BW':'Est. 1RM'}</div></div>
      <div class="pg-tile"><div class="v" style="font-size:15px;color:${chg>0?'var(--green)':chg<0?'var(--red)':'var(--text)'}">${chg===null?'—':chg===0?'same':(chg>0?'+':'')+chg+unit}</div><div class="eyebrow">vs last</div></div>
    </div>
    <div class="pg-card"><div class="eyebrow" style="margin-bottom:8px">${kind==='time'?'Duration':pureBW?'Best reps':'Estimated 1RM'} per session</div><div style="position:relative;height:170px"><canvas id="pcvs"></canvas></div></div>
    <div class="pg-card"><div class="eyebrow">All sessions</div><div class="pg-rows">${[...h].reverse().map(e=>`<div class="pg-row">
      <div><div class="pg-n" style="font-size:13px">${_fmtShort(e.date)} <span class="pg-tool">${_esc(DAY_DISPLAY[e.dayType]?.abbr||dayAbbr(e.dayType)||'')}</span></div><div class="pg-s">${_esc(e.txt)}</div></div>
      <div class="pg-v" style="color:${e.isPR?'var(--amber)':'var(--text2)'}">${e.isPR?'★ ':''}${kind==='load'?'~'+Math.round(e.score):''}</div></div>`).join('')}</div></div>`;
  if(progressChart){progressChart.destroy();progressChart=null;}
  const cvs=document.getElementById('pcvs'); if(!cvs||typeof Chart==='undefined') return;
  const vals=h.map(metricOf);
  progressChart=new Chart(cvs,{type:'line',
    data:{labels:h.map(e=>_fmtShort(e.date)),datasets:[{data:vals,borderColor:'#d4ff3a',backgroundColor:'#d4ff3a14',borderWidth:2,pointRadius:h.map(e=>e.isPR?5:3),pointBackgroundColor:h.map(e=>e.isPR?'#fbbf24':'#d4ff3a'),pointBorderWidth:0,fill:true,tension:0.3}]},
    options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{callbacks:{label:c=>c.parsed.y+unit+' · '+h[c.dataIndex].txt}}},scales:{y:{ticks:{color:'#666',font:{size:10}},grid:{color:'#222'},border:{display:false}},x:{ticks:{color:'#666',font:{size:9},maxRotation:0,autoSkip:true,maxTicksLimit:6},grid:{display:false},border:{display:false}}}}});
}

function renderBodyTab(){ renderBwChart(); }

// ── BODYWEIGHT ─────────────────────────────────────────────────────────────
let bwChart=null;

function openBwLog() {
  const last=BW_LOG[BW_LOG.length-1];
  document.getElementById('bw-date-input').value=todayStr();
  document.getElementById('bw-input').value=last?last.w:'';
  document.getElementById('bw-modal').classList.add('open');
  setTimeout(()=>document.getElementById('bw-input').focus(),100);
}
function closeBwLog(){document.getElementById('bw-modal').classList.remove('open');}

async function saveBwLog() {
  const w=parseFloat(document.getElementById('bw-input').value);
  const date=document.getElementById('bw-date-input').value||todayStr();
  if(!w||w<30||w>300)return;
  BW_LOG=BW_LOG.filter(e=>e.date!==date);
  BW_LOG.push({date,w});
  BW_LOG.sort((a,b)=>a.date.localeCompare(b.date));
  localStorage.setItem('tr-bw-v1',JSON.stringify(BW_LOG));
  if(fbReady&&db){const tid=trainerId();try{await db.doc(`trainers/${tid}/meta`).set({bwLog:BW_LOG},{merge:true});}catch(e){}}
  closeBwLog();
  renderBwChart();
}

function renderBwChart() {
  const empty=document.getElementById('bw-empty');
  const cvs=document.getElementById('bw-cvs');
  const latEl=document.getElementById('bw-latest');
  if(!cvs)return;
  if(!BW_LOG.length){
    if(empty)empty.style.display='';
    cvs.style.display='none';
    if(latEl)latEl.textContent='';
    return;
  }
  if(empty)empty.style.display='none';
  cvs.style.display='';
  const last=BW_LOG[BW_LOG.length-1];
  const first=BW_LOG[0];
  const diff=+(last.w-first.w).toFixed(1);
  if(latEl)latEl.innerHTML=`<span style="font-family:var(--fm);font-size:20px;color:var(--text);font-weight:600">${last.w} kg</span>  ·  ${diff>0?'+':''}${diff} kg since ${_fmtShort(first.date)}`;
  if(bwChart){bwChart.destroy();bwChart=null;}
  const maData=BW_LOG.map((_,i)=>{
    const win=BW_LOG.slice(Math.max(0,i-3),i+4);
    return +(win.reduce((s,e)=>s+e.w,0)/win.length).toFixed(2);
  });
  bwChart=new Chart(cvs,{
    type:'line',
    data:{
      labels:BW_LOG.map(e=>e.date.slice(5)),
      datasets:[
        {data:BW_LOG.map(e=>e.w),borderColor:'#3b82f6',backgroundColor:'#3b82f615',borderWidth:2,pointRadius:3,pointBackgroundColor:'#3b82f6',fill:true,tension:0.3,label:'Weight'},
        {data:maData,borderColor:'#f59e0b',backgroundColor:'transparent',borderWidth:1.5,pointRadius:0,borderDash:[4,3],tension:0.3,label:'Trend'}
      ]
    },
    options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{callbacks:{label:c=>c.dataset.label+': '+c.parsed.y+' kg'}}},scales:{y:{ticks:{color:'#505050',font:{size:9,family:'DM Mono'},callback:v=>v+'kg'},grid:{color:'#2a2a2a'},border:{display:false}},x:{ticks:{color:'#505050',font:{size:9}},grid:{display:false},border:{display:false}}}}
  });
}

// ── CYCLE COMPLETION ───────────────────────────────────────────────────────
function checkCycleComplete(sess) {
  const info=getCycleInfo(sess.date);
  if(!info||info.isPre)return;
  const cycleLen=cycleFor(sess.date).filter(d=>d.dayType!=='REST').length;
  const _cStart=_addDays(sess.date,-(info.idx||0)), _cEnd=_addDays(_cStart,cycleFor(sess.date).length-1);
  const cycleSessions=all().filter(s=>s.date>=_cStart&&s.date<=_cEnd&&s.dayType!=='REST');
  if(cycleSessions.length<cycleLen)return;
  const diffMap={'Very Easy':1,'Easy':2,'Moderate':3,'Difficult':4,'Very Difficult':5};
  const withDiff=cycleSessions.filter(s=>s.feedback?.difficulty);
  const avgDiff=withDiff.length?withDiff.reduce((a,s)=>a+(diffMap[s.feedback.difficulty]||3),0)/withDiff.length:3;
  const totalVol=cycleSessions.reduce((a,s)=>a+calcVolume(s),0);
  const prs=[];
  const allEx=new Set(cycleSessions.flatMap(s=>s.exercises.map(e=>e.name)));
  const cycleStartDate=cycleSessions.map(s=>s.date).sort()[0];
  allEx.forEach(name=>{
    const hist=getExHistory(name);
    const bw=isBW(name);
    const prevHist=hist.filter(h=>h.date<cycleStartDate);
    if(!prevHist.length)return; // no history before this cycle — can't be a PR
    const prevMax=Math.max(0,...prevHist.map(h=>bw?h.r:h.w));
    if(prevMax===0)return;
    if(exSessions(name).some(e=>e.isPR&&e.date>=cycleStartDate&&cycleSessions.some(cs=>cs.id===e.id)))prs.push(name.split(' (')[0]);
  });
  PENDING_CYCLE_SUMMARY={label:info.cycleLabel,sessions:cycleSessions.length,totalVol,avgDiff,prs:prs.slice(0,4)};
  localStorage.setItem('tr-cycle-sum-v1',JSON.stringify(PENDING_CYCLE_SUMMARY));
}

function dismissCycleSummary() {
  PENDING_CYCLE_SUMMARY=null;
  localStorage.removeItem('tr-cycle-sum-v1');
  document.getElementById('cycle-summary-banner').innerHTML='';
}

// ── DELOAD SUGGESTION ──────────────────────────────────────────────────────
function getDeloadBanner() {
  const sessions=all().filter(s=>s.dayType!=='REST');
  if(sessions.length<6)return null;
  const diffMap={'Very Easy':1,'Easy':2,'Moderate':3,'Difficult':4,'Very Difficult':5};
  const recent=sessions.slice(-6).filter(s=>s.feedback?.difficulty);
  if(recent.length<4)return null;
  const avg=recent.reduce((a,s)=>a+(diffMap[s.feedback.difficulty]||3),0)/recent.length;
  const last3=sessions.slice(-3).filter(s=>s.feedback?.difficulty);
  const last3High=last3.length===3&&last3.every(s=>(diffMap[s.feedback.difficulty]||0)>=4);
  if(avg>=3.8||last3High)return'Your recent sessions were rated hard. Consider a lighter week: keep the weights, do 2 sets per exercise.';
  return null;
}

// ── PROFILE ─────────────────────────────────────────────────────────────────
function renderProfile() {
  const today=todayStr();
  document.getElementById('prof-name').textContent=PROFILE.name||'—';
  const avatarEl=document.getElementById('prof-avatar');
  if(avatarEl)avatarEl.textContent=PROFILE.emoji||'💪';

  // Identity tags
  const cyc=cycleFor(today);
  const tags=[];
  if(PROFILE.goal)tags.push(PROFILE.goal.toUpperCase());
  tags.push(cyc.length+'-DAY CYCLE');
  const bwNow=latestBodyweight();
  const dims=[];
  if(PROFILE.height)dims.push(PROFILE.height+' CM');
  if(bwNow)dims.push(bwNow+' KG');
  if(PROFILE.age)dims.push(PROFILE.age+' YO');
  if(dims.length)tags.push(dims.join(' · '));
  document.getElementById('prof-tags').innerHTML=tags.map(t=>`<span class="v4ident-tag">${_esc(t)}</span>`).join('');

  // Target callout
  const wrap=document.getElementById('prof-target-wrap');
  if(PROFILE.target){
    const d=new Date(PROFILE.target+'T00:00:00');
    const days=Math.max(0,Math.round((d-new Date(today+'T00:00:00'))/86400000));
    wrap.innerHTML=`<div class="v4ident-target">
      <span class="dot"></span>
      <span>TARGET · ${d.toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'}).toUpperCase()}</span>
      <span class="days">${days}d to go</span>
    </div>`;
  } else wrap.innerHTML='';

  // Current program card
  const b=activeBlock(today);
  const progEl=document.getElementById('prof-program');
  if(progEl){
    const ph=b?phaseOn(today):null;
    progEl.innerHTML=`<div class="pg-card" style="border-color:${b?_kpiColor(b.prog.color):'var(--border)'};cursor:pointer" onclick="openProgramsOverlay()">
      <div style="display:flex;justify-content:space-between;align-items:center">
        <div class="eyebrow" style="color:${b?_kpiColor(b.prog.color):'var(--text3)'}">Current program</div>
        <div class="eyebrow" style="color:var(--accent)">Switch ›</div>
      </div>
      <div style="font-size:15px;font-weight:700;margin-top:6px">${_esc(b?b.prog.name:'Normal Training')}</div>
      <div class="tnum" style="font-size:11px;color:var(--text3);margin-top:3px">${cyc.length}-day cycle${b&&b.end?' · ends '+_fmtShort(b.end):''}${ph?' · '+_esc(ph.label||ph.type)+' now':''}</div>
    </div>`;
  }

  // Lifetime — one compact row
  const trainSess=all().filter(s=>s.dayType!=='REST'&&s.date<=today);
  const totalVol=trainSess.reduce((a,s)=>a+calcVolume(s),0);
  const weeksTrained=new Set(trainSess.map(s=>_mondayOf(s.date))).size;
  let wkAvg='0';
  if(trainSess.length){
    const first=trainSess.map(s=>s.date).sort()[0];
    const weeks=Math.max(1,(new Date(today+'T00:00:00')-new Date(first+'T00:00:00'))/(86400000*7));
    wkAvg=(trainSess.length/weeks).toFixed(1);
  }
  document.getElementById('prof-lifetime').innerHTML=`<div class="pg-card" style="margin:0 16px 14px">
    <div class="eyebrow">Lifetime</div>
    <div class="pg-life">
      <div><div class="v">${trainSess.length}</div><div class="eyebrow">Sessions</div></div>
      <div><div class="v">${(totalVol/1000).toFixed(0)}<sub>t</sub></div><div class="eyebrow">Volume</div></div>
      <div><div class="v">${weeksTrained}</div><div class="eyebrow">Weeks</div></div>
      <div><div class="v">${wkAvg}</div><div class="eyebrow">Per week</div></div>
    </div>
  </div>`;

  // ── PR cabinet (same scoring as Progress) ──
  const selected=getPrSelected();
  const trophy=document.getElementById('pr-trophy');
  if(trophy){
    if(!selected.length){
      trophy.innerHTML=`<div class="pr-trophy-empty">No exercises selected — tap <strong>Edit</strong> above to add some.</div>`;
    } else {
      trophy.innerHTML=selected.map(nm=>{
        const h=exSessions(nm);
        if(!h.length)return`<div class="pr-trophy-card" onclick="openPrEditSheet()">
          <div class="pr-trophy-name">${_esc(_shortName(nm))}</div>
          <div style="font-size:12px;color:var(--text3);margin-top:4px">No data yet</div>
        </div>`;
        const kind=exKind(nm), best=exBest(nm);
        const last=h[h.length-1], prev=h.length>1?h[h.length-2]:null;
        const up=prev?last.score-prev.score:null;
        const trendTxt=up===null?'':(up>0.05?'↑ improving':up<-0.05?'↓ lower last time':'→ same as last time');
        const trendColor=up>0.05?'var(--green)':up<-0.05?'var(--red)':'var(--text3)';
        const equip=_tool(nm);
        const bigVal=kind==='time'?`${best.best.r}<span class="pr-trophy-unit">s</span>`
          :kind==='bw'?(+best.best.w>0?`+${best.best.w}<span class="pr-trophy-unit">kg</span>`:`${best.best.r}<span class="pr-trophy-unit">reps</span>`)
          :`${best.best.w}<span class="pr-trophy-unit">kg</span>`;
        return`<div class="pr-trophy-card" onclick="openLift('${_jsq(nm)}')">
          <div class="pr-trophy-name">${_esc(_shortName(nm))}</div>
          ${equip?`<div style="display:inline-block;font-size:8px;font-weight:700;color:var(--text4);background:var(--bg3);border:1px solid var(--border);border-radius:4px;padding:1px 5px;font-family:var(--fb);letter-spacing:.06em;margin-bottom:4px">${_esc(equip.toUpperCase())}</div>`:'<div style="margin-bottom:4px"></div>'}
          <div class="pr-trophy-val">${bigVal}</div>
          <div class="pr-trophy-when">${_esc(setText(kind,best.best))} · ${_fmtShort(best.date)}</div>
          ${kind==='load'?`<div class="pr-trophy-orm">~${Math.round(best.score)}kg 1RM</div>`:''}
          ${trendTxt?`<div class="pr-trophy-trend" style="color:${trendColor}">${trendTxt}</div>`:''}
        </div>`;
      }).join('');
    }
  }

  // Settings — short values
  document.getElementById('profile-sync-short').textContent=fbReady?'Connected':'Offline';
  document.getElementById('profile-prog-short').textContent=b?_shortName(b.prog.name).split(' · ')[0]:'Normal';
  const vacEl=document.getElementById('profile-vacation-short');
  if(vacEl)vacEl.textContent=VACATION?`${VACATION.name} · ${_fmtRange(VACATION.start,VACATION.end)}`:'Not set';
  const _pv=document.getElementById('profile-version'); if(_pv)_pv.textContent=APP_VERSION+' · check for update';
  document.getElementById('profile-lib-short').textContent=EX_LIBRARY.length?EX_LIBRARY.length+' exercises':'Default';
}

