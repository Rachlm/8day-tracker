let _editProgId = null; // null = Normal Training, string = custom program being exercise-edited

function _getEditPlan() {
  if(_editProgId){const p=PROGRAMS.find(p=>p.id===_editProgId);if(p){if(!p.plan)p.plan={};return p.plan;}}
  return PLAN;
}
function _getEditCycle() {
  if(_editProgId){
    const p=PROGRAMS.find(prog=>prog.id===_editProgId);
    if(p)return p.cyclePattern.map((dt,i)=>({idx:'D'+(i+1),dayType:dt,label:dt}));
  }
  return activeCycle();
}
function _saveEditPlan(){if(_editProgId)savePrograms();else saveMeta();}
let PR_PREFS = JSON.parse(localStorage.getItem('tr-pr-prefs-v1') || 'null');
let currentProgressEx = null, progressChart = null, volumeChart = null;
let kpiChart = null, kpiDay = 'D2', kpiMetric = 'volume';
let calViewDate = new Date();
let progEditDay = null;
let pendingSession = null, selectedDifficulty = 'Moderate', newExType = 'reps', _editLibExType = 'reps', _editLibExName = '';

// Time-based exercises that are built-in (can add more via library)
const TIME_EX_DEFAULTS = new Set(['Plank (Bodyweight)','Dead Hang (Bodyweight)','Wall Sit (Bodyweight)','L-Sit (Bodyweight)']);

const all = () => [...H, ...US].sort((a,b) => a.date.localeCompare(b.date));

// ── EXERCISE TYPE ──────────────────────────────────────────────────────────
function isTimeBased(name) {
  const lib = EX_LIBRARY.find(e => e.name === name);
  if (lib) return lib.type === 'time';
  return TIME_EX_DEFAULTS.has(name);
}

// ── CYCLE ──────────────────────────────────────────────────────────────────
function _getCycleInfoNormal(dateStr) {
  const anchor = dateStr >= '2026-04-27' ? '2026-04-04' : '2026-04-03';
  const d = new Date(dateStr+'T00:00:00');
  const rawDiff = Math.round((d - new Date(anchor+'T00:00:00')) / 86400000);
  if (rawDiff < 0) return { isPre:true, label:'Prep', dayType:null, dayName:'', cycleLabel:'Prep' };

  if (VACATION) {
    const vStart = new Date(VACATION.start+'T00:00:00');
    const vEnd   = new Date(VACATION.end+'T00:00:00');
    // During vacation — cycle is paused
    if (d >= vStart && d <= vEnd) {
      const daysLeft = Math.max(0, Math.floor((vEnd - d) / 86400000));
      return { isVacation:true, vacationName:VACATION.name, label:VACATION.name,
               cycleLabel:VACATION.name, dayType:null, dayName:'', cycleNum:0, idx:-1, isPre:false, daysLeft };
    }
    // After vacation — subtract vacation duration so cycle resumes from correct position
    if (d > vEnd) {
      const vDays = Math.round((vEnd - vStart) / 86400000) + 1;
      const adj = rawDiff - vDays;
      if (adj < 0) return { isPre:true, label:'Prep', dayType:null, dayName:'', cycleLabel:'Prep' };
      const idx2 = ((adj % 8) + 8) % 8;
      const cn2  = Math.floor(adj / 8) + 1;
      const dt2  = CYCLE_PATTERN[idx2], dn2 = DAY_NAMES[idx2], cl2 = 'C'+cn2;
      return { isPre:false, cycleNum:cn2, cycleLabel:cl2, dayName:dn2, dayType:dt2, label:cl2+'·'+dn2, idx:idx2 };
    }
  }

  const idx = ((rawDiff % 8) + 8) % 8;
  const cycleNum = Math.floor(rawDiff / 8) + 1;
  const dayType = CYCLE_PATTERN[idx], dayName = DAY_NAMES[idx], cycleLabel = 'C'+cycleNum;
  return { isPre:false, cycleNum, cycleLabel, dayName, dayType, label:cycleLabel+'·'+dayName, idx };
}

function _getActiveProgramEntry(dateStr) {
  if (!PROGRAM_SCHEDULE.length) return null;
  return PROGRAM_SCHEDULE
    .filter(e => e.startDate <= dateStr && (!e.endDate || e.endDate > dateStr))
    .sort((a,b) => b.startDate.localeCompare(a.startDate))[0] || null;
}

function _getActiveCustomProgram(dateStr) {
  const entry = _getActiveProgramEntry(dateStr);
  if (!entry || entry.programId === 'normal') return null;
  const prog = PROGRAMS.find(p => p.id === entry.programId);
  return prog ? {prog, entry} : null;
}

function _getCustomProgCycleInfo(dateStr, prog, entry) {
  const anchor = new Date(entry.startDate + 'T00:00:00');
  const d = new Date(dateStr + 'T00:00:00');
  const diff = Math.max(0, Math.round((d - anchor) / 86400000));
  const cycleLen = prog.cyclePattern.length;
  const rawCycle = Math.floor(diff / cycleLen);
  const cycleNum = rawCycle + (entry.startCycleNum || 1);
  const idx = diff % cycleLen;
  let dayType = prog.cyclePattern[idx] || 'REST';
  // Missed-day rule: the calendar decides training vs rest, the last logged workout decides which one
  if (prog.nextInOrder && dayType !== 'REST') dayType = _nextInOrderType(dateStr, prog, entry);
  const dayName = 'D' + (idx + 1);
  const cycleLabel = 'C' + cycleNum;
  const label = prog.name.slice(0,4).toUpperCase() + '·' + cycleLabel + '·' + dayName;
  return { isPre:false, isCustomProg:true, programId:prog.id, programName:prog.name, programColor:prog.color||'var(--accent)', cycleNum, cycleLabel, dayName, dayType, label, idx };
}

// ── MISSED-DAY RULE ("next workout in order, no doubling up") ─────────────
// Calendar decides whether a date is a training day; the order of logged
// workouts decides WHICH workout it is. One workout per day.
function _progPatternType(dateStr, prog, entry) {
  const diff = Math.round((new Date(dateStr+'T00:00:00') - new Date(entry.startDate+'T00:00:00')) / 86400000);
  if (diff < 0) return null;
  return prog.cyclePattern[diff % prog.cyclePattern.length] || 'REST';
}
function _isTrainingDay(dateStr, prog, entry) {
  if (DAY_OVERRIDES.hasOwnProperty(dateStr)) { const o = DAY_OVERRIDES[dateStr]; return !!o && o !== 'REST' && o !== 'NONE'; }
  const t = _progPatternType(dateStr, prog, entry);
  return !!t && t !== 'REST';
}
// Position in the workout sequence after a list of logged sessions (sorted by date)
function _seqPosAfter(sessions, seq) {
  let p = 0;
  sessions.forEach(s => {
    for (let k = 0; k < seq.length; k++) {
      if (seq[(p + k) % seq.length] === s.dayType) { p = p + k + 1; break; }
    }
  });
  return p;
}
function _nextInOrderType(dateStr, prog, entry) {
  const seq = prog.cyclePattern.filter(t => t && t !== 'REST');
  if (!seq.length) return 'REST';
  const types = new Set(seq);
  const sess = all().filter(s => s.date >= entry.startDate && types.has(s.dayType));
  // Already logged on this date → show what was done (no doubling up)
  const onDay = sess.filter(s => s.date === dateStr);
  if (onDay.length) return onDay[onDay.length - 1].dayType;
  let pos = _seqPosAfter(sess.filter(s => s.date < dateStr), seq);
  // Future dates: assume each open training day from today until then gets done in order
  const today = todayStr();
  if (dateStr > today) {
    const logged = new Set(sess.map(s => s.date));
    const d = new Date(today + 'T00:00:00');
    let guard = 0;
    while (guard++ < 400) {
      const ds = `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
      if (ds >= dateStr) break;
      if (!logged.has(ds) && _isTrainingDay(ds, prog, entry)) pos++;
      d.setDate(d.getDate() + 1);
    }
  }
  return seq[pos % seq.length];
}

function getCycleInfo(dateStr) {
  const custom = _getActiveCustomProgram(dateStr);
  if (custom) return _getCustomProgCycleInfo(dateStr, custom.prog, custom.entry);
  return _getCycleInfoNormal(dateStr);
}

function getActivePlanEx(dayType, dateStr) {
  const custom = _getActiveCustomProgram(dateStr || todayStr());
  if (custom) {
    const groups = custom.prog.plan?.[dayType] || [];
    return groups.length ? groups.map(g=>({g:g.g,ex:[...g.ex]})) : [{g:'Exercises',ex:[]}];
  }
  return getPlanEx(dayType);
}

function todayStr() {
  const d=new Date();
  return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
}

// Returns the effective dayType for a date — override takes priority over cycle calc
function getDayType(dateStr) {
  if (DAY_OVERRIDES.hasOwnProperty(dateStr)) return DAY_OVERRIDES[dateStr]; // 'NONE' = cleared
  return getCycleInfo(dateStr).dayType;
}

// ── EX UTILS ──────────────────────────────────────────────────────────────
function getPrevPerf(exName, beforeDate) {
  const sessions = all().filter(s => s.date < beforeDate);
  for (let i = sessions.length - 1; i >= 0; i--) {
    const ex = sessions[i].exercises.find(e => e.name === exName);
    if (ex && ex.sets.length) {
      const ws = ex.sets.map(s => s.w).filter(w => w > 0);
      const rs = ex.sets.map(s => s.r).filter(r => r > 0);
      return { w: ws.length ? Math.max(...ws) : 0, r: rs.length ? Math.max(...rs) : 0, label: sessions[i].label };
    }
  }
  return null;
}

function getPrevSets(exName, beforeDate) {
  const sessions = all().filter(s => s.date < beforeDate);
  for (let i = sessions.length - 1; i >= 0; i--) {
    const ex = sessions[i].exercises.find(e => e.name === exName);
    if (ex && ex.sets.length) return { sets: ex.sets, label: sessions[i].label };
  }
  return null;
}

function calcVolume(sess) {
  return sess.exercises.reduce((a,ex)=>a+ex.sets.reduce((b,s)=>b+(s.wu?0:(s.r||0)*(s.w||0)),0),0);
}

function toggleWarmup(ei,si) {
  if(!activeWorkout)return;
  const set=activeWorkout.exercises[ei].sets[si];
  set.wu=!set.wu;
  const mode=localStorage.getItem('tr-wk-mode-v1')||'focus';
  if(mode==='focus'){
    renderWkEx();
  } else {
    const ex=activeWorkout.exercises[ei];
    const ps=getPrevSets(ex.name,activeWorkout.date);
    const tb=isTimeBased(ex.name);
    const row=document.getElementById(`sr-${ei}-${si}`);
    if(row)row.outerHTML=setRowHTML(ei,si,set,ps?.sets[si]||null,tb);
  }
  persistWorkout();
}

function getExHistory(exName) {
  return all().map(s => {
    const ex0 = s.exercises.find(e => e.name === exName);
    if (!ex0) return null;
    const ex = {...ex0, sets: ex0.sets.filter(st => !st.wu)};
    if (!ex.sets.length) return null;
    const topSet = ex.sets.filter(s => s.w > 0).reduce((best, s) => (s.w > (best?.w || 0) ? s : best), null);
    const bwSets = ex.sets.filter(s => (!s.w || s.w === 0) && s.r > 0);
    const w = topSet?.w || 0;
    const r = topSet ? (topSet.r || 0) : (bwSets.length ? Math.max(...bwSets.map(s => s.r)) : 0);
    return { label:s.label, date:s.date, w, r };
  }).filter(Boolean);
}

function isBW(nm) { return /\(Bodyweight/.test(nm) || getExHistory(nm).every(p => p.w === 0); }
function allExNames() { const s=new Set(); all().forEach(sess=>sess.exercises.forEach(e=>s.add(e.name))); return [...s].sort(); }

function getPlanEx(dayType) {
  const groups = PLAN[dayType] || [];
  const custom = CUSTOM_EX[dayType] || [];
  const result = groups.map(g => ({ g:g.g, ex:[...g.ex] }));
  if (custom.length) result.push({ g:'Custom', ex:custom });
  return result;
}

// ── FIREBASE ───────────────────────────────────────────────────────────────
let db=null, fbReady=false, unsubS=null, unsubM=null;
const FB_CONFIG = {
  apiKey:"AIzaSyDw6UuAMDdLnqaXcdcrK20I6UGjD-P_PLg",
  authDomain:"training-tracker-1d839.firebaseapp.com",
  projectId:"training-tracker-1d839",
  storageBucket:"training-tracker-1d839.firebasestorage.app",
  messagingSenderId:"28856945546",
  appId:"1:28856945546:web:ccb86d3dbcf85c11f99673"
};
const TK = 'tr-trainer-id';

function setSyncUI(state, label) {
  const d=document.getElementById('sync-dot'), l=document.getElementById('sync-label');
  if(d){d.className='sdot '+state;}
  if(l)l.textContent=label;
}

function trainerId() {
  let id=localStorage.getItem(TK);
  if(!id){id='trainer_'+Date.now()+'_'+Math.random().toString(36).slice(2,8);localStorage.setItem(TK,id);}
  return id;
}

async function initFirebase() {
  try {
    if(!firebase.apps.length)firebase.initializeApp(FB_CONFIG);
    db=firebase.firestore();
    db.settings({ experimentalForceLongPolling: true, merge: true });
    fbReady=true;setSyncUI('syncing','Connecting…');startListeners();
  } catch(e){setSyncUI('err','Offline');}
}

function startListeners() {
  const tid=trainerId();
  if(unsubS)unsubS();if(unsubM)unsubM();
  unsubS=db.collection(`trainers/${tid}/sessions`).onSnapshot(snap=>{
    US=snap.docs.map(d=>d.data());
    // Always ensure holiday sessions exist — add+save to Firebase if not present
    _HOL_SESSIONS.forEach(sess=>{
      if(!US.find(s=>s.id===sess.id)){
        US.push(sess);
        db.doc(`trainers/${tid}/sessions/${sess.id}`).set(sess).catch(()=>{});
      }
    });
    localStorage.setItem('tr-sess-v4',JSON.stringify(US));
    try{ migrateSessionNames(); }catch(e){ console.error('name migration',e); }
    _clearPrCache();
    setSyncUI('ok','Synced');refreshActiveView();
  },()=>setSyncUI('err','Offline'));
  unsubM=db.doc(`trainers/${tid}/meta`).onSnapshot(snap=>{
    if(snap.exists&&snap.data().custom){CUSTOM_EX=snap.data().custom;localStorage.setItem('tr-custom-v2',JSON.stringify(CUSTOM_EX));}
    if(snap.exists&&snap.data().plan){PLAN=snap.data().plan;localStorage.setItem('tr-plan-v1',JSON.stringify(PLAN));}
    if(snap.exists&&snap.data().exLib){EX_LIBRARY=snap.data().exLib;localStorage.setItem('tr-exlib-v1',JSON.stringify(EX_LIBRARY));}
    if(snap.exists&&snap.data().cycle){CUSTOM_CYCLE=snap.data().cycle;localStorage.setItem('tr-cycle-v1',JSON.stringify(CUSTOM_CYCLE));}
    if(snap.exists&&snap.data().dayOverrides){DAY_OVERRIDES=snap.data().dayOverrides;localStorage.setItem('tr-day-ov-v1',JSON.stringify(DAY_OVERRIDES));}
    if(snap.exists&&snap.data().profile){PROFILE=snap.data().profile;localStorage.setItem('tr-profile-v1',JSON.stringify(PROFILE));}
    if(snap.exists&&snap.data().bwLog){BW_LOG=snap.data().bwLog;localStorage.setItem('tr-bw-v1',JSON.stringify(BW_LOG));renderBwChart();}
    if(snap.exists&&snap.data().programs){PROGRAMS=snap.data().programs;localStorage.setItem('tr-programs-v1',JSON.stringify(PROGRAMS));}
    if(snap.exists&&snap.data().programSchedule){PROGRAM_SCHEDULE=snap.data().programSchedule;localStorage.setItem('tr-prog-sched-v1',JSON.stringify(PROGRAM_SCHEDULE));}
    if(snap.exists&&'vacation' in snap.data()){VACATION=snap.data().vacation;localStorage.setItem('tr-vacation-v1',JSON.stringify(VACATION));}
    try{ migrateMetaNames(); }catch(e){ console.error('name migration',e); }
  },()=>{});
}

async function saveSession(sess) {
  US.push(sess);localStorage.setItem('tr-sess-v4',JSON.stringify(US));_clearPrCache();
  if(!fbReady||!db)return;
  setSyncUI('syncing','Saving…');
  const tid=trainerId();
  try{await db.doc(`trainers/${tid}/sessions/${sess.id}`).set(sess);setSyncUI('ok','Synced');}
  catch(e){setSyncUI('err','Save failed');}
}

async function updateSession(sess) {
  const idx=US.findIndex(s=>s.id===sess.id);
  if(idx===-1)return;
  US[idx]=sess;
  localStorage.setItem('tr-sess-v4',JSON.stringify(US));_clearPrCache();
  if(fbReady&&db){
    setSyncUI('syncing','Saving…');
    const tid=trainerId();
    try{await db.doc(`trainers/${tid}/sessions/${sess.id}`).set(sess);setSyncUI('ok','Synced');}
    catch(e){setSyncUI('err','Save failed');}
  }
  refreshActiveView();
}

async function deleteSession(id) {
  if(!confirm('Delete this session? This cannot be undone.'))return;
  US=US.filter(s=>s.id!==id);
  localStorage.setItem('tr-sess-v4',JSON.stringify(US));_clearPrCache();
  if(fbReady&&db){
    setSyncUI('syncing','Deleting…');
    const tid=trainerId();
    try{await db.doc(`trainers/${tid}/sessions/${id}`).delete();setSyncUI('ok','Synced');}
    catch(e){setSyncUI('err','Delete failed');}
  }
  closeEditSession();closeDetail();refreshActiveView();
}

let editSession=null, currentDetailId=null;

function openEditSession(id) {
  const s=US.find(x=>x.id===id);
  if(!s){return;}
  editSession=JSON.parse(JSON.stringify(s));
  document.getElementById('edit-title').textContent=s.label;
  renderEditInner();
  document.getElementById('edit-overlay').classList.add('open');
}

function closeEditSession() {
  document.getElementById('edit-overlay').classList.remove('open');
  editSession=null;
}

function renderEditInner() {
  if(!editSession)return;
  const durMin=editSession.duration?Math.round(editSession.duration/60):'';
  document.getElementById('edit-inner').innerHTML=
    `<div style="padding:0 0 16px;border-bottom:1px solid var(--border);margin-bottom:16px">
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px">
        <div style="font-size:13px;color:var(--text2);font-weight:600;flex-shrink:0;width:110px">Duration (min)</div>
        <input id="edit-duration" type="number" inputmode="numeric" min="1" max="300" placeholder="e.g. 45" value="${durMin}" style="flex:1;padding:8px 10px;background:var(--bg3);border:1px solid var(--border);border-radius:8px;color:var(--text);font-family:'DM Mono',monospace;font-size:14px;outline:none;text-align:center">
      </div>
      <div style="display:flex;align-items:flex-start;gap:10px">
        <div style="font-size:13px;color:var(--text2);font-weight:600;flex-shrink:0;width:110px;padding-top:9px">Notes</div>
        <textarea id="edit-notes" placeholder="Add a note…" rows="2" style="flex:1;padding:8px 10px;background:var(--bg3);border:1px solid var(--border);border-radius:8px;color:var(--text);font-family:inherit;font-size:13px;outline:none;resize:none;line-height:1.5">${editSession.notes||''}</textarea>
      </div>
    </div>`+
    editSession.exercises.map((ex,ei)=>
      `<div class="exb" id="eexb-${ei}">
        <div class="exbh">
          <div><div class="exbn">${ex.name}</div><div class="exbs" id="eexbs-${ei}">${ex.sets.length} set${ex.sets.length!==1?'s':''}</div></div>
          <button onclick="deleteEditEx(${ei})" style="font-size:12px;color:var(--red);background:none;border:none;cursor:pointer;font-family:inherit;font-weight:600;padding:4px 8px;flex-shrink:0">Remove</button>
        </div>
        <div class="stbl" id="estbl-${ei}">
          ${editTableHTML(ei,ex)}
        </div>
      </div>`
    ).join('')+
    `<div style="margin-top:24px">
      <button onclick="deleteSession('${editSession.id}')" style="width:100%;padding:14px;background:none;border:1px solid var(--red);border-radius:12px;color:var(--red);font-family:inherit;font-size:14px;font-weight:600;cursor:pointer">🗑 Delete Session</button>
    </div>`;
}

function editTableHTML(ei,ex) {
  return `<div class="sth" style="grid-template-columns:30px 1fr 1fr 40px"><span>#</span><span>Reps</span><span>kg</span><span></span></div>`+
    ex.sets.map((s,si)=>editSetRowHTML(ei,si,s)).join('')+
    `<div style="padding:10px 12px;border-top:1px solid var(--border)">
      <button onclick="addEditSet(${ei})" style="font-size:12px;color:var(--blue);font-weight:600;background:none;border:none;cursor:pointer;font-family:inherit">+ Add Set</button>
    </div>`;
}

function editSetRowHTML(ei,si,set) {
  return `<div class="srow" id="esr-${ei}-${si}" style="grid-template-columns:30px 1fr 1fr 40px">
    <div class="snum">${si+1}</div>
    <input class="sinput" type="number" inputmode="numeric" placeholder="reps" value="${set.r!=null?set.r:''}" oninput="updEditSet(${ei},${si},'r',+this.value)">
    <input class="sinput" type="number" inputmode="decimal" step="0.5" placeholder="kg" value="${set.w!=null?set.w:''}" oninput="updEditSet(${ei},${si},'w',+this.value)">
    <button class="delbtn" onclick="deleteEditSet(${ei},${si})">✕</button>
  </div>`;
}

function updEditSet(ei,si,f,v){if(editSession)editSession.exercises[ei].sets[si][f]=v;}

function deleteEditSet(ei,si) {
  if(!editSession)return;
  editSession.exercises[ei].sets.splice(si,1);
  _refreshEditExBlock(ei);
}

function addEditSet(ei) {
  if(!editSession)return;
  const ex=editSession.exercises[ei];
  const last=ex.sets[ex.sets.length-1];
  ex.sets.push({r:last?.r||'',w:last?.w||'',done:true});
  _refreshEditExBlock(ei);
}

function deleteEditEx(ei) {
  if(!editSession||!confirm('Remove this exercise from the session?'))return;
  editSession.exercises.splice(ei,1);
  renderEditInner();
}

function _refreshEditExBlock(ei) {
  const ex=editSession.exercises[ei];
  const tbl=document.getElementById(`estbl-${ei}`);
  if(tbl)tbl.innerHTML=editTableHTML(ei,ex);
  const sub=document.getElementById(`eexbs-${ei}`);
  if(sub)sub.textContent=ex.sets.length+' set'+(ex.sets.length!==1?'s':'');
}

async function saveEditSession() {
  if(!editSession)return;
  const durInput=document.getElementById('edit-duration');
  if(durInput&&durInput.value)editSession.duration=Math.round(+durInput.value*60);
  const notesInput=document.getElementById('edit-notes');
  if(notesInput)editSession.notes=notesInput.value.trim();
  editSession.exercises=editSession.exercises
    .map(ex=>({...ex,sets:ex.sets.filter(s=>s.r||s.w)}))
    .filter(ex=>ex.sets.length>0);
  await updateSession(editSession);
  const savedId=editSession.id;
  closeEditSession();
  showDetail(savedId);
}

async function saveMeta() {
  localStorage.setItem('tr-custom-v2',JSON.stringify(CUSTOM_EX));
  localStorage.setItem('tr-plan-v1',JSON.stringify(PLAN));
  if(!fbReady||!db)return;
  const tid=trainerId();
  try{await db.doc(`trainers/${tid}/meta`).set({custom:CUSTOM_EX,plan:PLAN},{merge:true});}
  catch(e){}
}

async function saveLibrary() {
  localStorage.setItem('tr-exlib-v1',JSON.stringify(EX_LIBRARY));
  if(!fbReady||!db)return;
  const tid=trainerId();
  try{await db.doc(`trainers/${tid}/meta`).set({exLib:EX_LIBRARY},{merge:true});}
  catch(e){}
}

