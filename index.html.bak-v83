// ── EXPORT ─────────────────────────────────────────────────────────────────
function doExport(){
  const rows=[['Date','Label','Cycle','Day','Exercise','Set','Reps','Weight (kg)','Warm-up','Notes']];
  all().forEach(s=>s.exercises.forEach(ex=>ex.sets.forEach((st,i)=>rows.push([s.date,s.label,s.cycle,DAY_FULL_NAMES[s.dayType]||s.dayType,ex.name,i+1,st.r||0,st.w||0,st.wu?'yes':'',i===0?(s.notes||''):'']))));
  const csv=rows.map(r=>r.map(v=>`"${String(v).replace(/"/g,'""')}"`).join(',')).join('\n');
  const a=document.createElement('a');a.href='data:text/csv;charset=utf-8,\uFEFF'+encodeURIComponent(csv);a.download='training-'+todayStr()+'.csv';a.click();
}

// ── STREAK ──────────────────────────────────────────────────────────────────
function calcStreak() {
  const today = todayStr();
  const dates = new Set(all().filter(s => s.dayType !== 'REST' && s.date <= today).map(s => s.date));
  if (!dates.size) return 0;
  // Start from today if trained, otherwise yesterday
  let check = dates.has(today) ? today : (() => {
    return _addDays(today,-1);
  })();
  let streak = 0;
  while (dates.has(check)) {
    streak++;
    check = _addDays(check,-1);
  }
  return streak;
}

// ── SESSION PR CHECK ────────────────────────────────────────────────────────
const _prCache = {};
function _clearPrCache(){ for(const k in _prCache) delete _prCache[k]; _exSessCache={}; _exSessSig=''; }

function sessionHasPR(sess) {
  if(_prCache[sess.id] !== undefined) return _prCache[sess.id];
  // Saved sessions use the shared PR rule (estimated 1RM — more reps at the same weight counts)
  if(all().some(x=>x.id===sess.id)){
    const r=(sess.exercises||[]).some(ex=>exSessions(ex.name).some(e=>e.id===sess.id&&e.isPR));
    _prCache[sess.id]=r; return r;
  }
  const allSess = all();
  const result = sess.exercises.some(ex => {
    const bw = isBW(ex.name), tb = isTimeBased(ex.name);
    const prev = allSess.filter(s => s.date < sess.date);
    if (!prev.length) return false;
    const prevBest = prev.reduce((best, s) => {
      const e = s.exercises.find(e => e.name === ex.name);
      if (!e || !e.sets.length) return best;
      const val = (bw || tb)
        ? Math.max(...e.sets.map(st => st.r || 0))
        : Math.max(0, ...e.sets.filter(st => st.w > 0).map(st => st.w || 0));
      return Math.max(best, val);
    }, 0);
    if (prevBest === 0) return false;
    const sessVal = (bw || tb)
      ? Math.max(...ex.sets.map(st => st.r || 0))
      : Math.max(0, ...ex.sets.filter(st => st.w > 0).map(st => st.w || 0));
    return sessVal > prevBest;
  });
  _prCache[sess.id] = result;
  return result;
}

// ── PR PREFS ────────────────────────────────────────────────────────────────
const _PR_MG_DEFAULT = [
  'Bench Press (BB)','Bench Press (DB)','Incline Press (BB)','Incline Press (DB)','Chest Fly (DB)','Chest Fly (Cable)','Chest Press (Machine)','Decline Press (BB)','Decline Press (DB)',
  'Back Squat (BB)','Front Squat (BB)','Hack Squat (Machine)','Leg Press (Machine)','RDL (BB)','RDL (DB)','Leg Curl (Machine)','Leg Extension (Machine)','Bulgarian Split Squat (DB)','Bulgarian Split Squat (BB)','Lunge (DB)','Lunge (BB)','Calf Raise (Machine)',
  'Bent Over Row (BB)','Bent Over Row (DB)','Lat Pulldown (Machine)','Cable Row (Cable)','Seated Row (Machine)','Pull Up (Bodyweight)','Chin Up (Bodyweight)','Single Arm Row (DB)','T-Bar Row (BB)','Face Pull (Cable)',
  'Overhead Press (BB)','Overhead Press (DB)','Lateral Raise (DB)','Lateral Raise (Cable)','Front Raise (DB)','Arnold Press (DB)','Upright Row (BB)','Upright Row (DB)',
  'Bicep Curl (BB)','Bicep Curl (DB)','Hammer Curl (DB)','Preacher Curl (Machine)','Tricep Pushdown (Cable)','Skull Crusher (BB)','Overhead Tricep (Cable)','Dips (Bodyweight)','Close Grip Bench (BB)',
  'Plank (Bodyweight)','Cable Crunch (Cable)','Ab Wheel (Bodyweight)','Hanging Leg Raise (Bodyweight)','Dead Hang (Bodyweight)','L-Sit (Bodyweight)'
];

function getPrSelected() {
  if (PR_PREFS && Array.isArray(PR_PREFS.selected)) return PR_PREFS.selected.slice();
  const logged = new Set(allExNames());
  return _PR_MG_DEFAULT.filter(nm => logged.has(nm));
}

function savePrPrefs() {
  localStorage.setItem('tr-pr-prefs-v1', JSON.stringify(PR_PREFS));
}

function openPrEditSheet() {
  if (!PR_PREFS) {
    PR_PREFS = { selected: getPrSelected() };
    savePrPrefs();
  }
  renderPrEditSheet();
  document.getElementById('pr-edit-sheet').classList.add('open');
}

function closePrEditSheet() {
  document.getElementById('pr-edit-sheet').classList.remove('open');
}

function renderPrEditSheet() {
  const selected = getPrSelected();
  const allEx = allExNames().sort();
  const unselected = allEx.filter(nm => !selected.includes(nm));
  let html = '';
  if (selected.length) {
    html += `<div class="pr-sec-lbl">Shown — ${selected.length} exercise${selected.length !== 1 ? 's' : ''}</div>`;
    html += selected.map((nm, i) => `
      <div class="pr-ex-row">
        <button class="pr-mv" onclick="movePrEx(${i},-1)" ${i === 0 ? 'disabled' : ''}>↑</button>
        <button class="pr-mv" onclick="movePrEx(${i},1)" ${i === selected.length - 1 ? 'disabled' : ''}>↓</button>
        <div class="pr-ex-name">${nm}</div>
        <button class="pr-rm" onclick="removePrEx('${nm.replace(/'/g, "\\'")}')">✕</button>
      </div>`).join('');
  }
  if (unselected.length) {
    html += `<div class="pr-sec-lbl">Add exercise</div>`;
    html += unselected.map(nm => `
      <div class="pr-ex-row">
        <div class="pr-ex-name" style="color:var(--text2)">${nm}</div>
        <button class="pr-add" onclick="addPrEx('${nm.replace(/'/g, "\\'")}')">+</button>
      </div>`).join('');
  }
  document.getElementById('pr-edit-body').innerHTML = html;
}

function movePrEx(idx, dir) {
  const sel = getPrSelected();
  const newIdx = idx + dir;
  if (newIdx < 0 || newIdx >= sel.length) return;
  [sel[idx], sel[newIdx]] = [sel[newIdx], sel[idx]];
  PR_PREFS = { selected: sel };
  savePrPrefs();
  renderPrEditSheet();
  renderProfile();
}

function removePrEx(nm) {
  const sel = getPrSelected().filter(x => x !== nm);
  PR_PREFS = { selected: sel };
  savePrPrefs();
  renderPrEditSheet();
  renderProfile();
}

function addPrEx(nm) {
  const sel = getPrSelected();
  if (!sel.includes(nm)) sel.push(nm);
  PR_PREFS = { selected: sel };
  savePrPrefs();
  renderPrEditSheet();
  renderProfile();
}

// ── PROGRAMS ──────────────────────────────────────────────────────────────

function savePrograms(){
  localStorage.setItem('tr-programs-v1',JSON.stringify(PROGRAMS));
  if(fbReady&&db){const tid=trainerId();db.doc(`trainers/${tid}/meta`).set({programs:PROGRAMS},{merge:true}).catch(()=>{});}
}
function saveProgramSchedule(){
  localStorage.setItem('tr-prog-sched-v1',JSON.stringify(PROGRAM_SCHEDULE));
  if(fbReady&&db){const tid=trainerId();db.doc(`trainers/${tid}/meta`).set({programSchedule:PROGRAM_SCHEDULE},{merge:true}).catch(()=>{});}
}

function openProgramsOverlay(){_editProgId=null;renderProgramsManager();document.getElementById('programs-overlay').classList.add('open');}
function openCustomProgExerciseEditor(progId){_editProgId=progId;closeProgramsOverlay();switchView('program');}
function closeProgramsOverlay(){document.getElementById('programs-overlay').classList.remove('open');}

function renderProgramsManager(){
  const today=todayStr();
  const activeEntry=_getActiveProgramEntry(today);
  const activeId=activeEntry?.programId||'normal';
  const inner=document.getElementById('programs-inner');if(!inner)return;

  // Helper: get last position label for a program
  function lastPosLabel(progId){
    if(progId==='normal'){
      const ns=all().filter(s=>!_getCycleInfoNormal(s.date).isPre).sort((a,b)=>b.date.localeCompare(a.date));
      return ns.length?ns[0].label:'C1·D2';
    }
    const prog=PROGRAMS.find(p=>p.id===progId);
    const prevEntry=PROGRAM_SCHEDULE.filter(e=>e.programId===progId&&e.endDate).sort((a,b)=>b.endDate.localeCompare(a.endDate))[0];
    if(!prog||!prevEntry)return'W1·D1';
    const d=Math.max(0,Math.round((new Date(prevEntry.endDate+'T00:00:00')-new Date(prevEntry.startDate+'T00:00:00'))/86400000));
    const cn=prevEntry.startCycleNum+Math.floor(d/prog.cyclePattern.length);
    return prog.name.slice(0,4).toUpperCase()+'·W'+cn;
  }

  // Normal Training card
  const normalPaused=activeId!=='normal';
  const normalHadHistory=all().some(s=>!_getCycleInfoNormal(s.date).isPre);
  let html=`<div class="prog-card${activeId==='normal'?' prog-active':''}">
    <div style="display:flex;justify-content:space-between;align-items:flex-start">
      <div>
        <div style="font-size:10px;font-weight:700;color:var(--text3);font-family:var(--fb);letter-spacing:.1em;margin-bottom:4px">DEFAULT</div>
        <div class="prog-card-name">🏋️ Normal Training</div>
        <div class="prog-card-sub">${activeCycle().length}-day cycle</div>
      </div>
      ${activeId==='normal'
        ?`<span class="v4pill accent">● ACTIVE</span>`
        :`<span class="v4pill" style="color:var(--text3);border-color:var(--border)">⏸ ${lastPosLabel('normal')}</span>`}
    </div>
    <div class="prog-card-btns">
      ${normalPaused?`<button class="prog-card-btn primary" onclick="openActivateProgSheet('normal')">Resume</button>`:''}
      <button class="prog-card-btn secondary" onclick="closeProgramsOverlay();switchView('program')">Edit</button>
    </div>
  </div>`;

  // Custom programs
  PROGRAMS.forEach(prog=>{
    const isActive=activeId===prog.id;
    const hasPrev=PROGRAM_SCHEDULE.some(e=>e.programId===prog.id&&e.endDate);
    const col=prog.color||'var(--accent)';
    html+=`<div class="prog-card${isActive?' prog-active':''}" style="border-left-color:${col}">
      <div style="display:flex;justify-content:space-between;align-items:flex-start">
        <div>
          <div class="prog-card-name">${prog.emoji||'📋'} ${prog.name}</div>
          <div class="prog-card-sub">${prog.cyclePattern.length}-day cycle · ${prog.cyclePattern.filter(d=>d!=='REST').length} training days</div>
        </div>
        ${isActive
          ?`<span class="v4pill" style="color:${col};background:${col}18;border-color:${col}44">● ACTIVE</span>`
          :hasPrev?`<span class="v4pill" style="color:var(--text3);border-color:var(--border)">⏸ ${lastPosLabel(prog.id)}</span>`:''}
      </div>
      <div class="prog-card-btns">
        ${!isActive?`<button class="prog-card-btn primary" onclick="openActivateProgSheet('${prog.id}')">Activate</button>`:''}
        <button class="prog-card-btn secondary" onclick="openCustomProgExerciseEditor('${prog.id}')">Exercises</button>
        <button class="prog-card-btn secondary" onclick="openEditProgSheet('${prog.id}')">Edit</button>
        ${!isActive?`<button class="prog-card-btn danger" onclick="deleteCustomProg('${prog.id}')">✕</button>`:''}
      </div>
    </div>`;
  });

  inner.innerHTML=html+`<button onclick="openNewProgSheet()" style="width:100%;margin-top:6px;padding:14px;background:transparent;border:1px dashed var(--border);border-radius:14px;color:var(--text3);font-family:var(--fb);font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;cursor:pointer">+ Create new program</button>`;
}

// ── ACTIVATE / SWITCH ──────────────────────────────────────────────────────

function openActivateProgSheet(progId){
  _activatingProgId=progId;
  const prog=progId==='normal'?null:PROGRAMS.find(p=>p.id===progId);
  const progName=prog?`${prog.emoji||''} ${prog.name}`:'🏋️ Normal Training';
  const hasPrev=progId==='normal'
    ?all().some(s=>!_getCycleInfoNormal(s.date).isPre)
    :PROGRAM_SCHEDULE.some(e=>e.programId===progId&&e.endDate);
  let lastPos='';
  if(hasPrev){
    if(progId==='normal'){
      const ns=all().filter(s=>!_getCycleInfoNormal(s.date).isPre).sort((a,b)=>b.date.localeCompare(a.date));
      lastPos=ns.length?ns[0].label:'';
    } else {
      const prevEntry=PROGRAM_SCHEDULE.filter(e=>e.programId===progId&&e.endDate).sort((a,b)=>b.endDate.localeCompare(a.endDate))[0];
      if(prevEntry&&prog){
        const d=Math.max(0,Math.round((new Date(prevEntry.endDate+'T00:00:00')-new Date(prevEntry.startDate+'T00:00:00'))/86400000));
        const cn=prevEntry.startCycleNum+Math.floor(d/prog.cyclePattern.length);
        lastPos='Week '+cn;
      }
    }
  }
  const el=document.getElementById('activate-prog-inner');
  el.innerHTML=`
    <div style="font-size:18px;font-weight:700;margin-bottom:4px">Activate ${progName}</div>
    <div style="font-size:13px;color:var(--text3);margin-bottom:20px">Where would you like to start?</div>
    ${hasPrev&&lastPos?`<button class="prog-switch-btn highlight" onclick="confirmActivate('${progId}','continue')">
      <div style="font-size:13px;font-weight:700;color:var(--text)">Continue where I left off</div>
      <div style="font-size:11px;color:var(--text3);margin-top:3px;font-family:var(--fm)">${lastPos}</div>
    </button>`:''}
    <button class="prog-switch-btn" onclick="confirmActivate('${progId}','fresh')">
      <div style="font-size:13px;font-weight:700;color:var(--text)">Start fresh</div>
      <div style="font-size:11px;color:var(--text3);margin-top:3px;font-family:var(--fm)">Reset to Cycle 1</div>
    </button>`;
  document.getElementById('activate-prog-sheet').classList.add('open');
}

function closeActivateProgSheet(){document.getElementById('activate-prog-sheet').classList.remove('open');}

function confirmActivate(progId,mode){
  closeActivateProgSheet();
  const today=todayStr();
  // End current active entry
  PROGRAM_SCHEDULE.forEach(e=>{if(!e.endDate)e.endDate=today;});
  let startCycleNum=1;
  if(mode==='continue'){
    if(progId==='normal'){
      const info=_getCycleInfoNormal(today);
      startCycleNum=Math.max(1,info.cycleNum);
    } else {
      const prog=PROGRAMS.find(p=>p.id===progId);
      const prevEntry=PROGRAM_SCHEDULE.filter(e=>e.programId===progId&&e.endDate).sort((a,b)=>b.endDate.localeCompare(a.endDate))[0];
      if(prog&&prevEntry){
        const d=Math.max(0,Math.round((new Date(prevEntry.endDate+'T00:00:00')-new Date(prevEntry.startDate+'T00:00:00'))/86400000));
        startCycleNum=prevEntry.startCycleNum+Math.floor(d/prog.cyclePattern.length);
      }
    }
  }
  // For normal training, no schedule entry needed (default)
  if(progId!=='normal'){
    PROGRAM_SCHEDULE.push({id:'sched_'+Date.now(),programId:progId,startDate:today,startCycleNum,endDate:null});
    saveProgramSchedule();
  }
  savePrograms();saveProgramSchedule();
  renderProgramsManager();renderProfile();refreshActiveView();
}

function deleteCustomProg(progId){
  if(!confirm('Delete this program? This cannot be undone.'))return;
  PROGRAMS=PROGRAMS.filter(p=>p.id!==progId);
  PROGRAM_SCHEDULE=PROGRAM_SCHEDULE.filter(e=>e.programId!==progId);
  savePrograms();saveProgramSchedule();renderProgramsManager();
}

// ── CREATE / EDIT PROGRAM ──────────────────────────────────────────────────

const PROG_DAY_OPTIONS=[
  {value:'WORKOUT A',label:'Strength Day'},
  {value:'WORKOUT B',label:'Shape Day'},
  {value:'WORKOUT C',label:'Workout C'},
  {value:'FULL BODY',label:'Full Body'},
  {value:'UPPER BODY',label:'Upper Body'},
  {value:'LOWER BODY',label:'Lower Body'},
  {value:'PUSH (Hypertrophy)',label:'Push · Hypertrophy'},
  {value:'LEGS (Strength)',label:'Legs · Strength'},
  {value:'PULL',label:'Pull'},
  {value:'PUSH (Strength)',label:'Push · Strength'},
  {value:'LEGS (Hypertrophy)',label:'Legs · Hypertrophy'},
  {value:'CARDIO',label:'Cardio'},
  {value:'REST',label:'Rest Day'},
];
const PROG_COLORS=['#d4ff3a','#22c55e','#3b82f6','#f97316','#a855f7','#f59e0b','#ef4444','#06b6d4'];

function openNewProgSheet(){
  _editingProgId=null;
  _newProgDays=[{type:'FULL BODY'},{type:'REST'},{type:'FULL BODY'}];
  _newProgColor=PROG_COLORS[0];
  _newProgEmoji='💪';
  _renderNewProgSheet('','',false);
  document.getElementById('new-prog-sheet').classList.add('open');
}

function openEditProgSheet(progId){
  const prog=PROGRAMS.find(p=>p.id===progId);if(!prog)return;
  _editingProgId=progId;
  _newProgDays=prog.cyclePattern.map(t=>({type:t}));
  _newProgColor=prog.color||PROG_COLORS[0];
  _newProgEmoji=prog.emoji||'💪';
  _renderNewProgSheet(prog.name,prog.emoji||'💪',true);
  document.getElementById('new-prog-sheet').classList.add('open');
}

function closeNewProgSheet(){document.getElementById('new-prog-sheet').classList.remove('open');}

function _renderNewProgSheet(nameVal,emojiVal,isEdit){
  const optHtml=PROG_DAY_OPTIONS.map(o=>`<option value="${o.value}">${o.label}</option>`).join('');
  const slotsHtml=_newProgDays.map((d,i)=>`
    <div class="prog-day-slot">
      <div class="prog-day-num">D${i+1}</div>
      <select class="prog-day-sel" onchange="_updateProgDay(${i},this.value)">${PROG_DAY_OPTIONS.map(o=>`<option value="${o.value}"${o.value===d.type?' selected':''}>${o.label}</option>`).join('')}</select>
      <button onclick="_removeProgDay(${i})" style="background:none;border:none;color:var(--text4);cursor:pointer;font-size:18px;padding:2px 6px;line-height:1;flex-shrink:0">−</button>
    </div>`).join('');
  const colorsHtml=PROG_COLORS.map(c=>`<div class="prog-color-sw${c===_newProgColor?' sel':''}" style="background:${c}" onclick="_selectProgColor('${c}')"></div>`).join('');
  document.getElementById('new-prog-inner').innerHTML=`
    <div style="font-size:18px;font-weight:700;margin-bottom:16px">${isEdit?'Edit Program':'New Program'}</div>
    <div style="font-size:10px;font-weight:700;color:var(--text3);letter-spacing:.08em;text-transform:uppercase;font-family:var(--fb);margin-bottom:6px">Name</div>
    <input id="new-prog-name" type="text" placeholder="e.g. Holiday, Summer…" value="${nameVal}" style="width:100%;padding:11px 12px;background:var(--bg3);border:1px solid var(--border);border-radius:10px;color:var(--text);font-family:inherit;font-size:14px;outline:none;box-sizing:border-box;margin-bottom:14px">
    <div style="display:flex;gap:10px;margin-bottom:14px">
      <div style="flex:1">
        <div style="font-size:10px;font-weight:700;color:var(--text3);letter-spacing:.08em;text-transform:uppercase;font-family:var(--fb);margin-bottom:6px">Emoji</div>
        <input id="new-prog-emoji" type="text" value="${emojiVal}" maxlength="2" style="width:100%;padding:11px 12px;background:var(--bg3);border:1px solid var(--border);border-radius:10px;color:var(--text);font-family:inherit;font-size:18px;outline:none;box-sizing:border-box;text-align:center">
      </div>
      <div style="flex:2">
        <div style="font-size:10px;font-weight:700;color:var(--text3);letter-spacing:.08em;text-transform:uppercase;font-family:var(--fb);margin-bottom:6px">Color</div>
        <div class="prog-color-row">${colorsHtml}</div>
      </div>
    </div>
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
      <div style="font-size:10px;font-weight:700;color:var(--text3);letter-spacing:.08em;text-transform:uppercase;font-family:var(--fb)">Cycle Days (${_newProgDays.length})</div>
      <button onclick="_addProgDay()" style="font-size:10px;font-weight:700;color:var(--accent);background:none;border:none;cursor:pointer;font-family:var(--fb);letter-spacing:.06em">+ Add Day</button>
    </div>
    <div id="prog-day-slots" style="background:var(--bg3);border-radius:10px;padding:0 12px;margin-bottom:16px">${slotsHtml}</div>
    <button onclick="_saveProgram()" style="width:100%;padding:14px;background:${_newProgColor};color:#0a0a0a;font-family:var(--fb);font-size:13px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;border:none;border-radius:12px;cursor:pointer">${isEdit?'Save Changes':'Create Program'}</button>`;
}

function _updateProgDay(i,val){_newProgDays[i].type=val;}
function _removeProgDay(i){
  if(_newProgDays.length<=1)return;
  _newProgDays.splice(i,1);
  _renderNewProgSheet(document.getElementById('new-prog-name')?.value||'',document.getElementById('new-prog-emoji')?.value||'💪',!!_editingProgId);
}
function _addProgDay(){
  _newProgDays.push({type:'REST'});
  _renderNewProgSheet(document.getElementById('new-prog-name')?.value||'',document.getElementById('new-prog-emoji')?.value||'💪',!!_editingProgId);
}
function _selectProgColor(col){
  _newProgColor=col;
  _renderNewProgSheet(document.getElementById('new-prog-name')?.value||'',document.getElementById('new-prog-emoji')?.value||'💪',!!_editingProgId);
}

function _saveProgram(){
  const name=document.getElementById('new-prog-name')?.value.trim();
  const emoji=document.getElementById('new-prog-emoji')?.value.trim()||'💪';
  if(!name){alert('Please enter a program name.');return;}
  if(_newProgDays.length<1){alert('Add at least one day.');return;}
  const cyclePattern=_newProgDays.map(d=>d.type);
  if(_editingProgId){
    const prog=PROGRAMS.find(p=>p.id===_editingProgId);
    if(prog){Object.assign(prog,{name,emoji,color:_newProgColor,cyclePattern,plan:prog.plan||{}});}
  } else {
    PROGRAMS.push({id:'prog_'+Date.now(),name,emoji,color:_newProgColor,cyclePattern,plan:{}});
  }
  savePrograms();
  closeNewProgSheet();
  renderProgramsManager();
}

// ── HOLIDAY MODE ──────────────────────────────────────────────────────────

async function saveVacation(){
  localStorage.setItem('tr-vacation-v1',JSON.stringify(VACATION));
  if(fbReady&&db){const tid=trainerId();db.doc(`trainers/${tid}/meta`).set({vacation:VACATION},{merge:true}).catch(()=>{});}
}

function openVacationSheet(){
  const inner=document.getElementById('vacation-inner');if(!inner)return;
  const today=todayStr();
  inner.innerHTML=`
    <div style="font-size:18px;font-weight:700;margin-bottom:16px">Holiday Mode</div>
    ${VACATION?`
      <div style="background:rgba(251,191,36,.1);border:1px solid rgba(251,191,36,.3);border-radius:12px;padding:14px;margin-bottom:14px">
        <div style="font-size:10px;font-weight:700;color:var(--amber);font-family:var(--fb);letter-spacing:.08em;margin-bottom:4px">🏖️ ACTIVE</div>
        <div style="font-size:16px;font-weight:700">${VACATION.name}</div>
        <div style="font-size:12px;color:var(--text3);margin-top:3px;font-family:var(--fm)">${_fmtRange(VACATION.start,VACATION.end)}</div>
      </div>
      <button onclick="clearVacation()" style="width:100%;padding:13px;background:none;border:1px solid var(--red);border-radius:12px;color:var(--red);font-family:var(--fb);font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;margin-bottom:14px">End holiday</button>
      <div style="height:1px;background:var(--border);margin-bottom:14px"></div>`:''}
    <div style="font-size:10px;font-weight:700;color:var(--text3);letter-spacing:.08em;text-transform:uppercase;font-family:var(--fb);margin-bottom:8px">${VACATION?'Update holiday':'Set holiday period'}</div>
    <input id="vac-name" type="text" placeholder="e.g. Summer Holiday, Christmas…" value="${VACATION?.name||''}" style="width:100%;padding:11px 12px;background:var(--bg3);border:1px solid var(--border);border-radius:10px;color:var(--text);font-family:inherit;font-size:14px;outline:none;box-sizing:border-box;margin-bottom:10px">
    <div style="display:flex;gap:8px;margin-bottom:14px">
      <div style="flex:1">
        <div style="font-size:10px;font-weight:700;color:var(--text3);font-family:var(--fb);letter-spacing:.06em;margin-bottom:4px">FROM</div>
        <input id="vac-start" type="date" value="${VACATION?.start||today}" style="width:100%;padding:10px;background:var(--bg3);border:1px solid var(--border);border-radius:10px;color:var(--text);font-family:inherit;font-size:13px;outline:none;box-sizing:border-box">
      </div>
      <div style="flex:1">
        <div style="font-size:10px;font-weight:700;color:var(--text3);font-family:var(--fb);letter-spacing:.06em;margin-bottom:4px">TO</div>
        <input id="vac-end" type="date" value="${VACATION?.end||''}" style="width:100%;padding:10px;background:var(--bg3);border:1px solid var(--border);border-radius:10px;color:var(--text);font-family:inherit;font-size:13px;outline:none;box-sizing:border-box">
      </div>
    </div>
    <button onclick="saveVacationFromSheet()" style="width:100%;padding:14px;background:var(--text);color:var(--bg);font-family:var(--fb);font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;border:none;border-radius:12px;cursor:pointer">Set Holiday Mode</button>`;
  document.getElementById('vacation-sheet').classList.add('open');
}

function closeVacationSheet(){document.getElementById('vacation-sheet').classList.remove('open');}

function saveVacationFromSheet(){
  const name=document.getElementById('vac-name')?.value.trim();
  const start=document.getElementById('vac-start')?.value;
  const end=document.getElementById('vac-end')?.value;
  if(!name){alert('Please enter a name for your holiday.');return;}
  if(!start||!end){alert('Please set start and end dates.');return;}
  if(end<start){alert('End date must be after start date.');return;}
  VACATION={name,start,end};
  saveVacation();closeVacationSheet();refreshActiveView();renderProfile();
}

function clearVacation(){
  if(!confirm('End holiday mode? Normal Training will resume.'))return;
  VACATION=null;saveVacation();closeVacationSheet();refreshActiveView();renderProfile();
}

// ── PWA INSTALL PROMPT ────────────────────────────────────────────────────
let _deferredInstallPrompt = null;

(function initInstallPrompt(){
  // Never show if already installed or dismissed
  const dismissed = localStorage.getItem('tr-install-dismissed-v1');
  const standalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone;
  if(standalone || dismissed) return;

  const isIOS = /iphone|ipad|ipod/i.test(navigator.userAgent.toLowerCase()) && !window.MSStream;

  if(isIOS){
    // iOS: show manual instructions after 3s
    setTimeout(()=>{
      const sub = document.getElementById('install-banner-sub');
      const btn = document.getElementById('install-banner-btn');
      if(sub) sub.textContent = 'Tap Share → Add to Home Screen';
      if(btn){ btn.textContent = 'How?'; btn.onclick = ()=>{
        alert('To install:\n1. Tap the Share button (□↑) in Safari\n2. Scroll down and tap "Add to Home Screen"\n3. Tap "Add"');
      };}
      document.getElementById('install-banner')?.classList.add('show');
    }, 3000);
  } else {
    // Android/Chrome: capture the native prompt
    window.addEventListener('beforeinstallprompt', e=>{
      e.preventDefault();
      _deferredInstallPrompt = e;
      setTimeout(()=>document.getElementById('install-banner')?.classList.add('show'), 3000);
    });
    window.addEventListener('appinstalled', ()=>{
      dismissInstallBanner();
      _deferredInstallPrompt = null;
    });
  }
})();

function triggerInstall(){
  if(_deferredInstallPrompt){
    _deferredInstallPrompt.prompt();
    _deferredInstallPrompt.userChoice.then(()=>{dismissInstallBanner();_deferredInstallPrompt=null;});
  }
}

function dismissInstallBanner(){
  document.getElementById('install-banner')?.classList.remove('show');
  localStorage.setItem('tr-install-dismissed-v1','1');
}

// ── OFFLINE / ONLINE ───────────────────────────────────────────────────────
window.addEventListener('offline',()=>setSyncUI('err','Offline'));
window.addEventListener('online',()=>{
  if(fbReady&&db){setSyncUI('syncing','Reconnecting…');startListeners();}
  else{setSyncUI('syncing','Connecting…');initFirebase();}
});

// ── SEED A/B PROGRAM ──────────────────────────────────────────────────────
(function seedABProgram(){
  if(PROGRAMS.some(p=>p.id==='prog_ab_v1'||p.name==='A/B Training'||p.name===AB_PROG_NAME))return;
  const abId='prog_ab_v1';
  // 14-day cycle: Week 1 = A REST B REST A REST REST, Week 2 = B REST A REST B REST REST
  const cyclePattern=['WORKOUT A','REST','WORKOUT B','REST','WORKOUT A','REST','REST','WORKOUT B','REST','WORKOUT A','REST','WORKOUT B','REST','REST'];
  const wktA=['Back Squat (BB)','Bench Press (BB)','Pull-Ups (Bodyweight)','Romanian Deadlift (BB)','Overhead Press (BB)','Bent Over Row (BB)','Bicep Curl (BB)','Lateral Raises (DB)','Single-Arm Overhead Triceps (DB)'];
  const wktB=['Bulgarian Split Squat (DB)','Incline Press (DB)','Chin-Ups (Bodyweight)','Leg Curl (Bench Attachment)','Dips (Bodyweight)','Single-Arm Row (DB)','Rear-Delt Raises (DB)','Standing Calf Raises (DB)','Hanging Knee Raise (Bodyweight)','Ab Rollout (Ab Wheel)'];
  wktA.push('Hanging Knee Raise (Bodyweight)');
  const plan={
    'WORKOUT A':[{g:'Strength Day',ex:wktA}],
    'WORKOUT B':[{g:'Shape Day',ex:wktB}]
  };
  const planMeta={
    'WORKOUT A':{
      'Back Squat (BB)':{sets:3,minReps:8,maxReps:12},
      'Bench Press (BB)':{sets:3,minReps:8,maxReps:12},
      'Pull-Ups (Bodyweight)':{sets:3,minReps:6,maxReps:12},
      'Romanian Deadlift (BB)':{sets:3,minReps:8,maxReps:12},
      'Overhead Press (BB)':{sets:3,minReps:8,maxReps:12},
      'Bent Over Row (BB)':{sets:3,minReps:8,maxReps:12},
      'Bicep Curl (BB)':{sets:2,minReps:8,maxReps:12},
      'Lateral Raises (DB)':{sets:3,minReps:12,maxReps:20},
      'Single-Arm Overhead Triceps (DB)':{sets:2,minReps:10,maxReps:15},
      'Hanging Knee Raise (Bodyweight)':{sets:3,minReps:10,maxReps:15}
    },
    'WORKOUT B':{
      'Bulgarian Split Squat (DB)':{sets:3,minReps:10,maxReps:12},
      'Incline Press (DB)':{sets:3,minReps:10,maxReps:15},
      'Chin-Ups (Bodyweight)':{sets:3,minReps:6,maxReps:12},
      'Leg Curl (Bench Attachment)':{sets:3,minReps:10,maxReps:15},
      'Dips (Bodyweight)':{sets:3,minReps:8,maxReps:12},
      'Single-Arm Row (DB)':{sets:3,minReps:10,maxReps:15},
      'Rear-Delt Raises (DB)':{sets:3,minReps:12,maxReps:20},
      'Standing Calf Raises (DB)':{sets:3,minReps:12,maxReps:20},
      'Hanging Knee Raise (Bodyweight)':{sets:3,minReps:10,maxReps:15},
      'Ab Rollout (Ab Wheel)':{sets:2,minReps:8,maxReps:15}
    }
  };
  // Add all exercises to the library
  [...wktA,...wktB].forEach(nm=>{
    if(!EX_LIBRARY.find(e=>e.name===nm))EX_LIBRARY.push({name:nm,type:'reps',group:AB_PROG_NAME});
  });
  localStorage.setItem('tr-exlib-v1',JSON.stringify(EX_LIBRARY));
  PROGRAMS.push({id:abId,name:AB_PROG_NAME,emoji:'🏋️',color:'#3b82f6',cyclePattern,plan,planMeta,nextInOrder:true,endDate:'2026-12-20',phases:[{type:'deload',label:'Deload',start:'2026-11-23',end:'2026-11-29'},{type:'test',label:'Test week',start:'2026-12-14',end:'2026-12-20'}],blockMetaV1:true});
  try{ const _p=PROGRAMS.find(p=>p.id===abId); if(_p&&typeof _applyABSpec==='function') _applyABSpec(_p); }catch(e){}
  localStorage.setItem('tr-programs-v1',JSON.stringify(PROGRAMS));
})();


const AB_SPEC={
  'WORKOUT A':[
    ['Back Squat (BB)',3,6,8],['Romanian Deadlift (BB)',3,8,10],['Bench Press (BB)',3,6,8],['Pull-Ups (Bodyweight)',3,6,12],
    ['Overhead Press (BB)',3,8,12],['Bent Over Row (BB)',3,8,12],['Bicep Curl (BB)',3,8,12],['Lateral Raises (DB)',3,12,20],
    ['Single-Arm Overhead Triceps (DB)',3,12,15],['Hanging Knee Raise (Bodyweight)',3,10,15]],
  'WORKOUT B':[
    ['Bulgarian Split Squat (DB)',3,10,12],['Chin-Ups (Bodyweight)',3,6,12],['Incline Press (DB)',3,10,15],['Leg Curl (Bench Attachment)',3,10,15],
    ['Dips (Bodyweight)',3,8,12],['Single-Arm Row (DB)',3,10,15],['Rear-Delt Raises (DB)',3,12,20],['Standing Calf Raises (DB)',3,12,15],
    ['Hanging Knee Raise (Bodyweight)',3,10,15],['Ab Rollout (Ab Wheel)',2,8,15]]
};
// Apply the program sheet: order, sets and rep ranges. Extra exercises you added yourself are kept at the end.
function _applyABSpec(prog){
  if(!prog.plan) prog.plan={}; if(!prog.planMeta) prog.planMeta={};
  Object.entries(AB_SPEC).forEach(([dt,list])=>{
    const groups=prog.plan[dt]&&prog.plan[dt].length?prog.plan[dt]:[{g:DAY_FULL_NAMES[dt]||dt,ex:[]}];
    const existing=[...new Set(groups.flatMap(g=>g.ex||[]))];
    const specNames=list.map(x=>x[0]);
    const extras=existing.filter(n=>!specNames.includes(n));
    prog.plan[dt]=[{g:groups[0].g||DAY_FULL_NAMES[dt]||dt,ex:[...specNames,...extras]}];
    if(!prog.planMeta[dt]) prog.planMeta[dt]={};
    list.forEach(([n,sets,mn,mx])=>{ prog.planMeta[dt][n]={...(prog.planMeta[dt][n]||{}),sets,minReps:mn,maxReps:mx}; });
  });
  prog.repsV1=true;
}

// ── ONE-TIME NAME MIGRATION (idempotent; safe to run on every load/snapshot) ──
const EX_RENAME = {"Back squat (BB)": "Back Squat (BB)","Romanian deadlift (BB)": "Romanian Deadlift (BB)","Bench press (BB)": "Bench Press (BB)","Pull-ups": "Pull-Ups (Bodyweight)","Overhead press (BB)": "Overhead Press (BB)","Bent-over row (BB)": "Bent Over Row (BB)","Barbell curl": "Bicep Curl (BB)","Lateral raises (DB)": "Lateral Raises (DB)","Single-arm overhead triceps (DB)": "Single-Arm Overhead Triceps (DB)","Bulgarian split squat (DB)": "Bulgarian Split Squat (DB)","Chin-ups": "Chin-Ups (Bodyweight)","Incline press (DB)": "Incline Press (DB)","Leg curl (bench attachment)": "Leg Curl (Bench Attachment)","Weighted dips": "Dips (Bodyweight)","Single-arm row (DB)": "Single-Arm Row (DB)","Rear-delt raises (DB)": "Rear-Delt Raises (DB)","Standing calf raises (DB)": "Standing Calf Raises (DB)","Hanging knee raise": "Hanging Knee Raise (Bodyweight)","Ab wheel": "Ab Rollout (Ab Wheel)","Weighted Pull-Ups (Bodyweight/Plate)": "Pull-Ups (Bodyweight)","Weighted Dips (Bodyweight/Plate)": "Dips (Bodyweight)","Dip (Bodyweight)": "Dips (Bodyweight)","Goblet Squat": "Goblet Squat (DB)","Incline Hammer Strength Press": "Incline Press (Machine)","Machine Chest Press": "Chest Press (Machine)","Cable Fly - High to Low (Cable)": "High-to-Low Fly (Cable)","Bodyweight Squat (Bodyweight)": "Air Squat (Bodyweight)"};
function _renEx(n){ return EX_RENAME[n] || n; }
function _renList(arr){
  if(!Array.isArray(arr)) return null;
  const out=[]; let ch=false;
  arr.forEach(n=>{ const m=_renEx(n); if(m!==n) ch=true; if(out.includes(m)){ ch=true; return; } out.push(m); });
  return ch ? out : null;
}
function _renExercises(exs){
  if(!Array.isArray(exs)) return null;
  const out=[], renamed=[]; let ch=false;
  exs.forEach(e=>{
    const nm=_renEx(e.name), r=nm!==e.name;
    if(r) ch=true;
    const j=out.findIndex(x=>x.name===nm);
    if(j>=0 && (r||renamed[j])){ out[j]={...out[j],sets:[...(out[j].sets||[]),...(e.sets||[])]}; renamed[j]=true; return; }
    out.push(r?{...e,name:nm}:e); renamed.push(r);
  });
  return ch ? out : null;
}
function migrateSessionNames(){
  const changed=[];
  US.forEach((s,i)=>{ const r=_renExercises(s.exercises); if(r){ US[i]={...s,exercises:r}; changed.push(US[i]); } });
  if(!changed.length) return;
  localStorage.setItem('tr-sess-v4',JSON.stringify(US));
  if(typeof _clearPrCache==='function') _clearPrCache();
  if(fbReady&&db){ const tid=trainerId(); changed.forEach(s=>db.doc(`trainers/${tid}/sessions/${s.id}`).set(s).catch(()=>{})); }
}
function _renPlanGroups(plan){
  let ch=false;
  Object.keys(plan||{}).forEach(dt=>{ (plan[dt]||[]).forEach(g=>{ const r=_renList(g.ex); if(r){ g.ex=r; ch=true; } }); });
  return ch;
}
function migrateMetaNames(){
  // Normal plan + custom extras
  let metaCh=_renPlanGroups(PLAN);
  Object.keys(CUSTOM_EX||{}).forEach(dt=>{ const r=_renList(CUSTOM_EX[dt]); if(r){ CUSTOM_EX[dt]=r; metaCh=true; } });
  if(metaCh) saveMeta();
  // Exercise library
  let libCh=false; const lib=[];
  (EX_LIBRARY||[]).forEach(e=>{ const nm=_renEx(e.name); if(nm!==e.name) libCh=true; if(lib.find(x=>x.name===nm)){ libCh=true; return; } lib.push(nm!==e.name?{...e,name:nm}:e); });
  if(libCh){ EX_LIBRARY=lib; saveLibrary(); }
  // Programs
  let progCh=false;
  (PROGRAMS||[]).forEach(prog=>{
    if(prog.plan && _renPlanGroups(prog.plan)) progCh=true;
    Object.keys(prog.planMeta||{}).forEach(dt=>{
      const pm=prog.planMeta[dt]; if(!pm) return;
      Object.keys(pm).forEach(k=>{ const nk=_renEx(k); if(nk!==k){ if(!pm[nk]) pm[nk]=pm[k]; delete pm[k]; progCh=true; } });
    });
    // Rep ranges, sets and order from the program sheet (runs once)
    if((prog.id==='prog_ab_v1'||prog.name===AB_PROG_NAME)&&!prog.repsV1){ _applyABSpec(prog); progCh=true; }
    // Block dates for the Full Body home block (runs once)
    if((prog.id==='prog_ab_v1'||prog.name===AB_PROG_NAME||prog.name==='A/B Training')&&!prog.blockMetaV1){
      if(!prog.endDate) prog.endDate='2026-12-20';
      if(!prog.phases) prog.phases=[{type:'deload',label:'Deload',start:'2026-11-23',end:'2026-11-29'},{type:'test',label:'Test week',start:'2026-12-14',end:'2026-12-20'}];
      prog.blockMetaV1=true; progCh=true;
    }
    // Old A/B program → new name, day labels, missed-day rule, knee raise on Strength Day (runs once)
    if(prog.name==='A/B Training'){
      prog.name=AB_PROG_NAME; prog.nextInOrder=true; progCh=true;
      Object.keys(prog.plan||{}).forEach(dt=>(prog.plan[dt]||[]).forEach(g=>{ if(g.g==='Workout A')g.g='Strength Day'; if(g.g==='Workout B')g.g='Shape Day'; }));
      const hkr='Hanging Knee Raise (Bodyweight)';
      const a=prog.plan?.['WORKOUT A'];
      if(a && a.length && !a.some(g=>(g.ex||[]).includes(hkr))) a[a.length-1].ex.push(hkr);
      if(!prog.planMeta) prog.planMeta={};
      if(!prog.planMeta['WORKOUT A']) prog.planMeta['WORKOUT A']={};
      if(!prog.planMeta['WORKOUT A'][hkr]) prog.planMeta['WORKOUT A'][hkr]={sets:3,minReps:10,maxReps:15};
    }
  });
  if(progCh) savePrograms();
  // PR picker selection
  if(PR_PREFS && Array.isArray(PR_PREFS.selected)){ const r=_renList(PR_PREFS.selected); if(r){ PR_PREFS.selected=r; savePrPrefs(); } }
}
function migrateActiveWorkoutNames(){
  try{
    const raw=localStorage.getItem('tr-active-wk-v1'); if(!raw) return;
    const w=JSON.parse(raw); const r=_renExercises(w.exercises);
    if(r){ w.exercises=r; localStorage.setItem('tr-active-wk-v1',JSON.stringify(w)); }
  }catch(e){}
}

// ── INIT ───────────────────────────────────────────────────────────────────
try{ migrateSessionNames(); migrateMetaNames(); migrateActiveWorkoutNames(); }catch(e){ console.error('name migration',e); }
renderToday();
restoreWorkout();
initFirebase();
</script>

<script>
if('serviceWorker' in navigator){
  window.addEventListener('load',()=>navigator.serviceWorker.register('./sw.js').catch(()=>{}));
}
</script>
</body>
</html>
