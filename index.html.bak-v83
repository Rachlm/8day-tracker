function renderLibrary() {
  const el=document.getElementById('lib-inner');
  if(!EX_LIBRARY.length){
    el.innerHTML=`<div style="text-align:center;padding:48px 24px;color:var(--text3)">
      <div style="font-size:40px;margin-bottom:12px">📚</div>
      <div style="font-size:16px;font-weight:600;color:var(--text2);margin-bottom:8px">Library is empty</div>
      <div style="font-size:13px;line-height:1.5">Tap <strong style="color:var(--green)">+ Add</strong> to create custom exercises.<br>Built-in time exercises: Plank, Dead Hang, Wall Sit.</div>
    </div>`;
    return;
  }
  // group by .group
  const grps={};
  EX_LIBRARY.forEach(e=>{const g=e.group||'Custom';if(!grps[g])grps[g]=[];grps[g].push(e);});
  el.innerHTML=Object.entries(grps).map(([g,exs])=>`
    <div style="margin-bottom:20px">
      <div style="font-size:11px;font-weight:700;color:var(--text3);text-transform:uppercase;letter-spacing:.08em;margin-bottom:8px">${g}</div>
      ${exs.map(e=>`<div class="lex-row">
        <div>
          <div style="font-size:14px;font-weight:600">${e.name}</div>
          <div style="margin-top:4px"><span style="font-size:10px;font-weight:700;padding:2px 7px;border-radius:20px;${e.type==='time'?'background:var(--purple)22;color:var(--purple)':'background:var(--blue)22;color:var(--blue)'}">${e.type==='time'?'⏱ TIME':'🔢 REPS'}</span></div>
        </div>
        <div style="display:flex;gap:6px;align-items:center">
          <button onclick="openEditLibEx('${e.name.replace(/'/g,"\\'")}')" style="width:32px;height:32px;border-radius:50%;border:none;background:var(--bg3);color:var(--text3);cursor:pointer;font-size:14px;display:flex;align-items:center;justify-content:center;flex-shrink:0">✏</button>
          <button onclick="deleteLibEx('${e.name.replace(/'/g,"\\'")}')" style="width:32px;height:32px;border-radius:50%;border:none;background:var(--bg3);color:var(--text3);cursor:pointer;font-size:16px;display:flex;align-items:center;justify-content:center;flex-shrink:0">×</button>
        </div>
      </div>`).join('')}
    </div>`).join('');
}

function deleteLibEx(name) {
  if(!confirm(`Remove "${name}" from library?`))return;
  EX_LIBRARY=EX_LIBRARY.filter(e=>e.name!==name);
  saveLibrary();renderLibrary();
}

function openAddLibEx() {
  newExType='reps';
  document.getElementById('newex-name').value='';
  document.getElementById('newex-group').value='';
  document.getElementById('type-reps-btn').classList.add('active');
  document.getElementById('type-time-btn').classList.remove('active');
  document.getElementById('addex-sheet').classList.add('open');
  setTimeout(()=>document.getElementById('newex-name').focus(),150);
}
function closeAddLibEx(){document.getElementById('addex-sheet').classList.remove('open');}

function selectExType(type) {
  newExType=type;
  document.getElementById('type-reps-btn').classList.toggle('active',type==='reps');
  document.getElementById('type-time-btn').classList.toggle('active',type==='time');
}

function confirmAddLibEx() {
  const name=document.getElementById('newex-name').value.trim();
  if(!name){document.getElementById('newex-name').focus();return;}
  const group=document.getElementById('newex-group').value.trim()||'Custom';
  if(EX_LIBRARY.some(e=>e.name===name)){alert('Exercise already exists in library.');return;}
  EX_LIBRARY.push({name,type:newExType,group});
  saveLibrary();closeAddLibEx();renderLibrary();
}

// ── LIBRARY: SYNC FROM ALL SOURCES ────────────────────────────────────────

function syncLibraryFromAllSources() {
  // Build name→group map from DEFAULT_PLAN and PLAN (muscle group context)
  const groupMap={};
  [DEFAULT_PLAN, PLAN].forEach(plan=>{
    Object.values(plan).forEach(groups=>{
      groups.forEach(g=>g.ex.forEach(name=>{if(!groupMap[name])groupMap[name]=g.g;}));
    });
  });
  // Collect all exercise names from every source
  const allNames=new Set();
  [DEFAULT_PLAN, PLAN].forEach(plan=>{
    Object.values(plan).forEach(gs=>gs.forEach(g=>g.ex.forEach(n=>allNames.add(n))));
  });
  Object.values(CUSTOM_EX).forEach(arr=>arr.forEach(n=>allNames.add(n)));
  [...H,...US].forEach(s=>s.exercises.forEach(e=>allNames.add(e.name)));
  // Add anything missing — never overwrite existing entries
  const existing=new Set(EX_LIBRARY.map(e=>e.name));
  let added=false;
  allNames.forEach(name=>{
    if(existing.has(name))return;
    EX_LIBRARY.push({name,type:isTimeBased(name)?'time':'reps',group:groupMap[name]||'Imported'});
    added=true;
  });
  if(added)saveLibrary();
}

// Silently add a single exercise to the library if not already present
function ensureInLibrary(name) {
  if(EX_LIBRARY.some(e=>e.name===name))return;
  const groupMap={};
  Object.values(PLAN).forEach(gs=>gs.forEach(g=>g.ex.forEach(n=>{if(!groupMap[n])groupMap[n]=g.g;})));
  EX_LIBRARY.push({name,type:isTimeBased(name)?'time':'reps',group:groupMap[name]||'Custom'});
  saveLibrary();
}

